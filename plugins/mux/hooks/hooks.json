{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "asr-recorder",
            "tool": "observe",
            "input": {
              "hook_event_name": "PreToolUse",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "turn_id": "${turn_id}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "asr-recorder",
            "tool": "observe",
            "input": {
              "hook_event_name": "PostToolUse",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "turn_id": "${turn_id}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "asr-recorder",
            "tool": "observe",
            "input": {
              "hook_event_name": "UserPromptSubmit",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "prompt": "${prompt}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "asr-recorder",
            "tool": "observe",
            "input": {
              "hook_event_name": "Stop",
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "last_assistant_message": "${last_assistant_message}",
              "turn_id": "${turn_id}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 1
          }
        ]
      }
    ]
  }
}
