{
  "hooks": {
    "SessionStart": [
      {
        "sequential": true,
        "hooks": [
          {
            "type": "command",
            "name": "asr-recorder",
            "command": "node \"${extensionPath}/dist/record.mjs\" gemini-cli 2>/dev/null || :",
            "timeout": 1000
          }
        ]
      }
    ],
