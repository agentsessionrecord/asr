--- /dev/null
+++ b/internal/asr/export_test.go
@@ -0,0 +1,50 @@
+package asr
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/charmbracelet/crush/internal/session"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExportKeepsTextAndFinalResultAtCompletion(t *testing.T) {
+	t.Parallel()
+	sess := session.Session{ID: "synthetic-session"}
+	messages := []message.Message{
+		{ID: "m1", SessionID: sess.ID, Role: message.Assistant, Parts: []message.ContentPart{
+			message.ReasoningContent{Thinking: "Visible", Signature: "DO-NOT-COPY"},
+			message.TextContent{Text: "Exact\r\n"},
+			message.ToolCall{ID: "c", Name: "view", Input: `{"n":9007199254740993}`},
+		}},
+		{ID: "m2", SessionID: sess.ID, Role: message.Tool, Parts: []message.ContentPart{message.ToolResult{ToolCallID: "c", Content: "old"}}},
+		{ID: "m3", SessionID: sess.ID, Role: message.User, Parts: []message.ContentPart{message.TextContent{Text: "Between"}}},
+		{ID: "m4", SessionID: sess.ID, Role: message.Tool, Parts: []message.ContentPart{message.ToolResult{ToolCallID: "c", Content: "new", IsError: true}}},
+	}
+	var output bytes.Buffer
+	require.NoError(t, Export(&output, sess, messages))
+	require.NotContains(t, output.String(), "DO-NOT-COPY")
+	var rows []map[string]any
+	for line := range strings.SplitSeq(strings.TrimSuffix(output.String(), "\n"), "\n") {
+		var row map[string]any
+		require.NoError(t, json.Unmarshal([]byte(line), &row))
+		rows = append(rows, row)
+	}
+	require.Len(t, rows, 6)
+	require.Equal(t, "failed", rows[5]["status"])
+	require.Equal(t, "Between", rows[4]["content"].([]any)[0].(map[string]any)["text"])
+	require.Equal(t, map[string]any{"n": "9007199254740993"}, rows[3]["input"])
+	require.NotContains(t, rows[4], "author")
+	var again bytes.Buffer
+	require.NoError(t, Export(&again, sess, messages))
+	require.Equal(t, output.String(), again.String())
+}
+
+func TestExportRejectsMissingIdentityAndForeignMessages(t *testing.T) {
+	t.Parallel()
+	require.Error(t, Export(&bytes.Buffer{}, session.Session{}, nil))
+	require.Error(t, Export(&bytes.Buffer{}, session.Session{ID: "s"}, []message.Message{{SessionID: "other"}}))
+}
