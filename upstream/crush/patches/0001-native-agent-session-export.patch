diff --git a/internal/cmd/session_export.go b/internal/cmd/session_export.go
new file mode 100644
index 0000000..107cf78
--- /dev/null
+++ b/internal/cmd/session_export.go
@@ -0,0 +1,49 @@
+package cmd
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func sessionShowExportFormat(format, output string, jsonOutput bool) (string, error) {
+	if format != "" && format != "agent-session" {
+		return "", fmt.Errorf("unsupported export format: %s", format)
+	}
+	if format != "" && jsonOutput {
+		return "", fmt.Errorf("--json and --format cannot be combined")
+	}
+	if jsonOutput {
+		return "json", nil
+	}
+	if format != "" || output == "" {
+		return format, nil
+	}
+	switch strings.ToLower(filepath.Ext(output)) {
+	case ".jsonl":
+		return "agent-session", nil
+	case ".json":
+		return "json", nil
+	default:
+		return "", fmt.Errorf("use a .jsonl or .json output path, or --format agent-session")
+	}
+}
+
+func writeSessionShow(stdout io.Writer, output string, write func(io.Writer) error) error {
+	if output == "" {
+		return write(stdout)
+	}
+	file, err := os.OpenFile(output, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	writeErr := write(file)
+	closeErr := file.Close()
+	if writeErr != nil {
+		_ = os.Remove(output)
+		return writeErr
+	}
+	return closeErr
+}
diff --git a/internal/cmd/session_export_test.go b/internal/cmd/session_export_test.go
new file mode 100644
index 0000000..a5ba885
--- /dev/null
+++ b/internal/cmd/session_export_test.go
@@ -0,0 +1,54 @@
+package cmd
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSessionShowExportFormat(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		format, output string
+		json           bool
+		want           string
+		invalid        bool
+	}{
+		{want: ""}, {json: true, want: "json"}, {format: "agent-session", want: "agent-session"},
+		{output: "session.asr.jsonl", want: "agent-session"}, {output: "session.json", want: "json"},
+		{output: "session.txt", invalid: true}, {format: "other", invalid: true},
+		{format: "agent-session", json: true, invalid: true},
+	} {
+		got, err := sessionShowExportFormat(tc.format, tc.output, tc.json)
+		if tc.invalid {
+			require.Error(t, err)
+		} else {
+			require.NoError(t, err)
+			require.Equal(t, tc.want, got)
+		}
+	}
+}
+
+func TestSessionShowWritesPrivateFileWithoutClobbering(t *testing.T) {
+	t.Parallel()
+	var stdout bytes.Buffer
+	output := filepath.Join(t.TempDir(), "session.asr.jsonl")
+	write := func(w io.Writer) error { _, err := io.WriteString(w, "synthetic\n"); return err }
+	require.NoError(t, writeSessionShow(&stdout, output, write))
+	info, err := os.Stat(output)
+	require.NoError(t, err)
+	require.Equal(t, os.FileMode(0o600), info.Mode().Perm())
+	require.Empty(t, stdout.String())
+	require.Error(t, writeSessionShow(&stdout, output, write))
+	require.NoError(t, writeSessionShow(&stdout, "", write))
+	require.Equal(t, "synthetic\n", stdout.String())
+	failed := filepath.Join(t.TempDir(), "failed.jsonl")
+	require.Error(t, writeSessionShow(&stdout, failed, func(io.Writer) error { return errors.New("write failed") }))
+	_, err = os.Stat(failed)
+	require.True(t, os.IsNotExist(err))
+}
