diff --git a/internal/asr/export.go b/internal/asr/export.go
new file mode 100644
index 0000000..c876bb5
--- /dev/null
+++ b/internal/asr/export.go
@@ -0,0 +1,153 @@
+// Package asr exports native message snapshots as Agent Session Record.
+package asr
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/charmbracelet/crush/internal/session"
+)
+
+// Export preserves the store's message and content-part order without reading
+// current files, provider settings, or opaque provider metadata.
+func Export(w io.Writer, sess session.Session, messages []message.Message) error {
+	if sess.ID == "" {
+		return fmt.Errorf("native session ID is empty")
+	}
+	type record = map[string]any
+	rows := []record{{
+		"type": "session", "id": "header", "formatVersion": "0.1",
+		"agent": record{"name": "crush"}, "sessionId": sess.ID,
+		"producer": record{"name": "crush-asr-export", "version": "1", "method": "native", "source": "crush-sqlite"},
+		"missing":  []string{"approvals", "agent_settings", "tools", "usage", "model", "file_changes", "commits", "subagents", "copies", "media", "native_metadata", "message_author", "snapshot_order", "reasoning", "timestamps"},
+	}}
+	if sess.CreatedAt != 0 {
+		rows[0]["startedAt"] = time.Unix(sess.CreatedAt, 0).UTC().Format(time.RFC3339)
+	}
+	// Mutable session titles are omitted because their observation time is absent.
+	lastResult := map[string]int{}
+	used := map[string]bool{"header": true}
+	for mi, msg := range messages {
+		if msg.SessionID != sess.ID {
+			return fmt.Errorf("message belongs to another session")
+		}
+		for pi, part := range msg.Parts {
+			id := fmt.Sprintf("message-%d-part-%d", mi, pi)
+			if pi == 0 && msg.ID != "" && !used[msg.ID] && len(msg.ID) <= 256 && strings.IndexFunc(msg.ID, unicode.IsControl) < 0 {
+				id = msg.ID
+			}
+			for used[id] {
+				id = "derived-" + id
+			}
+			used[id] = true
+			r := record{"id": id}
+			switch p := part.(type) {
+			case message.TextContent, message.ReasoningContent:
+				if msg.Role != message.Assistant && msg.Role != message.User && msg.Role != message.System {
+					continue
+				}
+				var content record
+				switch p := p.(type) {
+				case message.TextContent:
+					content = record{"type": "text", "text": p.Text}
+				case message.ReasoningContent:
+					content = asrReasoning(p.Thinking, false)
+				}
+				r["type"], r["role"], r["content"] = "message", string(msg.Role), []record{content}
+				if msg.Role == message.Assistant {
+					r["author"] = "model"
+				}
+				if msg.IsSummaryMessage {
+					r["origin"], r["author"] = "compaction", "harness"
+				}
+			case message.ToolCall:
+				if p.ID == "" {
+					return fmt.Errorf("native tool call ID is empty")
+				}
+				r["type"], r["callId"], r["name"] = "tool_call", p.ID, p.Name
+				if json.Valid([]byte(p.Input)) {
+					decoder := json.NewDecoder(strings.NewReader(p.Input))
+					decoder.UseNumber()
+					var input any
+					if err := decoder.Decode(&input); err != nil {
+						return err
+					}
+					r["input"] = safeNumbers(input)
+				} else {
+					r["inputText"] = p.Input
+				}
+				if msg.Role == message.Assistant {
+					r["requestedBy"] = "model"
+				}
+			case message.ToolResult:
+				r["type"], r["status"] = "tool_result", "completed"
+				if p.IsError {
+					r["status"] = "failed"
+				}
+				if p.ToolCallID != "" {
+					if previous, ok := lastResult[p.ToolCallID]; ok {
+						rows[previous] = nil
+					}
+					lastResult[p.ToolCallID] = len(rows)
+					r["callId"] = p.ToolCallID
+				}
+				r["content"] = []record{{"type": "text", "text": p.Content}}
+				if p.Data != "" {
+					r["truncated"] = true
+				}
+			case message.Finish:
+				continue
+			default:
+				r["type"], r["reason"], r["detail"] = "gap", "not_recorded", "This native content part is not mapped."
+			}
+			rows = append(rows, r)
+		}
+	}
+	encoder := json.NewEncoder(w)
+	encoder.SetEscapeHTML(false)
+	for _, row := range rows {
+		if row != nil {
+			if err := encoder.Encode(row); err != nil {
+				return fmt.Errorf("write ASR: %w", err)
+			}
+		}
+	}
+	return nil
+}
+
+// ASR opaque values preserve large numbers as strings instead of rounding them.
+func safeNumbers(value any) any {
+	switch value := value.(type) {
+	case json.Number:
+		number, err := strconv.ParseFloat(string(value), 64)
+		if err != nil || (math.Trunc(number) == number && math.Abs(number) > 9007199254740991) {
+			return string(value)
+		}
+	case map[string]any:
+		for key, item := range value {
+			value[key] = safeNumbers(item)
+		}
+	case []any:
+		for index, item := range value {
+			value[index] = safeNumbers(item)
+		}
+	}
+	return value
+}
+
+func asrReasoning(text string, summary bool) map[string]any {
+	if text == "" {
+		return map[string]any{"type": "reasoning", "visibility": "omitted"}
+	}
+	if summary {
+		return map[string]any{"type": "reasoning", "visibility": "summary", "summary": []string{text}}
+	}
+	return map[string]any{"type": "reasoning", "text": text}
+}
