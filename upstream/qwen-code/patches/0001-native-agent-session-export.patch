+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, it, expect, vi } from 'vitest';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { exportSession, exportCommand } from './export.js';
+import { exportFiles, parseNative } from './agent-session.js';
+
+const discovery = vi.hoisted(() => ({ directory: '' }));
+vi.mock('./common.js', () => ({
+  initSessionService: () => ({
+    getSessionTranscriptPath: () => `${discovery.directory}/unused.jsonl`,
+  }),
+}));
+
+const records = (text: string) =>
+  text
+    .trimEnd()
+    .split('\n')
+    .map((line) => JSON.parse(line));
+const at = '2026-10-30T12:00:00Z';
+
+const extra = (uuid: string) =>
+  JSON.stringify({
+    uuid,
+    sessionId: 'synthetic-session',
+    parentUuid: null,
+    timestamp: at,
+    type: 'user',
+    provenance: 'real_user',
+    cwd: '/work/example',
+    version: 'synthetic',
+    message: { role: 'user', parts: [{ text: 'hello\r\n  world ' }] },
+  });
+const fixture = () => extra('prompt') + '\n';
+
+describe('Agent Session Record export', () => {
+  it('discovers current project storage and filters unrelated sessions before decoding', async () => {
+    const dir = fs.mkdtempSync(
+      path.join(os.tmpdir(), 'agent-session-discovery-'),
+    );
+    discovery.directory = dir;
+    const store = dir;
+    fs.mkdirSync(store, { recursive: true });
+    fs.writeFileSync(path.join(store, 'session-synthetic.jsonl'), fixture());
+    fs.writeFileSync(
+      path.join(store, 'managed.jsonl'),
+      JSON.stringify({
+        uuid: 'managed',
+        sessionId: 'unselected',
+        subtype: 'managed_session_header_v1',
+      }) + '\n',
+    );
+    const write = vi.spyOn(process.stdout, 'write').mockReturnValue(true);
+    try {
+      await exportCommand.handler({
+        format: 'agent-session',
+        session: ['synthetic-session'],
+        _: [],
+        $0: 'test',
+      });
+      expect(write).toHaveBeenCalledWith(exportSession(fixture()));
+    } finally {
+      write.mockRestore();
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it('writes deterministic native streams with exact text and no invented outcomes', () => {
+    const source = fixture();
+    const a = exportSession(source);
+    expect(exportSession(source)).toBe(a);
+    const output = records(a);
+    expect(output[0].producer.method).toBe('native');
+    expect(output[0].sessionId).toBe('synthetic-session');
+    expect(output[0]).not.toHaveProperty('endedAt');
+    expect(output.some((r) => r.type === 'approval')).toBe(false);
+    expect(output.some((r) => r.type === 'inference')).toBe(false);
+    expect(output.find((r) => r.id === 'prompt').content).toEqual([
+      { type: 'text', text: 'hello\r\n  world ' },
+    ]);
+    expect(new Set(output.map((r) => r.id)).size).toBe(output.length);
+  });
+
+  it('keeps large native values exact before JavaScript can round them', () => {
+    expect(parseNative('{"id":9007199254740993}')).toEqual({
+      id: '9007199254740993',
+    });
+  });
+
+  it('marks corrupt complete lines and incomplete tails without dropping later work', () => {
+    const source =
+      fixture() + 'broken\n' + extra('later') + '\n' + '{"unfinished":';
+    const output = records(exportSession(source));
+    expect(output.filter((r) => r.type === 'gap')).toHaveLength(2);
+    expect(output.some((r) => r.id === 'later')).toBe(true);
