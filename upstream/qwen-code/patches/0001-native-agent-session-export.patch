+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type { CommandModule } from 'yargs';
+import type { ChatRecord } from '@qwen-code/qwen-code-core';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import {
+  SessionExport,
+  exportFiles,
+  nativeLines,
+  object,
+  isString,
+  timestamp,
+  type ExportArgs,
+  type RecordValue,
+} from './agent-session.js';
+
+function isChatRecord(value: unknown): value is ChatRecord {
+  const r = object(value);
+  return (
+    isString(r['uuid']) &&
+    isString(r['sessionId']) &&
+    ['user', 'assistant', 'tool_result', 'system'].includes(String(r['type']))
+  );
+}
+
+export function exportSession(text: string): string {
+  const rows = nativeLines(text);
+  const first = object(rows.find((row) => isString(object(row)['sessionId'])));
+  if (!isString(first['sessionId']) || !first['sessionId'])
+    throw new Error('Missing native session identity');
+  if (
+    rows.some((row) =>
+      String(object(row)['subtype']).startsWith('managed_session_'),
+    )
+  )
+    throw new Error(
+      'Managed session journals are not supported by this exporter',
+    );
+  const out = new SessionExport(
+    'com.qwen.code',
+    new Set(
+      rows
+        .map((r) => object(r)['uuid'])
+        .filter((id): id is string => typeof id === 'string'),
+    ),
+  );
+  const last = new Map<string, number>();
+  const responseLast = new Map<string, number>();
+  const fragments = new Map<string, RecordValue>();
+  rows.forEach((raw, index) => {
+    const r = object(raw);
+    if (isString(r['uuid'])) {
+      const previous = fragments.get(r['uuid']);
+      if (previous && previous['parentUuid'] !== r['parentUuid']) {
+        rows[index] = null;
+        return;
+      }
+      const previousMessage = object(previous?.['message']);
+      const currentMessage = object(r['message']);
+      const merged = previous
+        ? {
+            ...previous,
+            timestamp: r['timestamp'],
+            ...(r['message']
+              ? {
+                  message: {
+                    ...currentMessage,
+                    parts: [
+                      ...(Array.isArray(previousMessage['parts'])
+                        ? previousMessage['parts']
+                        : []),
+                      ...(Array.isArray(currentMessage['parts'])
+                        ? currentMessage['parts']
+                        : []),
+                    ],
+                  },
+                }
+              : {}),
+            toolCallResult: previous['toolCallResult'] ?? r['toolCallResult'],
+          }
+        : r;
+      fragments.set(r['uuid'], merged);
+      rows[index] = merged;
+      last.set(r['uuid'], index);
+    }
+  });
+  rows.forEach((raw, index) => {
+    const r = object(raw);
+    if (last.get(String(r['uuid'])) !== index) return;
+    const parts = object(r['message'])['parts'];
+    for (const p of Array.isArray(parts) ? parts : []) {
+      const response = object(object(p)['functionResponse']);
+      if (isString(response['id'])) responseLast.set(response['id'], index);
+    }
+  });
+  let parent: RecordValue | undefined;
+  rows.forEach((raw, index) => {
+    const r = object(raw);
+    const key = String(r['uuid'] ?? `line-${index}`);
+    if (
+      raw === null ||
+      !isChatRecord(raw) ||
+      r['sessionId'] !== first['sessionId']
+    ) {
+      out.gap(`invalid-${index}`);
+      return;
+    }
+    if (last.get(key) !== index) return;
+    const record = raw;
+    const ts = timestamp(record.timestamp);
+    if (!ts) out.missing.add('timestamps');
+    const payload = object(record.systemPayload);
+    const base = { ts, turnId: record.goalContext?.turnId ?? record.promptId };
+    if (
+      record.subtype === 'parent_session' &&
+      isString(payload['parentSessionId'])
+    ) {
+      const component = Array.from(payload['parentSessionId'])
+        .map((char) =>
+          /[%:#]/.test(char) ||
+          char.charCodeAt(0) <= 32 ||
+          char.charCodeAt(0) === 127
+            ? encodeURIComponent(char)
+            : char,
+        )
+        .join('');
+      parent = { session: `qwen-code:${component}`, kind: 'subagent' };
+    } else if (record.subtype === 'session_approval_mode') {
+      out.add(
+        key,
+        { type: 'session_info', ...base, agentSettings: { approval: payload } },
+        key,
+      );
+    } else if (
+      record.subtype === 'custom_title' &&
+      isString(payload['customTitle'])
+    ) {
+      out.add(
+        key,
+        { type: 'session_info', ...base, title: payload['customTitle'] },
+        key,
+      );
+    } else if (record.subtype === 'chat_compression') {
+      const history = payload['compressedHistory'];
+      const count = payload['summaryPrefixLength'];
+      if (
+        Array.isArray(history) &&
+        Number.isSafeInteger(count) &&
+        Number(count) >= 0
+      ) {
+        history.slice(0, Number(count)).forEach((entry, i) =>
+          out.add(
+            `${key}-summary-${i}`,
+            {
+              type: 'message',
+              ...base,
+              role: 'user',
+              author: 'harness',
+              origin: 'compaction',
+              content: out.parts(object(entry)['parts']),
+            },
+            i === 0 ? key : undefined,
+          ),
+        );
+      } else out.missing.add('compaction_summary');
+    } else if (record.message) {
+      if (record.executionContext)
+        out.add(`${key}-settings`, {
+          type: 'session_info',
+          ...base,
+          agentSettings: { approval: record.executionContext.approvalMode },
+        });
+      const parts = record.message.parts ?? [];
+      let block: unknown[] = [];
+      let segment = 0;
+      const flush = (position: number) => {
+        if (!block.length) return;
+        const nativeId = segment++ === 0 ? key : undefined;
+        out.add(
+          `${key}-message-${position}`,
+          {
+            type: 'message',
+            ...base,
+            role: record.type === 'assistant' ? 'assistant' : 'user',
+            ...(record.provenance === 'real_user'
+              ? { author: 'human', origin: 'prompt' }
+              : record.clientInitiatedSkills
+                ? { author: 'harness', origin: 'instructions' }
+                : record.provenance === 'assistant_output' ||
+                    record.type === 'assistant'
+                  ? { author: 'model' }
+                  : record.provenance === 'system'
+                    ? { author: 'harness', origin: 'injected' }
+                    : {}),
+            content: out.parts(block),
+          },
+          nativeId,
+        );
+        block = [];
+      };
+      parts.forEach((part, position) => {
+        if (part.functionCall) {
+          flush(position);
+          out.call(
+            `${key}-call-${position}`,
+            {
+              ...object(part.functionCall),
+              requestedBy: record.clientInitiatedSkills
+                ? 'harness'
+                : record.type === 'assistant'
+                  ? 'model'
+                  : undefined,
+            },
+            ts,
+            segment++ === 0 ? key : undefined,
+            base.turnId,
+          );
+        } else if (part.functionResponse) {
+          flush(position);
+          const callId = part.functionResponse.id;
+          if (
+            callId &&
+            (responseLast.get(callId) !== index ||
+              parts.findLastIndex((p) => p.functionResponse?.id === callId) !==
+                position)
+          )
+            return;
+          const statuses: Record<string, string> = {
+            success: 'completed',
+            error: 'failed',
+            cancelled: 'cancelled',
+          };
+          out.add(
+            `${key}-result-${position}`,
+            {
+              type: 'tool_result',
+              ...base,
+              callId,
+              status:
+                record.toolCallResult?.callId === callId ||
+                parts.filter((p) => p.functionResponse).length === 1
+                  ? (statuses[record.toolCallResult?.status ?? ''] ?? 'unknown')
+                  : 'unknown',
+              content: out.parts(
+                callId
+                  ? parts.filter((p) => p.functionResponse?.id === callId)
+                  : [part],
+              ),
+            },
+            segment++ === 0 ? key : undefined,
+          );
+        } else block.push(part);
+      });
+      flush(parts.length);
+    }
+  });
+  return out.finish({
+    agent: {
+      name: 'qwen-code',
+      ...(isString(first['version']) ? { version: first['version'] } : {}),
+    },
+    sessionId: first['sessionId'],
+    ...(isString(first['cwd']) && path.isAbsolute(first['cwd'])
+      ? { cwd: first['cwd'] }
+      : {}),
+    parent,
+    producer: {
+      name: 'qwen-code-export',
+      version: '1',
+      method: 'native',
+      source: 'qwen-chat-recording',
+    },
+  });
+}
+
+export const exportCommand: CommandModule<unknown, ExportArgs> = {
+  command: 'export',
+  describe: 'Export saved sessions as Agent Session Record JSONL',
+  builder: (yargs) =>
+    yargs
+      .option('format', {
+        type: 'string',
+        choices: ['agent-session'],
+        demandOption: true,
+      })
+      .option('session', { type: 'string', array: true })
+      .option('input', {
+        type: 'string',
+        array: true,
+        describe:
+          'Read explicit native session files instead of current project storage',
+      })
+      .option('since', { type: 'string' })
+      .option('output', {
+        type: 'string',
+        describe:
+          'Write private files to a directory without replacing existing files',
+      }),
+  handler: async (args) => {
+    let files = args.input;
+    if (!files) {
+      const { initSessionService } = await import('./common.js');
+      const service = initSessionService();
+      const dir = path.dirname(service.getSessionTranscriptPath('unused'));
+      files = [dir, path.join(dir, 'archive')].flatMap((directory) =>
+        fs.existsSync(directory)
+          ? fs
+              .readdirSync(directory)
+              .filter((name) => name.endsWith('.jsonl'))
+              .map((name) => path.join(directory, name))
+          : [],
+      );
+    }
+    exportFiles(args, files, exportSession);
+  },
+};
