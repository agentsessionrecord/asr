+++ b/packages/cli/src/commands/sessions/agent-session.ts
@@ -0,0 +1,357 @@
+/**
+ * @license
+ * Copyright 2026 Qwen Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { createHash } from 'node:crypto';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+export type RecordValue = Record<string, unknown>;
+const isObject = (value: unknown): value is RecordValue =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+export const isString = (value: unknown): value is string =>
+  typeof value === 'string';
+export const list = (value: unknown): unknown[] =>
+  Array.isArray(value) ? value : [];
+export const object = (value: unknown): RecordValue =>
+  isObject(value) ? value : {};
+
+export function parseNative(text: string): unknown {
+  return JSON.parse(
+    text,
+    (_key, value: unknown, context?: { source: string }) => {
+      if (
+        typeof value === 'number' &&
+        Math.abs(value) > Number.MAX_SAFE_INTEGER
+      ) {
+        if (!context?.source)
+          throw new Error('Exact native integers require Node.js 22 or newer');
+        return context.source;
+      }
+      return value;
+    },
+  );
+}
+
+export function nativeLines(text: string): unknown[] {
+  const lines = text.split('\n');
+  const tail = lines.pop();
+  const records = lines.map((line) => {
+    try {
+      const value: unknown = parseNative(line);
+      if (!value || typeof value !== 'object' || Array.isArray(value))
+        return null;
+      return value;
+    } catch {
+      return null;
+    }
+  });
+  if (tail) records.push(null);
+  return records;
+}
+
+export function timestamp(value: unknown): string | undefined {
+  return typeof value === 'string' &&
+    /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?(?:Z|[+-]\d\d:\d\d)$/.test(
+      value,
+    ) &&
+    Number.isFinite(Date.parse(value))
+    ? value
+    : undefined;
+}
+
+const kindByName: Record<string, string> = {
+  read_file: 'read',
+  read_many_files: 'read',
+  list_directory: 'read',
+  write_file: 'edit',
+  replace: 'edit',
+  edit: 'edit',
+  run_shell_command: 'execute',
+  grep_search: 'search',
+  glob: 'search',
+  web_fetch: 'fetch',
+  google_web_search: 'search',
+};
+
+export class SessionExport {
+  readonly records: RecordValue[] = [];
+  readonly missing = new Set([
+    'approvals',
+    'agent_settings',
+    'tools',
+    'usage',
+    'model',
+    'inference_settings',
+    'file_changes',
+    'commits',
+    'copies',
+    'subagents',
+    'instructions',
+    'exit_codes',
+    'native_metadata',
+    'message_author',
+    'tool_output',
+    'reasoning',
+    'provider_state',
+  ]);
+  private readonly used = new Set<string>();
+  private readonly secrets = Object.entries(process.env)
+    .filter(
+      ([key, value]) =>
+        /key|token|password|secret/i.test(key) && value && value.length >= 8,
+    )
+    .map(([, value]) => value!);
+
+  constructor(
+    readonly vendor: string,
+    private readonly reserved = new Set<string>(),
+  ) {}
+
+  id(key: string, native?: string): string {
+    let id =
+      native &&
+      native.length <= 256 &&
+      !Array.from(native).some(
+        (char) => char.charCodeAt(0) <= 31 || char.charCodeAt(0) === 127,
+      )
+        ? native
+        : `asr-${createHash('sha256').update(key).digest('hex')}`;
+    while (this.used.has(id) || (id !== native && this.reserved.has(id)))
+      id = `asr-${createHash('sha256')
+        .update(id + key)
+        .digest('hex')}`;
+    this.used.add(id);
+    return id;
+  }
+
+  add(key: string, record: RecordValue, native?: string): RecordValue {
+    const raw: RecordValue = { ...record, id: this.id(key, native) };
+    let shortened = false;
+    const clean = (value: unknown, field = ''): unknown => {
+      const entry = object(value);
+      if (
+        field === 'functionResponse' &&
+        /^(request_secret|get_password|get_credential)$/i.test(
+          String(entry['name']),
+        )
+      ) {
+        shortened = true;
+        return { id: entry['id'], name: entry['name'] };
+      }
+      if (
+        (field === 'functionCall' || field === '') &&
+        /^(request_secret|get_password|get_credential)$/i.test(
+          String(entry['name']),
+        )
+      ) {
+        value = {
+          ...entry,
+          args: undefined,
+          input: undefined,
+          truncated: true,
+        };
+        shortened = true;
+      }
+      if (
+        /^(?:thoughtSignature|signature|encryptedContent|encrypted_content|authorization|token|session[_-]?(?:key|token)|auth[_-]?token|client[_-]?secret|private[_-]?key|secret[_-]?(?:answer|value)|api[_-]?key|access[_-]?token|refresh[_-]?token|password|secret|credentials)$/i.test(
+          field,
+        )
+      ) {
+        shortened = true;
+        return undefined;
+      }
+      if (typeof value === 'string') {
+        let text = value.replace(
+          /\b(?:sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|Bearer\s+[A-Za-z0-9._~+/-]{20,})\b/gi,
+          '[redacted]',
+        );
+        for (const secret of this.secrets)
+          text = text.split(secret).join('[redacted]');
+        if (text !== value) shortened = true;
+        return text;
+      }
+      if (Array.isArray(value))
+        return value.map((entry) => clean(entry) ?? null);
+      if (value && typeof value === 'object') {
+        return Object.fromEntries(
+          Object.entries(value).flatMap(([k, v]) => {
+            const cleaned = clean(v, k);
+            return cleaned === undefined ? [] : [[k, cleaned]];
+          }),
+        );
+      }
+      return value;
+    };
+    const result = object(clean(raw));
+    if (
+      raw['type'] === 'tool_result' &&
+      Array.isArray(raw['content']) &&
+      raw['content'].some((part) => {
+        const response = object(
+          object(object(part)['part'])['functionResponse'],
+        );
+        const output = object(response['response'])['output'];
+        return (
+          typeof output === 'string' && output.includes('<tool_output_masked>')
+        );
+      })
+    )
+      result['truncated'] = true;
+    if (shortened) {
+      result['truncated'] = true;
+      this.missing.add('secrets');
+    }
+    this.records.push(result);
+    return result;
+  }
+
+  gap(key: string, reason = 'unparseable'): void {
+    this.missing.add('history');
+    this.add(key, { type: 'gap', reason, count: 1 });
+  }
+
+  parts(value: unknown): RecordValue[] {
+    return (
+      Array.isArray(value)
+        ? value
+        : value === undefined || value === null
+          ? []
+          : [value]
+    ).map((part: unknown) => {
+      if (typeof part === 'string') return { type: 'text', text: part };
+      const p = object(part);
+      if (isString(p['text'])) {
+        return p['thought']
+          ? asrReasoning(p['text'], false)
+          : { type: 'text', text: p['text'] };
+      }
+      if (p['thought'] === true || p['thoughtSignature'])
+        return { type: 'reasoning', visibility: 'omitted' };
+      const media = object(p['inlineData']);
+      if (
+        isString(media['mimeType']) &&
+        /^(image|audio)\//.test(media['mimeType'])
+      ) {
+        return {
+          type: media['mimeType'].split('/')[0],
+          mimeType: media['mimeType'],
+          data: media['data'],
+        };
+      }
+      return { type: `${this.vendor}/part`, part: p };
+    });
+  }
+
+  call(
+    key: string,
+    call: RecordValue,
+    ts?: string,
+    native?: string,
+    turnId?: string,
+  ): void {
+    this.add(
+      key,
+      {
+        type: 'tool_call',
+        callId:
+          isString(call['id']) && call['id'] ? call['id'] : `derived-${key}`,
+        name: call['name'],
+        input: call['args'],
+        ts,
+        kind: isString(call['name']) ? kindByName[call['name']] : undefined,
+        requestedBy: call['requestedBy'],
+        turnId,
+      },
+      native,
+    );
+  }
+
+  finish(header: RecordValue): string {
+    const session = this.add('header', {
+      type: 'session',
+      formatVersion: '0.1',
+      ...header,
+      missing: [...this.missing].sort(),
+    });
+    if (session['sessionId'] !== header['sessionId'])
+      throw new Error('Session identity contains excluded data');
+    session['missing'] = [...this.missing].sort();
+    return (
+      [session, ...this.records.slice(0, -1)]
+        .map((r) => JSON.stringify(r))
+        .join('\n') + '\n'
+    );
+  }
+}
+
+export interface ExportArgs {
+  format: string;
+  session?: string[];
+  input?: string[];
+  output?: string;
+  since?: string;
+}
+
+export function exportFiles(
+  args: ExportArgs,
+  files: string[],
+  convert: (text: string) => string,
+): void {
+  if (args.format !== 'agent-session')
+    throw new Error('Unsupported export format');
+  if (!args.output && args.session?.length !== 1)
+    throw new Error('Select exactly one --session or supply --output');
+  const since = args.since ? timestamp(args.since) : undefined;
+  if (args.since && !since)
+    throw new Error('--since must be an RFC 3339 timestamp');
+  const wanted = new Set(args.session);
+  const exports = new Map<string, string>();
+  for (const file of [...new Set(files)].sort()) {
+    if (since && fs.statSync(file).mtimeMs < Date.parse(since)) continue;
+    const text = new TextDecoder('utf-8', { fatal: true }).decode(
+      fs.readFileSync(file),
+    );
+    if (wanted.size) {
+      let identity: unknown;
+      try {
+        identity = object(parseNative(text))['sessionId'];
+      } catch {
+        identity = object(
+          nativeLines(text).find((r) => isString(object(r)['sessionId'])),
+        )['sessionId'];
+      }
+      if (typeof identity !== 'string' || !wanted.has(identity)) continue;
+    }
+    const stream = convert(text);
+    const sessionId = object(parseNative(stream.split('\n')[0]))['sessionId'];
+    if (!isString(sessionId))
+      throw new Error('Missing exported session identity');
+    if (wanted.size && !wanted.has(sessionId)) continue;
+    if (exports.has(sessionId))
+      throw new Error('Several source files have the same session identity');
+    exports.set(sessionId, stream);
+  }
+  if (!exports.size || [...wanted].some((id) => !exports.has(id)))
+    throw new Error('Selected session source is unavailable');
+  if (!args.output) {
+    process.stdout.write([...exports.values()][0]);
+    return;
+  }
+  fs.mkdirSync(args.output, { recursive: true, mode: 0o700 });
+  for (const [id, stream] of exports) {
+    const name = createHash('sha256').update(id).digest('hex') + '.jsonl';
+    fs.writeFileSync(path.join(args.output, name), stream, {
+      mode: 0o600,
+      flag: 'wx',
+    });
+  }
+}
+
+function asrReasoning(text: unknown, summary = false): { type: string; visibility?: string; text?: string; summary?: string[] } {
+  if (typeof text !== "string" || text.length === 0) return { type: "reasoning", visibility: "omitted" };
+  if (summary) return { type: "reasoning", visibility: "summary", summary: [text] };
+  return { type: "reasoning", text };
+}
