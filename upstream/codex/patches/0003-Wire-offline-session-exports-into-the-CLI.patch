From 5a2784564eac45c786e13620ffe82c593dce7908 Mon Sep 17 00:00:00 2001
From: Wills Manley <216224554+willsmanley@users.noreply.github.com>
Date: Sun, 1 Nov 2026 15:32:40 -0500
Subject: [PATCH] Wire offline session exports into the CLI

---
 codex-rs/Cargo.lock      |  1 +
 codex-rs/cli/Cargo.toml  |  1 +
 codex-rs/cli/src/main.rs | 12 ++++++++++++
 3 files changed, 14 insertions(+)

diff --git a/codex-rs/Cargo.lock b/codex-rs/Cargo.lock
index 4373cd7b40..410f54cd3e 100644
--- a/codex-rs/Cargo.lock
+++ b/codex-rs/Cargo.lock
@@ -2546,6 +2546,7 @@ dependencies = [
  "codex-rollout",
  "codex-rollout-trace",
  "codex-sandboxing",
+ "codex-session-export",
  "codex-skills-extension",
  "codex-state",
  "codex-stdio-to-uds",
diff --git a/codex-rs/cli/Cargo.toml b/codex-rs/cli/Cargo.toml
index 8cc0bce5d8..8dd93e5250 100644
--- a/codex-rs/cli/Cargo.toml
+++ b/codex-rs/cli/Cargo.toml
@@ -70,6 +70,7 @@ codex-responses-api-proxy = { workspace = true }
 codex-tcp-tunnel = { workspace = true }
 codex-rmcp-client = { workspace = true }
 codex-rollout = { workspace = true }
+codex-session-export = { workspace = true }
 codex-rollout-trace = { workspace = true }
 codex-sandboxing = { workspace = true }
 codex-skills-extension = { workspace = true }
diff --git a/codex-rs/cli/src/main.rs b/codex-rs/cli/src/main.rs
index 7b167742ad..c7b765d74b 100644
--- a/codex-rs/cli/src/main.rs
+++ b/codex-rs/cli/src/main.rs
@@ -148,6 +148,9 @@ struct MultitoolCli {
 
 #[derive(Debug, clap::Subcommand)]
 enum Subcommand {
+    /// Export saved sessions as Agent Session Record streams.
+    Sessions(codex_session_export::SessionsCommand),
+
     /// Browse all agent sessions on the shared local app-server daemon.
     Agents(AgentsCommand),
 
@@ -1107,6 +1110,14 @@ async fn cli_main(
 
     let open_agents_overview = matches!(&subcommand, Some(Subcommand::Agents(_)));
     match subcommand {
+        Some(Subcommand::Sessions(command)) => {
+            reject_remote_mode_for_subcommand(
+                root_remote.as_deref(),
+                root_remote_auth_token_env.as_deref(),
+                "sessions",
+            )?;
+            command.run().await?;
+        }
         None | Some(Subcommand::Agents(_)) => {
             prepend_config_flags(
                 &mut interactive.config_overrides,
@@ -2391,6 +2402,7 @@ fn unsupported_subcommand_name_for_strict_config(
         Some(Subcommand::StdioToUds(_)) => Some("stdio-to-uds"),
         Some(Subcommand::Features(_)) => Some("features"),
         Some(Subcommand::TcpTunnel(_)) => Some("tcp-tunnel"),
+        Some(Subcommand::Sessions(_)) => Some("sessions"),
     }
 }
 

