 #[test]
+fn discovery_and_command_aliases_remain_explicit() {
+    use clap::Parser;
+    #[derive(Parser)]
+    struct Cli {
+        #[command(flatten)]
+        sessions: crate::SessionsCommand,
+    }
+    assert!(
+        Cli::try_parse_from([
+            "codex-sessions",
+            "export",
+            "--session",
+            THREAD,
+            "--output",
+            "archive"
+        ])
+        .is_ok()
+    );
+    assert!(
+        Cli::try_parse_from(["codex-sessions", "export", "--thread", THREAD, "--all"]).is_err()
+    );
+    let config = tempfile::tempdir().unwrap();
+    crate::discovery::write(
+        config.path(),
+        Path::new("/work/synthetic/.codex"),
+        Path::new("/opt/codex"),
+    )
+    .unwrap();
+    let value: Value = serde_json::from_slice(
+        &fs::read(config.path().join("agent-sessions/sources/codex.json")).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(value["exportCommand"][0], "/opt/codex");
+}
