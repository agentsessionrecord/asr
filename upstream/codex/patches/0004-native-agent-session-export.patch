--- /dev/null
+++ b/codex-rs/session-export/src/discovery.rs
@@ -0,0 +1,39 @@
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use anyhow::Context;
+use serde_json::json;
+
+pub(crate) fn register() -> anyhow::Result<()> {
+    let home = codex_utils_home_dir::find_codex_home()?.into_path_buf();
+    let config = if cfg!(windows) {
+        std::env::var_os("APPDATA")
+            .map(PathBuf::from)
+            .context("APPDATA is unset")?
+    } else if let Some(path) = std::env::var_os("XDG_CONFIG_HOME").filter(|p| !p.is_empty()) {
+        PathBuf::from(path)
+    } else {
+        PathBuf::from(std::env::var_os("HOME").context("HOME is unset")?).join(".config")
+    };
+    let executable = std::env::current_exe()?;
+    write(&config, &home, &executable)?;
+    eprintln!("Registered Codex ASR export discovery.");
+    Ok(())
+}
+
+pub(crate) fn write(config: &Path, home: &Path, executable: &Path) -> anyhow::Result<()> {
+    let dir = config.join("agent-sessions/sources");
+    std::fs::create_dir_all(&dir)?;
+    let mut file = tempfile::NamedTempFile::new_in(&dir)?;
+    let value = json!({
+        "agent":"codex", "formatVersions":["0.1"], "supportsDeletionHook":false,
+        "exportCommand":[executable, "sessions", "export", "--format", "agent-session", "--codex-home", home],
+        "nativePaths":[home.join("sessions/**/*.jsonl*"),home.join("archived_sessions/**/*.jsonl*"),home.join("state_5.sqlite")]
+    });
+    serde_json::to_writer_pretty(&mut file, &value)?;
+    file.write_all(b"\n")?;
+    file.as_file().sync_all()?;
+    file.persist(dir.join("codex.json"))?;
+    Ok(())
+}
