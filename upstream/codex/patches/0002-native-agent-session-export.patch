+fn turn_settings_and_session_configuration_do_not_leak_between_turns() {
+    let (_, r) = mapped(vec![
+        line(
+            "event_msg",
+            json!({"type":"thread_settings_applied","thread_settings":{"reasoning_effort":"low","service_tier":"priority"}}),
+        ),
+        line(
+            "turn_context",
+            json!({"turn_id":"a","model":"requested","effort":"high","approval_policy":"on-request","approvals_reviewer":"user","sandbox_policy":{"type":"external-sandbox","network_access":"enabled"},"collaboration_mode":{"mode":"plan"}}),
+        ),
+        line(
+            "token_usage_record",
+            json!({"turn_id":"a","response_id":"resp-a","usage":{"input_tokens":20,"cached_input_tokens":10,"cache_write_input_tokens":0,"output_tokens":5,"reasoning_output_tokens":2}}),
+        ),
+        line(
+            "turn_context",
+            json!({"turn_id":"b","model":"other","approval_policy":{"granular":{"rules":true}},"sandbox_policy":{"type":"read-only"}}),
+        ),
+        line(
+            "token_usage_record",
+            json!({"turn_id":"b","response_id":"resp-b","usage":{"input_tokens":0}}),
+        ),
+    ]);
+    let settings = rows(&r, "session_info");
+    assert_eq!(
+        settings[0]["agentSettings"]["modelSettings"]["reasoningEffort"],
+        "low"
+    );
+    assert_eq!(settings[1]["agentSettings"]["asks"], "sometimes");
+    assert_eq!(
+        settings[1]["agentSettings"]["externalSandbox"]["source"],
+        "setting"
+    );
+    assert!(
+        settings[1]["agentSettings"]["externalSandbox"]
+            .get("kind")
+            .is_none()
+    );
+    assert!(settings[2]["agentSettings"].get("asks").is_none());
+    assert_eq!(settings[2]["agentSettings"]["externalSandbox"], json!({}));
+    let inferences = rows(&r, "inference");
+    assert_eq!(inferences[0]["id"], "resp-a");
+    assert_eq!(inferences[0]["settings"], json!({"reasoningEffort":"high"}));
+    assert_eq!(inferences[0]["model"], json!({"requested":"requested"}));
+    assert_eq!(inferences[0]["usage"]["inputTokens"], 20);
+    assert_eq!(inferences[0]["usage"]["cacheWriteTokens"], 0);
+    assert!(inferences[1].get("settings").is_none());
+    assert_eq!(inferences[1]["usage"], json!({"inputTokens":0}));
