index 1617a1d276..027bea31ba 100644
--- a/codex-rs/session-export/src/mapping/events.rs
+++ b/codex-rs/session-export/src/mapping/events.rs
@@ -91,10 +91,97 @@ impl Mapper {
     }
 
     pub(super) fn config(&mut self, base: &Value, p: &Value, turn: bool) -> anyhow::Result<()> {
+        let mut settings = json!({});
+        copy(&mut settings, "approval", p, "approval_policy");
+        copy(&mut settings, "sandbox", p, "sandbox_policy");
+        copy(&mut settings, "mode", &p["collaboration_mode"], "mode");
+        for (src, dst) in [
+            ("approval_policy", "approval"),
+            ("sandbox_policy", "sandbox"),
+        ] {
+            if p.get(src).is_some_and(Value::is_null) {
+                settings[dst] = Value::Null;
+            }
+        }
+        if p.get("collaboration_mode").is_some_and(Value::is_null)
+            || p["collaboration_mode"]
+                .get("mode")
+                .is_some_and(Value::is_null)
+        {
+            settings["mode"] = Value::Null;
+        }
+        if let Some(o) = p.as_object() {
+            for (k, v) in o {
+                self.settings[k] = v.clone();
+            }
+        }
+        if turn && p.get("approvals_reviewer").is_none() {
+            // An old snapshot cannot establish who reviews this newer turn.
+            self.settings["approvals_reviewer"] = Value::Null;
+        }
+        if settings.get("approval").is_some()
+            || settings.get("sandbox").is_some()
+            || settings.get("mode").is_some()
+            || p.get("approvals_reviewer").is_some()
+        {
+            let policy = self.settings["approval_policy"].as_str();
+            let reviewer = self.settings["approvals_reviewer"].as_str();
+            let asks = match (policy, reviewer) {
+                (Some("never"), _) => Some("never"),
+                (Some("on-request" | "untrusted" | "on-failure"), Some("user")) => {
+                    Some("sometimes")
+                }
+                _ => None,
+            };
+            if let Some(asks) = asks {
+                settings["asks"] = asks.into();
+            }
+            // A reviewer-only change must invalidate an old asks value too.
+            else if p.get("approvals_reviewer").is_some() {
+                copy(&mut settings, "approval", &self.settings, "approval_policy");
+            }
+        }
+        if p["sandbox_policy"]["type"] == "external-sandbox" {
+            settings["externalSandbox"] = json!({"source":"setting","native":p["sandbox_policy"]});
+        } else if p.get("sandbox_policy").is_some() {
+            // Stop applying a previously declared outer boundary.
+            settings["externalSandbox"] = json!({});
+        }
+        let mut configured = model_settings(p, if turn { "effort" } else { "reasoning_effort" });
+        for (src, dst) in [
+            (
+                if turn { "effort" } else { "reasoning_effort" },
+                "reasoningEffort",
+            ),
+            ("service_tier", "serviceTier"),
+        ] {
+            if p.get(src).is_some_and(Value::is_null) {
+                configured[dst] = Value::Null;
+            }
+        }
+        if configured.as_object().is_some_and(|o| !o.is_empty()) {
+            settings["modelSettings"] = configured;
+        }
         if turn && let Some(id) = base["turnId"].as_str() {
             self.configs.insert(id.to_owned(), p.clone());
         }
-        self.audit(base, "settings", p)
+        if settings.as_object().is_some_and(|o| !o.is_empty()) {
+            let mut r = record(base, "session_info");
+            r["agentSettings"] = settings;
+            meta(
+                &mut r,
+                if turn {
+                    "turnContext"
+                } else {
+                    "threadSettings"
+                },
+                p.clone(),
+            );
+            self.emit(r)?;
+        } else {
+            self.audit(base, "settings", p)?;
+        }
+        Ok(())
     }
 
     pub(super) fn usage(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
@@ -133,15 +220,72 @@ impl Mapper {
     }
 
     pub(super) fn auto_approval(&mut self, base: &Value, call: &Value) -> anyhow::Result<()> {
-        self.audit(
-            base,
-            "automatic_approval",
-            &json!({"call_id":call, "auto_approved":true}),
-        )
+        let mut r = record(base, "approval");
+        if let Some(call) = call.as_str() {
+            r["callId"] = call.into();
+        } else {
+            return Ok(());
+        }
+        r["decision"] = "approved".into();
+        r["native"] = json!({"auto_approved":true});
+        // The flag states that no approval request was needed, but does not
+        // distinguish mode, policy, hook or a reused grant, nor grant lifetime.
+        self.emit(r)?;
+        Ok(())
     }
 
     pub(super) fn approval(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
-        self.audit(base, "approval", p)
+        let raw = &p["decision"];
+        let d = raw.as_str().or_else(|| {
+            raw.as_object()
+                .and_then(|o| o.keys().next().map(String::as_str))
+        });
+        let (decision, scope) = match d {
+            Some("approved") => ("approved", Some("once")),
+            Some("approved_for_session") => ("approved", Some("session")),
+            Some(
+                "approved_with_amendment"
+                | "approved_execpolicy_amendment"
+                | "approved_mcp_policy_amendment"
+                | "approved_with_network_policy_allow",
+            ) => ("approved", Some("always")),
+            Some("denied" | "denied_with_network_policy_deny") => ("denied", None),
+            Some("timed_out") => ("cancelled", None),
+            // Current native Abort says a person denied and paused the turn.
+            // It is not an unanswered cancellation (see spec feedback).
+            Some("abort") => ("denied", None),
+            Some("network_policy_amendment") => {
+                match raw["network_policy_amendment"]["network_policy_amendment"]["action"].as_str()
+                {
+                    Some("allow") => ("approved", Some("always")),
+                    Some("deny") => ("denied", None),
+                    _ => return self.audit(base, "tool_decision", p),
+                }
+            }
+            _ => return self.audit(base, "tool_decision", p),
+        };
+        let mut r = record(base, "approval");
+        r["decision"] = decision.into();
+        r["native"] = raw.clone();
+        copy(&mut r, "callId", p, "call_id");
+        copy(&mut r, "subject", p, "subject");
+        if r.get("callId").is_none() && r.get("subject").is_none() {
+            return self.audit(base, "tool_decision", p);
+        }
+        if let Some(scope) = scope {
+            r["scope"] = scope.into();
+        }
+        if let Some(by) = match p["source"].as_str() {
+            Some("User" | "user") if decision != "cancelled" => Some("user"),
+            Some("Config" | "config") => Some("policy"),
+            Some("AutomatedReviewer" | "automated_reviewer") => Some("classifier"),
+            _ => None,
+        } {
+            r["by"] = by.into();
+        }
+        meta(&mut r, "toolDecision", p.clone());
+        self.emit(r)?;
+        Ok(())
     }
 }
 
