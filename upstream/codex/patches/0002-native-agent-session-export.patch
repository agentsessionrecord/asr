         if self.index.inference_last.is_empty() {
             missing.insert("usage".into());
         }
@@ -163,7 +168,61 @@ impl Mapper {
     }
 
     pub(super) fn tools(&mut self, base: &Value, definitions: &Value) -> anyhow::Result<()> {
-        self.audit(base, "tool_definitions", definitions)
+        // Native removals are customizable prose, without a durable list of
+        // removed names. Do not leave a known-stale catalog in effect.
+        if self.index.tools_removed {
+            return self.audit(
+                base,
+                "tool_definitions_with_unresolved_removals",
+                definitions,
+            );
+        }
+        let mut tools = Vec::new();
+        collect_tools(definitions, None, &mut tools);
+        if tools.is_empty() {
+            return self.audit(base, "tool_definitions", definitions);
+        }
+        // AdditionalTools and dynamic_tools are additions, not a full inventory.
+        // Retain the known union and declare that built-in tools may be absent.
+        for tool in tools {
+            self.offered_tools
+                .retain(|old| old["name"] != tool["name"] || old["source"] != tool["source"]);
+            self.offered_tools.push(tool);
+        }
+        let mut r = record(base, "session_info");
+        r["tools"] = json!(self.offered_tools);
+        meta(&mut r, "toolDefinitions", definitions.clone());
+        self.emit(r)?;
+        Ok(())
+    }
+}
+
+fn collect_tools(definitions: &Value, namespace: Option<&str>, out: &mut Vec<Value>) {
+    for tool in definitions.as_array().into_iter().flatten() {
+        if tool["type"] == "namespace" {
+            collect_tools(&tool["tools"], tool["name"].as_str(), out);
+            continue;
+        }
+        let definition = if tool["function"].is_object() {
+            &tool["function"]
+        } else {
+            tool
+        };
+        let Some(name) = definition["name"].as_str() else {
+            continue;
+        };
+        let mut r = json!({"name":name});
+        copy(&mut r, "description", definition, "description");
+        for key in ["parameters", "input_schema", "inputSchema"] {
+            if let Some(schema) = definition.get(key) {
+                r["inputSchema"] = schema.clone();
+                break;
+            }
+        }
+        if let Some(source) = tool["namespace"].as_str().or(namespace) {
+            r["source"] = source.into();
+        }
+        out.push(r);
     }
 }
 
