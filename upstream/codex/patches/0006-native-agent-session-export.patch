+#[tokio::test]
+async fn tui_file_export_is_private_and_never_overwrites() {
+    let home = tempfile::tempdir().unwrap();
+    rollout(home.path(), false);
+    let path = home.path().join("session.jsonl");
+    let thread = codex_protocol::ThreadId::from_string(THREAD).unwrap();
+    crate::export_thread_to_file(home.path().into(), home.path().into(), thread, path.clone())
+        .await
+        .unwrap();
+    let bytes = fs::read(&path).unwrap();
+    let header: Value =
+        serde_json::from_slice(bytes.split(|byte| *byte == b'\n').next().unwrap()).unwrap();
+    assert_eq!(header["sessionId"], THREAD);
+    assert!(
+        crate::export_thread_to_file(home.path().into(), home.path().into(), thread, path.clone())
+            .await
+            .is_err()
+    );
+    assert_eq!(fs::read(&path).unwrap(), bytes);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(
+            fs::metadata(path).unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+    }
+}
+
+#[test]
+fn dynamic_tool_catalog_replacements_remain_positioned_native_events() {
+    let payload = json!({"thread_id":THREAD,"tools":[{"type":"function","name":"lookup","description":"Synthetic lookup","inputSchema":{"type":"object"}}]});
+    let update = line("dynamic_tools_updated", payload.clone());
+    assert!(matches!(
+        codex_rollout::decode_rollout_line(update.clone())
+            .unwrap()
+            .item,
+        codex_rollout::RolloutItem::DynamicToolsUpdated { .. }
+    ));
+    let (header, records) = mapped(vec![
+        update,
+        line(
+            "dynamic_tools_updated",
+            json!({"thread_id":THREAD,"tools":[]}),
+        ),
+    ]);
+    assert_eq!(records.len(), 2);
+    assert_eq!(
+        records[0]["_meta"]["com.openai.codex"]["event"]["payload"],
+        payload
+    );
+    assert_eq!(
+        records[1]["_meta"]["com.openai.codex"]["event"]["payload"]["tools"],
+        json!([])
+    );
+    assert!(
+        header["missing"]
+            .as_array()
+            .unwrap()
+            .contains(&json!("native_event_normalization"))
+    );
+    assert!(
+        records
+            .iter()
+            .all(|record| record["type"] == "com.openai.codex/event")
+    );
+}
