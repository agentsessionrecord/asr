+#[tokio::test]
+async fn structured_export_uses_the_existing_export_command() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(None).await;
+    chat.handle_slash_command_with_args_dispatch(
+        SlashCommand::Export,
+        "--format agent-session record.jsonl".into(),
+        Vec::new(),
+    );
+    assert!(std::iter::from_fn(|| rx.try_recv().ok()).any(|event| matches!(event,
+        AppEvent::ExportTranscript { destination: TranscriptExportDestination::AgentSessionFile(path) } if path.as_path() == std::path::Path::new("record.jsonl"))));
