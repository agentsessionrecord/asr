+/// Export one persisted thread to a new private file for the TUI export command.
+/// Existing files remain untouched, including when conversion fails.
+pub async fn export_thread_to_file(
+    home: PathBuf,
+    sqlite_home: PathBuf,
+    thread: ThreadId,
+    output: PathBuf,
+) -> anyhow::Result<()> {
+    let state = state::Snapshot::read(&sqlite_home).await?;
+    tokio::task::spawn_blocking(move || {
+        let parent = output
+            .parent()
+            .filter(|path| !path.as_os_str().is_empty())
+            .unwrap_or(std::path::Path::new("."));
+        let mut staged = tempfile::NamedTempFile::new_in(parent)?;
+        let args = ExportArgs {
+            format: "agent-session".into(),
+            thread: Some(thread),
+            all: false,
+            out: None,
+            codex_home: Some(home.clone()),
+            sqlite_home: Some(sqlite_home),
+            max_line_bytes: 67_108_864,
+        };
+        export::run_to(&home, &args, state, &mut staged)?;
+        staged.as_file().sync_all()?;
+        staged.persist_noclobber(output)?;
+        anyhow::Ok(())
+    })
+    .await?
+}
