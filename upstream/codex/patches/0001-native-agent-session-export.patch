index 0000000000..f9d02a6828
--- /dev/null
+++ b/codex-rs/session-export/src/source.rs
@@ -0,0 +1,520 @@
+//! Storage adapter. Never constructs a recorder, StateRuntime, or a migration job.
+
+use std::collections::BTreeMap;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::io::Read;
+use std::io::Seek;
+use std::io::SeekFrom;
+use std::path::Path;
+use std::path::PathBuf;
+
+use anyhow::Context;
+use anyhow::bail;
+use codex_protocol::ThreadId;
+use codex_rollout::RolloutItem;
+use serde_json::Value;
+
+#[derive(Clone, Debug)]
+pub(crate) struct Segment {
+    pub path: PathBuf,
+    pub rollout_id: String,
+    pub meta: Value,
+    pub thread_id: String,
+}
+
+pub(crate) struct Source<'a> {
+    reader: BufReader<Box<dyn ReadSeek + 'a>>,
+    pub bytes: u64,
+    pub line: u64,
+    max_line_bytes: usize,
+    offset: u64,
+}
+trait ReadSeek: Read + Seek {}
+impl<T: Read + Seek> ReadSeek for T {}
+
+impl<'a> Source<'a> {
+    pub fn open(path: &'a Path, max_line_bytes: usize) -> anyhow::Result<Self> {
+        let mut reader = codex_rollout::open_rollout_seekable_reader(path, || false)?;
+        let bytes = reader.seek(SeekFrom::End(0))?;
+        reader.rewind()?;
+        Ok(Self {
+            reader: BufReader::with_capacity(1024 * 1024, Box::new(reader)),
+            bytes,
+            line: 0,
+            max_line_bytes,
+            offset: 0,
+        })
+    }
+
+    pub fn rewind(&mut self) -> anyhow::Result<()> {
+        self.reader.rewind()?;
+        self.line = 0;
+        self.offset = 0;
+        Ok(())
+    }
+
+    // Retain a fixed byte boundary even when a live rollout grows. A torn final
+    // record is a gap, never passed off as a complete native record.
+    pub fn next(&mut self) -> anyhow::Result<Option<Value>> {
+        if self.offset >= self.bytes {
+            return Ok(None);
+        }
+        let mut bytes = Vec::new();
+        loop {
+            let remaining = self.bytes - self.offset;
+            if remaining == 0 {
+                break;
+            }
+            let available = self.reader.fill_buf()?;
+            if available.is_empty() {
+                self.offset = self.bytes;
+                break;
+            }
+            let available = &available[..available.len().min(remaining as usize)];
+            let n = available
+                .iter()
+                .position(|b| *b == b'\n')
+                .map_or(available.len(), |i| i + 1);
+            if bytes.len() + n > self.max_line_bytes {
+                bail!(
+                    "native line exceeds --max-line-bytes at line {}",
+                    self.line + 1
+                );
+            }
+            bytes.extend_from_slice(&available[..n]);
+            self.reader.consume(n);
+            self.offset += n as u64;
+            if bytes.last() == Some(&b'\n') {
+                break;
+            }
+        }
+        self.line += 1;
+        if bytes.last() != Some(&b'\n') {
+            return Ok(Some(
+                serde_json::json!({"type":"_gap", "reason":"source_truncated"}),
+            ));
+        }
+        if bytes.iter().all(u8::is_ascii_whitespace) {
+            return Ok(Some(serde_json::json!({"type":"_blank"})));
+        }
+        Ok(Some(match serde_json::from_slice::<Value>(&bytes) {
+            Ok(value) if value.is_object() && value["type"].is_string() => value,
+            _ => serde_json::json!({"type":"_gap", "reason":"unparseable"}),
+        }))
+    }
+}
+
+pub(crate) struct Inventory {
+    pub segments: Vec<Segment>,
+    pub unavailable: Vec<Value>,
+}
+
+pub(crate) fn inventory(
+    home: &Path,
+    max_line_bytes: usize,
+    threads: &HashMap<String, Value>,
+) -> anyhow::Result<Inventory> {
+    let mut paths = Vec::new();
+    let mut unavailable = Vec::new();
+    let mut visited = HashSet::new();
+    for root in [home.join("sessions"), home.join("archived_sessions")] {
+        if root.exists() {
+            walk(&root, &mut paths, &mut unavailable, &mut visited)?;
+        }
+    }
+    paths.sort();
+    // Codex's reader prefers plain when both representations exist during compression.
+    let mut seen = HashSet::new();
+    let mut segments = Vec::new();
+    for path in paths {
+        let plain = codex_rollout::plain_rollout_path(&path);
+        if !seen.insert(plain.clone()) {
+            continue;
+        }
+        let rollout_id = codex_rollout::rollout_id_from_path(&path)
+            .map(|id| id.to_string())
+            .context("rollout filename has no native rollout ID")?;
+        let filename = plain
+            .file_name()
+            .and_then(|s| s.to_str())
+            .unwrap_or_default();
+        // A legacy fork may carry its parent's header before its own. The filename
+        // selects between recorded headers. If none is readable, recovery below
+        // explicitly records the weaker filename/index evidence.
+        let hint = filename.get(28..64);
+        let prefix = codex_rollout::read_rollout_prefix(&path, max_line_bytes.min(1024 * 1024))?
+            .context("rollout is not a regular file")?;
+        let mut candidate = None;
+        for bytes in prefix
+            .split_inclusive(|b| *b == b'\n')
+            .filter(|b| b.last() == Some(&b'\n'))
+        {
+            if let Ok(value) = serde_json::from_slice::<Value>(bytes)
+                && let Some(found) = session_meta(&value)
+            {
+                candidate = Some(found);
+                if candidate
+                    .as_ref()
+                    .is_some_and(|(id, _)| hint == Some(id.as_str()))
+                {
+                    break;
+                }
+            }
+        }
+        if !candidate
+            .as_ref()
+            .is_some_and(|(id, _)| hint == Some(id.as_str()))
+        {
+            let mut reader = Source::open(&path, max_line_bytes)?;
+            while let Some(value) = reader.next()? {
+                if let Some(found) = session_meta(&value) {
+                    candidate = Some(found);
+                    if candidate
+                        .as_ref()
+                        .is_some_and(|(id, _)| hint == Some(id.as_str()))
+                    {
+                        break;
+                    }
+                }
+            }
+        }
+        // A surviving ancestor header is not this child's identity.
+        let candidate = candidate.filter(|(id, _)| hint == Some(id.as_str()));
+        let (thread_id, meta) = match candidate {
+            Some(found) => found,
+            None => {
+                // The canonical basename encodes a native thread ID (validated by
+                // rollout_id_from_path above). Do not derive it from timestamps or
+                // content, or fabricate the missing session settings.
+                let id = hint.context("unreadable header and no native thread ID")?;
+                ThreadId::from_string(id)?;
+                let indexed = threads.get(id).is_some_and(|row| {
+                    row["rollout_path"].as_str().is_some_and(|p| {
+                        codex_rollout::plain_rollout_path(Path::new(p)).file_name()
+                            == plain.file_name()
+                    })
+                });
+                if !indexed {
+                    unavailable
+                        .push(serde_json::json!({"path":path,"code":"unrecoverable-header"}));
+                    continue;
+                }
+                (
+                    id.to_owned(),
+                    serde_json::json!({"id":id,"_asrIdentityRecovery":{"source":if indexed {"state_index_and_rollout_filename"} else {"rollout_filename"},"reason":"unreadable_session_meta"}}),
+                )
+            }
+        };
+        segments.push(Segment {
+            path,
+            rollout_id,
+            meta,
+            thread_id,
+        });
+    }
+    Ok(Inventory {
+        segments,
+        unavailable,
+    })
+}
+
+fn session_meta(value: &Value) -> Option<(String, Value)> {
+    if value["type"] != "session_meta" {
+        return None;
+    }
+    // Older versions did not persist all fields required by today's SessionMeta.
+    // Validate the native identity independently; raw fields preserve true absence.
+    if let Ok(line) = codex_rollout::decode_rollout_line(value.clone())
+        && !matches!(line.item, RolloutItem::SessionMeta(_))
+    {
+        return None;
+    }
+    let id = value["payload"]["id"].as_str()?;
+    ThreadId::from_string(id).ok()?;
+    Some((id.to_owned(), value["payload"].clone()))
+}
+
+fn walk(
+    dir: &Path,
+    paths: &mut Vec<PathBuf>,
+    unavailable: &mut Vec<Value>,
+    visited: &mut HashSet<PathBuf>,
+) -> anyhow::Result<()> {
+    if !visited.insert(fs::canonicalize(dir)?) {
+        return Ok(());
+    }
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        let kind = entry.file_type()?;
+        let path = if kind.is_symlink() {
+            match fs::canonicalize(entry.path()) {
+                Ok(path) => path,
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                    unavailable
+                        .push(serde_json::json!({"path":entry.path(),"code":"unavailable-alias"}));
+                    continue;
+                }
+                Err(e) => return Err(e.into()),
+            }
+        } else {
+            entry.path()
+        };
+        if path.is_dir() {
+            walk(&path, paths, unavailable, visited)?;
+        } else if path.is_file() {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name.starts_with("rollout-")
+                && (name.ends_with(".jsonl") || name.ends_with(".jsonl.zst"))
+            {
+                paths.push(path);
+            }
+        }
+    }
+    Ok(())
+}
+
+#[derive(Default)]
+pub(crate) struct Index {
+    pub model_calls: HashSet<String>,
+    pub code_invocations: HashSet<String>,
+    pub triggers: HashMap<String, Value>,
+    pub parents: HashMap<String, String>,
+    pub secret_calls: HashSet<String>,
+    pub secrets: Vec<String>,
+    pub record_ids: HashMap<String, u64>,
+    pub result_last: HashMap<String, u64>,
+    pub inference_last: HashMap<String, u64>,
+    pub execution_calls: HashSet<String>,
+    pub tools_removed: bool,
+    position: u64,
+}
+
+impl Index {
+    pub fn scan(&mut self, source: &mut Source<'_>) -> anyhow::Result<()> {
+        while let Some(mut line) = source.next()? {
+            crate::content::stringify_wide_numbers(&mut line);
+            self.position += 1;
+            let p = &line["payload"];
+            crate::content::collect_credentials(p, &mut self.secrets);
+            let id = if line["type"] == "token_usage_record" {
+                p["response_id"].as_str()
+            } else if line["type"] == "event_msg" {
+                p["item"]["id"].as_str()
+            } else {
+                p["id"].as_str()
+            };
+            if let Some(id) = id {
+                *self.record_ids.entry(id.to_owned()).or_default() += 1;
+            }
+            if line["type"] == "token_usage_record"
+                && let Some(id) = p["response_id"].as_str()
+            {
+                self.inference_last.insert(id.to_owned(), self.position);
+            }
+            let result_call = if line["type"] == "response_item"
+                && matches!(
+                    p["type"].as_str(),
+                    Some("function_call_output" | "custom_tool_call_output" | "tool_search_output")
+                ) {
+                p["call_id"].as_str()
+            } else if line["type"] == "event_msg"
+                && p["type"] == "item_completed"
+                && matches!(
+                    p["item"]["type"].as_str(),
+                    Some(
+                        "CommandExecution"
+                            | "McpToolCall"
+                            | "DynamicToolCall"
+                            | "FileChange"
+                            | "CollabAgentToolCall"
+                            | "FunctionCallOutput"
+                    )
+                )
+            {
+                p["item"]["id"].as_str()
+            } else if line["type"] == "event_msg"
+                && matches!(
+                    p["type"].as_str(),
+                    Some("patch_apply_end" | "mcp_tool_call_end" | "exec_command_end")
+                )
+            {
+                p["call_id"].as_str()
+            } else {
+                None
+            };
+            if let Some(id) = result_call {
+                self.result_last.insert(id.to_owned(), self.position);
+                if line["type"] == "event_msg" {
+                    self.execution_calls.insert(id.to_owned());
+                }
+            }
+            if line["type"] == "response_item" {
+                let kind = p["type"].as_str().unwrap_or_default();
+                if kind.ends_with("_call")
+                    && let Some(id) = p["call_id"].as_str().or(p["id"].as_str())
+                {
+                    self.model_calls.insert(id.to_owned());
+                    if p["type"] == "custom_tool_call" && p["name"] == "exec" {
+                        self.code_invocations.insert(id.to_owned());
+                    }
+                    if matches!(
+                        p["name"].as_str(),
+                        Some(
+                            "request_user_input"
+                                | "request_user_input_async"
+                                | "send_message_to_user_async"
+                                | "request_secret"
+                        )
+                    ) {
+                        let args = arguments(p);
+                        if p["name"] == "request_secret"
+                            || args["questions"].as_array().is_some_and(|qs| {
+                                qs.iter().any(|q| {
+                                    q["isSecret"] == true
+                                        || q["is_secret"] == true
+                                        || q["secret"] == true
+                                })
+                            })
+                        {
+                            self.secret_calls.insert(id.to_owned());
+                        }
+                    }
+                }
+                let m = &p["internal_chat_message_metadata_passthrough"];
+                self.tools_removed |= m["content_item_kinds"].as_array().is_some_and(|kinds| {
+                    kinds.iter().any(|kind| kind == "tools.removed_definition")
+                });
+                if let Some(calls) = m["executed_tool_calls"].as_array() {
+                    // The output's call_id identifies the outer invocation. A cell_id
+                    // alone is not a model call ID; never invent that equivalence.
+                    if let Some(parent) = p["call_id"].as_str().filter(|id| {
+                        m["cell_id"].is_string() && self.code_invocations.contains(*id)
+                    }) {
+                        for call in calls {
+                            if let Some(id) = call["id"].as_str().or(call["call_id"].as_str()) {
+                                self.parents.insert(id.to_owned(), parent.to_owned());
+                            }
+                        }
+                    }
+                }
+            }
+            if matches!(p["type"].as_str(), Some("task_started" | "turn_started"))
+                && let Some(turn) = p["turn_id"].as_str()
+                && p["turn_attribution"]["turn_trigger"].is_string()
+            {
+                self.triggers
+                    .insert(turn.to_owned(), p["turn_attribution"].clone());
+            }
+        }
+        self.secrets.sort();
+        self.secrets.dedup();
+        source.rewind()
+    }
+
+    pub fn scan_secrets(&mut self, source: &mut Source<'_>) -> anyhow::Result<()> {
+        if self.secret_calls.is_empty() {
+            return Ok(());
+        }
+        while let Some(line) = source.next()? {
+            let p = &line["payload"];
+            if p["call_id"]
+                .as_str()
+                .is_some_and(|id| self.secret_calls.contains(id))
+                && p["type"].as_str().is_some_and(|s| s.ends_with("_output"))
+            {
+                let output = if let Some(s) = p["output"].as_str() {
+                    serde_json::from_str(s).unwrap_or_else(|_| Value::String(s.to_owned()))
+                } else {
+                    p["output"].clone()
+                };
+                collect_strings(output.get("answers").unwrap_or(&output), &mut self.secrets);
+            }
+            // Verified answers can survive compaction after the tool output is gone.
+            collect_retained_secrets(p, &self.secret_calls, &mut self.secrets);
+        }
+        self.secrets.sort();
+        self.secrets.dedup();
+        source.rewind()
+    }
+}
+
+fn collect_retained_secrets(value: &Value, calls: &HashSet<String>, secrets: &mut Vec<String>) {
+    match value {
+        Value::Object(o) => {
+            if o.get("call_id")
+                .and_then(Value::as_str)
+                .is_some_and(|id| calls.contains(id))
+            {
+                for q in value["questions"].as_array().into_iter().flatten() {
+                    collect_strings(&q["answer"], secrets);
+                }
+            }
+            for child in o.values() {
+                collect_retained_secrets(child, calls, secrets);
+            }
+        }
+        Value::Array(a) => {
+            for child in a {
+                collect_retained_secrets(child, calls, secrets);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn collect_strings(value: &Value, strings: &mut Vec<String>) {
+    match value {
+        Value::String(s) if !s.is_empty() => strings.push(s.clone()),
+        Value::Array(a) => a.iter().for_each(|v| collect_strings(v, strings)),
+        Value::Object(o) => o.values().for_each(|v| collect_strings(v, strings)),
+        _ => {}
+    }
+}
+
+pub(crate) fn arguments(p: &Value) -> Value {
+    p["arguments"]
+        .as_str()
+        .and_then(|s| serde_json::from_str(s).ok())
+        .unwrap_or_else(|| p["arguments"].clone())
+}
+
+pub(crate) fn groups(segments: Vec<Segment>) -> anyhow::Result<BTreeMap<String, Vec<Segment>>> {
+    let mut groups: BTreeMap<String, Vec<Segment>> = BTreeMap::new();
+    for segment in segments {
+        groups
+            .entry(segment.thread_id.clone())
+            .or_default()
+            .push(segment);
+    }
+    for segments in groups.values_mut() {
+        segments.sort_by(|a, b| {
+            a.meta["timestamp"]
+                .as_str()
+                .cmp(&b.meta["timestamp"].as_str())
+                .then(a.rollout_id.cmp(&b.rollout_id))
+        });
+        let ids: HashSet<_> = segments.iter().map(|s| s.rollout_id.clone()).collect();
+        let mut ordered = Vec::new();
+        let mut emitted = HashSet::new();
+        while !segments.is_empty() {
+            let i = segments
+                .iter()
+                .position(|s| {
+                    s.meta["history_base"]["thread_id"]
+                        .as_str()
+                        .is_none_or(|id| !ids.contains(id) || emitted.contains(id))
+                })
+                .context("cycle between rollout segments")?;
+            let next = segments.remove(i);
+            emitted.insert(next.rollout_id.clone());
+            ordered.push(next);
+        }
+        *segments = ordered;
+    }
+    Ok(groups)
+}
diff --git a/codex-rs/session-export/src/state.rs b/codex-rs/session-export/src/state.rs
new file mode 100644
index 0000000000..f3405bc9aa
--- /dev/null
+++ b/codex-rs/session-export/src/state.rs
@@ -0,0 +1,124 @@
+//! Snapshot authoritative metadata through the existing read-only SQLite API.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use codex_state::SqliteConfig;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde_json::Map;
+use serde_json::Value;
+use sqlx::Column;
+use sqlx::Row;
+use sqlx::ValueRef;
+
+#[derive(Default)]
+pub(crate) struct Snapshot {
+    pub threads: HashMap<String, Value>,
+    pub projects: HashMap<String, Value>,
+    pub sections: HashMap<String, Value>,
+    pub rows: HashMap<String, Vec<(String, Value)>>,
+    pub available: bool,
+}
+
+impl Snapshot {
+    pub async fn read(home: &Path) -> anyhow::Result<Self> {
+        let config = SqliteConfig::from_sqlite_home_with_nfs_enforcement(
+            AbsolutePathBuf::relative_to_current_dir(home)?,
+            false,
+        );
+        let mut snapshot = Self::default();
+        for (path, tables) in [
+            (
+                config.state_db_path(),
+                &[
+                    "threads",
+                    "projects",
+                    "thread_spawn_edges",
+                    "thread_attachments",
+                    "thread_read_receipts",
+                    "thread_sections",
+                ][..],
+            ),
+            (home.join("goals_1.sqlite"), &["thread_goals"][..]),
+            (home.join("queue_1.sqlite"), &["queued_items"][..]),
+            (home.join("memories_1.sqlite"), &["stage1_outputs"][..]),
+        ] {
+            if !path.exists() {
+                continue;
+            }
+            let pool = config
+                .open_read_only_pool(&path, Some(std::time::Duration::from_secs(5)))
+                .await?;
+            // One consistent snapshot per database, without migration or backfill.
+            let mut tx = pool.begin().await?;
+            for table in tables {
+                let exists: i64 = sqlx::query_scalar(
+                    "SELECT count(*) FROM sqlite_master WHERE type='table' AND name=?",
+                )
+                .bind(table)
+                .fetch_one(&mut *tx)
+                .await?;
+                if exists == 0 {
+                    continue;
+                }
+                // Table names above are static, never user input.
+                for row in sqlx::query(sqlx::AssertSqlSafe(format!("SELECT * FROM {table}")))
+                    .fetch_all(&mut *tx)
+                    .await?
+                {
+                    let mut object = Map::new();
+                    for column in row.columns() {
+                        let name = column.name();
+                        if row.try_get_raw(name)?.is_null() {
+                            continue;
+                        }
+                        let value = if let Ok(n) = row.try_get::<i64, _>(name) {
+                            Value::from(n)
+                        } else if let Ok(n) = row.try_get::<f64, _>(name) {
+                            Value::from(n)
+                        } else if let Ok(s) = row.try_get::<String, _>(name) {
+                            Value::String(s)
+                        } else {
+                            continue;
+                        };
+                        object.insert(name.to_owned(), value);
+                    }
+                    let value = Value::Object(object);
+                    match *table {
+                        "threads" => {
+                            if let Some(id) = value["id"].as_str() {
+                                snapshot.threads.insert(id.to_owned(), value);
+                            }
+                            snapshot.available = true;
+                        }
+                        "thread_sections" => {
+                            if let Some(id) = value["id"].as_str() {
+                                snapshot.sections.insert(id.to_owned(), value);
+                            }
+                        }
+                        "projects" => {
+                            if let Some(id) = value["id"].as_str() {
+                                snapshot.projects.insert(id.to_owned(), value);
+                            }
+                        }
+                        _ => {
+                            if let Some(id) = value["thread_id"]
+                                .as_str()
+                                .or(value["parent_thread_id"].as_str())
+                            {
+                                snapshot
+                                    .rows
+                                    .entry(id.to_owned())
+                                    .or_default()
+                                    .push((table.to_string(), value));
+                            }
+                        }
+                    }
+                }
+            }
+            tx.rollback().await?;
+            pool.close().await;
+        }
+        Ok(snapshot)
+    }
+}
diff --git a/codex-rs/session-export/src/stream.rs b/codex-rs/session-export/src/stream.rs
new file mode 100644
index 0000000000..046649e364
--- /dev/null
+++ b/codex-rs/session-export/src/stream.rs
@@ -0,0 +1,87 @@
+//! Private streaming output and disk-backed folding of tool-result updates.
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs::File;
+use std::io::{BufRead, BufReader, BufWriter, Seek, SeekFrom, Write};
+
+use serde_json::Value;
+
+pub(crate) struct Stream {
+    pub file: tempfile::NamedTempFile,
+    writer: BufWriter<File>,
+    pending_file: tempfile::NamedTempFile,
+    pending: HashMap<String, u64>,
+    reserved: HashSet<String>,
+    pub count: u64,
+    position: u64,
+    slot: u64,
+}
+
+impl Stream {
+    pub fn new(reserved: HashSet<String>) -> anyhow::Result<Self> {
+        let file = tempfile::NamedTempFile::new()?;
+        Ok(Self {
+            writer: BufWriter::new(file.reopen()?),
+            file,
+            pending_file: tempfile::NamedTempFile::new()?,
+            pending: HashMap::new(),
+            reserved,
+            count: 0,
+            position: 0,
+            slot: 0,
+        })
+    }
+
+    pub fn position(&mut self, position: u64) {
+        self.position = position;
+        self.slot = 0;
+    }
+
+    pub fn emit(&mut self, mut record: Value) -> anyhow::Result<String> {
+        let id = if let Some(id) = record["id"].as_str() {
+            id.to_owned()
+        } else {
+            loop {
+                let id = format!("asr:{}:{}", self.position, self.slot);
+                self.slot += 1;
+                if !self.reserved.contains(&id) {
+                    break id;
+                }
+            }
+        };
+        record["id"] = id.clone().into();
+        serde_json::to_writer(&mut self.writer, &record)?;
+        self.writer.write_all(b"\n")?;
+        self.count += 1;
+        Ok(id)
+    }
+
+    pub fn save_result(&mut self, key: &str, value: &Value) -> anyhow::Result<()> {
+        let file = self.pending_file.as_file_mut();
+        let offset = file.seek(SeekFrom::End(0))?;
+        serde_json::to_writer(&mut *file, value)?;
+        file.write_all(b"\n")?;
+        self.pending.insert(key.to_owned(), offset);
+        Ok(())
+    }
+
+    pub fn take_result(&mut self, key: &str) -> anyhow::Result<Option<Value>> {
+        let Some(offset) = self.pending.remove(key) else {
+            return Ok(None);
+        };
+        let mut reader = BufReader::new(self.pending_file.reopen()?);
+        reader.seek(SeekFrom::Start(offset))?;
+        let mut line = String::new();
+        reader.read_line(&mut line)?;
+        Ok(Some(serde_json::from_str(&line)?))
+    }
+
+    pub fn finish(&mut self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            self.pending.is_empty(),
+            "unfolded tool results at capture boundary"
+        );
+        self.writer.flush()?;
+        Ok(())
+    }
+}
