+        .unwrap()
+        .map(|p| p.unwrap().path())
+        .collect::<Vec<_>>();
+    assert_eq!(paths.len(), 2);
+    let annotation = paths
+        .iter()
+        .find(|p| p.to_string_lossy().ends_with(".annotations.jsonl"))
