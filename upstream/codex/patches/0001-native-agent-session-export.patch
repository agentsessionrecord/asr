+++ b/codex-rs/session-export/src/lib.rs
@@ -0,0 +1,83 @@
+//! Read-only export of Codex's persisted history to Agent Session Record 0.1.
+//!
+//! This is an archive export, not a sharing/redaction service or a replay path.
+
+mod content;
+mod export;
+mod mapping;
+mod source;
+mod state;
+mod stream;
+
+use std::path::PathBuf;
+
+use anyhow::bail;
+use clap::Args;
+use clap::Subcommand;
+use codex_protocol::ThreadId;
+
+#[derive(Debug, Args)]
+pub struct SessionsCommand {
+    #[command(subcommand)]
+    pub command: SessionCommand,
+}
+
+#[derive(Debug, Subcommand)]
+pub enum SessionCommand {
+    /// Write a private ASR archive. Existing output directories are never overwritten.
+    Export(ExportArgs),
+}
+
+#[derive(Clone, Debug, Args)]
+pub struct ExportArgs {
+    #[arg(long, default_value = "agent-session", value_parser = ["agent-session"])]
+    pub format: String,
+    /// Native thread ID. Without --out, write its stream to stdout.
+    #[arg(long, visible_alias = "session", conflicts_with = "all", value_parser = ThreadId::from_string)]
+    pub thread: Option<ThreadId>,
+    /// Include active and archived threads.
+    #[arg(long)]
+    pub all: bool,
+    /// New bundle directory; required when exporting more than one thread.
+    #[arg(long, visible_alias = "output")]
+    pub out: Option<PathBuf>,
+    /// Read a different Codex home, without loading or modifying its configuration.
+    #[arg(long)]
+    pub codex_home: Option<PathBuf>,
+    /// Directory containing the state database, when separate from Codex home.
+    #[arg(long)]
+    pub sqlite_home: Option<PathBuf>,
+    /// Maximum decoded bytes in one native line. Oversized lines fail explicitly.
+    #[arg(long, default_value_t = 67_108_864)]
+    pub max_line_bytes: usize,
+}
+
+impl SessionsCommand {
+    pub async fn run(self) -> anyhow::Result<()> {
+        match self.command {
+            SessionCommand::Export(args) => {
+                if args.thread.is_none() && args.out.is_none() {
+                    bail!("use --thread for stdout, or --out for a bundle");
+                }
+                let home = match &args.codex_home {
+                    Some(home) => home.clone(),
+                    None => codex_utils_home_dir::find_codex_home()?.into_path_buf(),
+                };
+                let state =
+                    state::Snapshot::read(args.sqlite_home.as_ref().unwrap_or(&home)).await?;
+                let stats =
+                    tokio::task::spawn_blocking(move || export::run(&home, &args, state)).await??;
+                eprintln!("{}", serde_json::to_string(&stats)?);
+                if stats.unavailable_sources > 0 {
+                    bail!(
+                        "some source files were unavailable; the archive inventory lists failures"
+                    );
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/codex-rs/session-export/src/mapping/events.rs b/codex-rs/session-export/src/mapping/events.rs
new file mode 100644
index 0000000000..1617a1d276
--- /dev/null
+++ b/codex-rs/session-export/src/mapping/events.rs
@@ -0,0 +1,171 @@
+use super::*;
+
+impl Mapper {
+    pub(super) fn event(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        match p["type"].as_str().unwrap_or_default() {
+            "thread_settings_applied" => self.config(base, &p["thread_settings"], false)?,
+            "token_count" if p["info"]["total_token_usage"].is_object() => {
+                let mut r = record(base, "session_info");
+                r["usage"] = usage_values(&p["info"]["total_token_usage"]);
+                meta(&mut r, "tokenCount", p.clone());
+                self.emit(r)?;
+            }
+            "item_completed" => {
+                let item = &p["item"];
+                match item["type"].as_str() {
+                    Some(
+                        "CommandExecution"
+                        | "McpToolCall"
+                        | "DynamicToolCall"
+                        | "FileChange"
+                        | "CollabAgentToolCall",
+                    ) => self.execution(base, item)?,
+                    Some("FunctionCallOutput") => {
+                        let mut output = item.clone();
+                        output["call_id"] = item["id"].clone();
+                        output["type"] = "function_call_output".into();
+                        self.response(base, &output, &Value::Null)?;
+                    }
+                    // Display events cannot establish model-facing content, nor
+                    // a duplicate model message merely by nearby equal text.
+                    _ => self.audit(base, "item_completed", p)?,
+                }
+            }
+            "exec_command_end" => {
+                let mut item = p.clone();
+                item["type"] = "CommandExecution".into();
+                item["id"] = p["call_id"].clone();
+                self.execution(base, &item)?;
+            }
+            "patch_apply_end" => {
+                let mut item = p.clone();
+                item["type"] = "FileChange".into();
+                item["id"] = p["call_id"].clone();
+                // success is the patch tool's explicit outcome, not an inference
+                // from an exit code or a prose success message.
+                if status(&item["status"]).is_none() && p["success"].is_boolean() {
+                    item["status"] = if p["success"] == true {
+                        "completed"
+                    } else {
+                        "failed"
+                    }
+                    .into();
+                }
+                self.execution(base, &item)?;
+            }
+            "mcp_tool_call_end" => {
+                let mut item = p.clone();
+                item["type"] = "McpToolCall".into();
+                item["id"] = p["call_id"].clone();
+                for k in ["server", "tool", "arguments"] {
+                    copy(&mut item, k, &p["invocation"], k);
+                }
+                if p["result"]["Err"].is_string() {
+                    item["error"] = p["result"]["Err"].clone();
+                    item["status"] = "failed".into();
+                }
+                if p["result"]["Ok"].is_object() {
+                    item["status"] = if p["result"]["Ok"]["isError"] == true {
+                        "failed"
+                    } else {
+                        "completed"
+                    }
+                    .into();
+                }
+                self.execution(base, &item)?;
+            }
+            "patch_apply_begin" => {
+                if p["auto_approved"] == true {
+                    self.auto_approval(base, &p["call_id"])?;
+                }
+                self.audit(base, "patch_apply_begin", p)?;
+            }
+            "codex.tool_decision" | "tool_decision" => self.approval(base, p)?,
+            "task_complete" | "turn_complete" | "turn_aborted" => {
+                self.audit(base, "event_msg", p)?;
+                self.current_turn = None;
+            }
+            _ => self.audit(base, "event_msg", p)?,
+        }
+        Ok(())
+    }
+
+    pub(super) fn config(&mut self, base: &Value, p: &Value, turn: bool) -> anyhow::Result<()> {
+        if turn && let Some(id) = base["turnId"].as_str() {
+            self.configs.insert(id.to_owned(), p.clone());
+        }
+        self.audit(base, "settings", p)
+    }
+
+    pub(super) fn usage(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        if let Some(response) = p["response_id"].as_str()
+            && self.index.inference_last.get(response) == Some(&self.position)
+        {
+            let config = p["turn_id"].as_str().and_then(|t| self.configs.get(t));
+            let mut r = record(base, "inference");
+            self.native_id(&mut r, &p["response_id"]);
+            meta(&mut r, "responseId", json!(response));
+            if let Some(model) = config
+                .and_then(|c| c["model"].as_str())
+                .filter(|m| !m.is_empty())
+            {
+                r["model"] = json!({"requested":model});
+                if let Some(provider) = self.meta["model_provider"].as_str() {
+                    r["model"]["provider"] = provider.into();
+                }
+            }
+            let settings = model_settings(config.unwrap_or(&Value::Null), "effort");
+            if settings.as_object().is_some_and(|o| !o.is_empty()) {
+                r["settings"] = settings;
+            }
+            if p["usage"].is_object() {
+                r["usage"] = usage_values(&p["usage"]);
+            }
+            meta(&mut r, "usageRecord", p.clone());
+            self.emit(r)?;
+        }
+        if p["thread_token_usage"].is_object() {
+            let mut r = record(base, "session_info");
+            r["usage"] = usage_values(&p["thread_token_usage"]);
+            self.emit(r)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn auto_approval(&mut self, base: &Value, call: &Value) -> anyhow::Result<()> {
+        self.audit(
+            base,
+            "automatic_approval",
+            &json!({"call_id":call, "auto_approved":true}),
+        )
+    }
+
+    pub(super) fn approval(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        self.audit(base, "approval", p)
+    }
+}
+
+fn model_settings(p: &Value, effort: &str) -> Value {
+    let mut settings = json!({});
+    for (src, dst) in [(effort, "reasoningEffort"), ("service_tier", "serviceTier")] {
+        if let Some(s) = p[src].as_str() {
+            settings[dst] = s.into();
+        }
+    }
+    settings
+}
+pub(super) fn usage_values(p: &Value) -> Value {
+    let mut r = json!({});
+    for (src, dst) in [
+        ("input_tokens", "inputTokens"),
+        ("cached_input_tokens", "cacheReadTokens"),
+        ("cache_write_input_tokens", "cacheWriteTokens"),
+        ("output_tokens", "outputTokens"),
+        ("reasoning_output_tokens", "reasoningTokens"),
+    ] {
+        if let Some(n) = p[src].as_u64() {
+            r[dst] = n.into();
+        }
+    }
+    r
+}
diff --git a/codex-rs/session-export/src/mapping/mod.rs b/codex-rs/session-export/src/mapping/mod.rs
new file mode 100644
index 0000000000..9d0cd74d52
--- /dev/null
+++ b/codex-rs/session-export/src/mapping/mod.rs
@@ -0,0 +1,308 @@
+//! Map saved facts, without using deserializer defaults as historical evidence.
+mod events;
+mod responses;
+mod structure;
+mod tools;
+
+use crate::content::*;
+use crate::source::{Index, Segment};
+use crate::stream::Stream;
+use codex_rollout::RolloutItem;
+use serde_json::{Value, json};
+use std::collections::{BTreeSet, HashMap, HashSet};
+
+pub(crate) struct Mapper {
+    pub stream: Stream,
+    pub index: Index,
+    pub meta: Value,
+    pub position: u64,
+    pub native_lines: u64,
+    pub fallbacks: u64,
+    pub gaps: u64,
+    pub missing: BTreeSet<String>,
+    pub current_turn: Option<String>,
+    pub configs: HashMap<String, Value>,
+    pub copied_last: Option<String>,
+    copying: bool,
+    copy_prefix_open: bool,
+    pub rollouts: std::sync::Arc<HashMap<String, String>>,
+    pub emitted_calls: HashSet<String>,
+    pub message_ids: HashMap<String, String>,
+    pub call_inputs: HashMap<String, Value>,
+    header_id: String,
+}
+
+impl Mapper {
+    pub fn new(
+        mut meta: Value,
+        index: Index,
+        _initial_segment: String,
+        rollouts: std::sync::Arc<HashMap<String, String>>,
+        _codex_home: String,
+    ) -> anyhow::Result<Self> {
+        let mut header_id = "header".to_owned();
+        let mut header_suffix = 0u64;
+        while index.record_ids.contains_key(&header_id) {
+            header_suffix += 1;
+            header_id = format!("header:{header_suffix}");
+        }
+        let mut reserved: HashSet<_> = index.record_ids.keys().cloned().collect();
+        reserved.insert(header_id.clone());
+        let mut missing: BTreeSet<String> = [
+            "approvals",
+            "model",
+            "cost",
+            "tool_definitions",
+            "commits",
+            "subagents",
+            "message_authorship",
+            "message_person",
+            "inference_item_links",
+            "hook_runs",
+            "terminal_lifecycle",
+            "transient_events",
+            "unlinked_stores",
+            "native_event_normalization",
+            "inference_update_history",
+            "call_requester",
+            "triggers",
+            "result_update_history",
+            "attachment_bytes",
+        ]
+        .into_iter()
+        .map(str::to_owned)
+        .collect();
+        if stringify_wide_numbers(&mut meta) {
+            missing.insert("numeric_counts".into());
+        }
+        Ok(Self {
+            stream: Stream::new(reserved)?,
+            index,
+            meta,
+            position: 0,
+            native_lines: 0,
+            fallbacks: 0,
+            gaps: 0,
+            missing,
+            current_turn: None,
+            configs: HashMap::new(),
+            copied_last: None,
+            copying: false,
+            copy_prefix_open: true,
+            rollouts,
+            emitted_calls: HashSet::new(),
+            message_ids: HashMap::new(),
+            call_inputs: HashMap::new(),
+            header_id,
+        })
+    }
+
+    pub fn line(&mut self, segment: &Segment, mut line: Value) -> anyhow::Result<()> {
+        self.position += 1;
+        self.native_lines += 1;
+        self.stream.position(self.position);
+        // Exhaustive dispatch makes new persistence variants a compile-time review.
+        let kind = match codex_rollout::decode_rollout_line(line.clone()) {
+            Ok(typed) => match typed.item {
+                RolloutItem::SessionMeta(_) => "session_meta",
+                RolloutItem::ResponseItem(_) => "response_item",
+                RolloutItem::InterAgentCommunication(_) => "inter_agent_communication",
+                RolloutItem::InterAgentCommunicationMetadata { .. } => {
+                    "inter_agent_communication_metadata"
+                }
+                RolloutItem::Compacted(_) => "compacted",
+                RolloutItem::TurnContext(_) => "turn_context",
+                RolloutItem::TokenUsageRecord(_) => "token_usage_record",
+                RolloutItem::WorldState(_) => "world_state",
+                RolloutItem::RetainedContext(_) => "retained_context",
+                RolloutItem::SecurityRiskScore(_) => "security_risk_score",
+                RolloutItem::EventMsg(_) => "event_msg",
+                RolloutItem::RealtimeItem(_) => "realtime_item",
+            }
+            .to_owned(),
+            Err(_) => {
+                self.fallbacks += 1;
+                line["type"].as_str().unwrap_or("_gap").to_owned()
+            }
+        };
+        if stringify_wide_numbers(&mut line) {
+            self.missing.insert("numeric_counts".into());
+        }
+        let mut base = json!({});
+        if let Some(ts) = timestamp(&line["timestamp"]) {
+            base["ts"] = ts.into();
+        } else if kind != "_blank" {
+            self.missing.insert("timestamps".into());
+        }
+        let p = &line["payload"];
+        if matches!(kind.as_str(), "turn_context" | "event_msg")
+            && (kind == "turn_context"
+                || matches!(p["type"].as_str(), Some("task_started" | "turn_started")))
+        {
+            // A new context without an ID must not inherit the previous turn's settings.
+            self.current_turn = p["turn_id"]
+                .as_str()
+                .filter(|s| !s.is_empty())
+                .map(str::to_owned);
+        }
+        let turn = p["turn_id"]
+            .as_str()
+            .or(p["turnId"].as_str())
+            .or(p["internal_chat_message_metadata_passthrough"]["turn_id"].as_str())
+            .filter(|s| !s.is_empty())
+            .map(str::to_owned)
+            .or_else(|| self.current_turn.clone());
+        if let Some(turn) = turn {
+            base["turnId"] = turn.into();
+        }
+        let mut pos = json!({"rolloutId":segment.rollout_id,"line":self.position});
+        copy(&mut pos, "ordinal", &line, "ordinal");
+        meta(&mut base, "sourcePosition", pos);
+        self.copying = line["ordinal"]
+            .as_u64()
+            .zip(segment.meta["subagent_history_start_ordinal"].as_u64())
+            .is_some_and(|(a, b)| a < b)
+            && kind != "session_meta";
+        if !clean_secrets(&mut line, &self.index.secrets).is_empty() {
+            base["truncated"] = true.into();
+            self.missing.insert("secrets".into());
+        }
+        let losses = strip_private(&mut line);
+        if losses.0 {
+            base["truncated"] = true.into();
+            self.missing.insert("secrets".into());
+        }
+        if losses.1 {
+            self.missing.insert("reasoning".into());
+        }
+        let p = &line["payload"];
+        match kind.as_str() {
+            "session_meta" => self.session_meta(&base, p)?,
+            "response_item" => self.response(&base, p, &line["metadata"])?,
+            "event_msg" => self.event(&base, p)?,
+            "turn_context" => self.config(&base, p, true)?,
+            "token_usage_record" => self.usage(&base, p)?,
+            "compacted" => self.compaction(&base, p)?,
+            "world_state" => self.world(&base, p)?,
+            "inter_agent_communication" => self.agent_message(&base, p)?,
+            "codex.tool_decision" => self.approval(&base, p)?,
+            "_gap" | "_blank" => {
+                self.gaps += 1;
+                self.missing.insert("history".into());
+                let mut r = record(&base, "gap");
+                r["reason"] = "unparseable".into();
+                r["count"] = 1.into();
+                meta(
+                    &mut r,
+                    "sourceFailure",
+                    line.get("reason").cloned().unwrap_or(json!("blank_line")),
+                );
+                self.emit(r)?;
+            }
+            _ => self.audit(&base, &kind, p)?,
+        }
+        self.copying = false;
+        Ok(())
+    }
+
+    pub fn emit(&mut self, mut r: Value) -> anyhow::Result<String> {
+        if self.copying {
+            if let Some(parent) =
+                self.meta["source"]["subagent"]["thread_spawn"]["parent_thread_id"]
+                    .as_str()
+                    .or(self.meta["parent_thread_id"].as_str())
+                    .or(self.meta["forked_from_id"].as_str())
+            {
+                r["copiedFrom"] = json!({"session":session_ref(parent)});
+            } else {
+                self.missing.insert("copies".into());
+            }
+        } else {
+            self.copy_prefix_open = false;
+        }
+        if !clean_secrets(&mut r, &self.index.secrets).is_empty() {
+            r["truncated"] = true.into();
+            self.missing.insert("secrets".into());
+        }
+        let losses = strip_private(&mut r);
+        if losses.0 {
+            r["truncated"] = true.into();
+            self.missing.insert("secrets".into());
+        }
+        if losses.1 {
+            self.missing.insert("reasoning".into());
+        }
+        stringify_wide_numbers(&mut r);
+        let id = self.stream.emit(r)?;
+        if self.copying && self.copy_prefix_open {
+            self.copied_last = Some(id.clone());
+        }
+        Ok(id)
+    }
+
+    fn native_id(&self, r: &mut Value, id: &Value) {
+        if let Some(id) = id.as_str().filter(|s| valid_id(s)) {
+            if self.index.record_ids.get(id) == Some(&1) {
+                r["id"] = id.into();
+            } else {
+                meta(r, "nativeId", json!(id));
+            }
+        }
+    }
+
+    pub fn audit(&mut self, base: &Value, kind: &str, p: &Value) -> anyhow::Result<()> {
+        let mut r = record(base, "com.openai.codex/event");
+        meta(&mut r, "event", json!({"type":kind,"payload":p}));
+        self.emit(r)?;
+        Ok(())
+    }
+
+    pub fn path(&self, path: &str) -> String {
+        let path = normalize_path(path);
+        if absolute(&path) {
+            return path;
+        }
+        if let Some(cwd) = self.meta["cwd"].as_str() {
+            let cwd = normalize_path(cwd);
+            if absolute(&cwd) {
+                return format!("{}/{}", cwd.trim_end_matches('/'), path);
+            }
+        }
+        path
+    }
+}
+
+fn record(base: &Value, kind: &str) -> Value {
+    let mut r = base.clone();
+    r["type"] = kind.into();
+    r
+}
+fn valid_id(id: &str) -> bool {
+    !id.is_empty() && id.chars().count() <= 256 && !id.chars().any(char::is_control)
+}
+fn absolute(path: &str) -> bool {
+    path.starts_with('/') || path.as_bytes().get(1) == Some(&b':')
+}
+fn normalize_path(path: &str) -> String {
+    codex_utils_path_uri::PathUri::parse(path)
+        .map(|u| u.inferred_native_path_string())
+        .unwrap_or_else(|_| path.to_owned())
+        .replace('\\', "/")
+}
+fn duration(p: &Value) -> Option<f64> {
+    p.as_f64()
+        .or_else(|| {
+            Some(p["secs"].as_f64()? * 1000.0 + p["nanos"].as_f64().unwrap_or(0.0) / 1_000_000.0)
+        })
+        .filter(|n| n.is_finite() && *n >= 0.0 && *n <= 9_007_199_254_740_991.0)
+}
+fn status(p: &Value) -> Option<&'static str> {
+    match p.as_str() {
+        Some("completed" | "success") => Some("completed"),
+        Some("failed") => Some("failed"),
+        Some("declined" | "denied") => Some("denied"),
+        Some("cancelled") => Some("cancelled"),
+        Some("interrupted") => Some("interrupted"),
+        _ => None,
+    }
+}
diff --git a/codex-rs/session-export/src/mapping/responses.rs b/codex-rs/session-export/src/mapping/responses.rs
new file mode 100644
index 0000000000..00ea04e47d
--- /dev/null
+++ b/codex-rs/session-export/src/mapping/responses.rs
@@ -0,0 +1,179 @@
+use super::*;
+
+impl Mapper {
+    pub(super) fn response(
+        &mut self,
+        base: &Value,
+        p: &Value,
+        metadata: &Value,
+    ) -> anyhow::Result<()> {
+        match p["type"].as_str().unwrap_or_default() {
+            "message" | "reasoning" => {
+                let mut r = record(base, "message");
+                self.native_id(&mut r, &p["id"]);
+                if p["type"] == "reasoning" {
+                    r["role"] = "assistant".into();
+                    r["author"] = "model".into();
+                    let summaries: Vec<Value> = p["summary"].as_array().into_iter().flatten()
+                        .chain(p["content"].as_array().into_iter().flatten())
+                        .filter_map(|v| v["text"].as_str())
+                        .filter(|text| !text.is_empty())
+                        .map(Value::from).collect();
+                    let part = if !summaries.is_empty() {
+                        json!({"type":"reasoning", "visibility":"summary", "summary":summaries})
+                    } else {
+                        self.missing.insert("reasoning".into());
+                        json!({"type":"reasoning", "visibility": if p["_asr_encrypted_content"] == true {"encrypted"} else {"omitted"}})
+                    };
+                    r["content"] = json!([part]);
+                } else {
+                    let Some(role) = p["role"].as_str() else {
+                        return self.audit(base, "message_without_role", p);
+                    };
+                    r["role"] = role.into();
+                    if role == "assistant" {
+                        r["author"] = "model".into();
+                    }
+                    if matches!(role, "system" | "developer") {
+                        r["origin"] = "instructions".into();
+                    }
+                    r["content"] = parts(
+                        &p["content"],
+                        &p["internal_chat_message_metadata_passthrough"],
+                    )
+                    .into();
+                    if let Some(phase) = p["phase"].as_str() {
+                        r["phase"] = match phase {
+                            "final_answer" => "final",
+                            other => other,
+                        }
+                        .into();
+                    }
+                    if let Some(s) = p["status"].as_str()
+                        && let Some(s) = match s {
+                            "completed" => Some("complete"),
+                            "incomplete" => Some("interrupted"),
+                            "failed" => Some("error"),
+                            _ => None,
+                        }
+                    {
+                        r["status"] = s.into();
+                    }
+                }
+                if metadata["retained_source"]["complete"] == false {
+                    r["truncated"] = true.into();
+                }
+                if let Some(original) = metadata["retained_source"]["id"]["message_id"].as_str()
+                    && let Some(id) = self.message_ids.get(original)
+                {
+                    r["copiedFrom"] = json!({"record":id});
+                }
+                meta(&mut r, "responseMetadata", metadata.clone());
+                let mut native = p.clone();
+                if let Some(o) = native.as_object_mut() {
+                    o.remove("content");
+                    o.remove("summary");
+                }
+                meta(&mut r, "response", native);
+                let id = self.emit(r)?;
+                if let Some(native) = p["id"].as_str() {
+                    self.message_ids.insert(native.to_owned(), id);
+                }
+            }
+            "function_call"
+            | "custom_tool_call"
+            | "local_shell_call"
+            | "web_search_call"
+            | "image_generation_call"
+            | "tool_search_call" => self.model_call(base, p)?,
+            "function_call_output" | "custom_tool_call_output" | "tool_search_output" => {
+                let mut r = record(base, "tool_result");
+                r["status"] = "unknown".into();
+                copy(&mut r, "callId", p, "call_id");
+                if p["call_id"]
+                    .as_str()
+                    .is_some_and(|c| self.index.secret_calls.contains(c))
+                {
+                    r["truncated"] = true.into();
+                    self.missing.insert("secrets".into());
+                } else if p["output"].is_string() || p["output"].is_array() {
+                    r["content"] = parts(&p["output"], &Value::Null).into();
+                } else if p.get("output").is_some() {
+                    meta(&mut r, "nativeOutput", p["output"].clone());
+                    self.missing.insert("tool_output".into());
+                }
+                if metadata["retained_source"]["complete"] == false {
+                    r["truncated"] = true.into();
+                }
+                meta(&mut r, "responseMetadata", metadata.clone());
+                if p["tools"].is_array() {
+                    meta(&mut r, "toolSearchOutput", p["tools"].clone());
+                }
+                self.result(r)?;
+            }
+            "additional_tools" => {
+                let mut base = base.clone();
+                self.native_id(&mut base, &p["id"]);
+                self.tools(&base, &p["tools"])?;
+            }
+            "compaction" | "compaction_summary" | "context_compaction" => {
+                self.compaction(base, p)?
+            }
+            "agent_message" => self.agent_message(base, p)?,
+            _ => self.audit(base, "response_item", p)?,
+        }
+        Ok(())
+    }
+
+    pub(super) fn agent_message(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        // Actor paths name addresses within a spawn tree, not native session IDs.
+        // The rollout item has no message role or established sender-thread join.
+        self.missing
+            .insert("inter_agent_message_normalization".into());
+        self.audit(base, "inter_agent_communication", p)
+    }
+
+    pub(super) fn result(&mut self, mut r: Value) -> anyhow::Result<()> {
+        let Some(call) = r["callId"].as_str().map(str::to_owned) else {
+            self.emit(r)?;
+            return Ok(());
+        };
+        if let Some(mut old) = self.stream.take_result(&call)? {
+            // An absent completion time must not retain an earlier update's time.
+            if let Some(fields) = old.as_object_mut() {
+                fields.remove("ts");
+            }
+            // Fold at the last recorded update. Content always comes from model
+            // output; display completion supplies status/exec, never content.
+            for (k, v) in r.as_object().into_iter().flatten() {
+                if k == "status" && v == "unknown" && old["status"] != "unknown" {
+                    continue;
+                }
+                if k == "_meta" {
+                    if let Some(v) = v["com.openai.codex"].as_object() {
+                        for (key, value) in v {
+                            meta(&mut old, key, value.clone());
+                        }
+                    }
+                } else {
+                    old[k] = v.clone();
+                }
+            }
+            r = old;
+        }
+        if self
+            .index
+            .result_last
+            .get(&call)
+            .is_none_or(|p| *p == self.position)
+        {
+            if r["_meta"]["com.openai.codex"]["approvalSnapshot"]["auto_approved"] == true {
+                self.auto_approval(&json!({}), &json!(call))?;
+            }
+            self.emit(r)?;
+        } else {
+            self.stream.save_result(&call, &r)?;
+        }
+        Ok(())
+    }
+}
diff --git a/codex-rs/session-export/src/mapping/structure.rs b/codex-rs/session-export/src/mapping/structure.rs
new file mode 100644
index 0000000000..a3aedb10c8
--- /dev/null
+++ b/codex-rs/session-export/src/mapping/structure.rs
@@ -0,0 +1,185 @@
+use super::*;
+
+impl Mapper {
+    pub fn header(&self) -> Value {
+        let p = &self.meta;
+        let mut missing = self.missing.clone();
+        missing.insert("agent_settings".into());
+        if self.index.inference_last.is_empty() {
+            missing.insert("usage".into());
+        }
+        if self.index.execution_calls.is_empty() {
+            missing.insert("exit_codes".into());
+        }
+        missing.insert("file_changes".into()); // edits outside structured patch events are not normalized
+        let mut h = json!({"type":"session","id":self.header_id,"formatVersion":"0.1",
+            "sessionId":p["id"],"agent":{"name":"codex"},
+            "producer":{"name":"codex","version":env!("CARGO_PKG_VERSION"),"method":"native","source":"codex-rollout"},
+            "extensions":["com.openai.codex"]});
+        copy(&mut h["agent"], "version", p, "cli_version");
+        if let Some(ts) = timestamp(&p["timestamp"]) {
+            h["startedAt"] = ts.into();
+        }
+        if let Some(cwd) = p["cwd"]
+            .as_str()
+            .map(normalize_path)
+            .filter(|s| absolute(s))
+        {
+            h["cwd"] = cwd.clone().into();
+            if p["git"].is_object() {
+                let mut repo = json!({"path":cwd});
+                copy(&mut repo, "branch", &p["git"], "branch");
+                if let Some(head) = p["git"]["commit_hash"].as_str().filter(|s| full_commit(s)) {
+                    repo["head"] = head.into();
+                }
+                if let Some(remote) = p["git"]["repository_url"].as_str() {
+                    repo["remote"] = safe_remote(remote).into();
+                }
+                h["repos"] = json!([repo]);
+            }
+        }
+        if let Some(user) = p["creator_user_id"].as_str().filter(|s| !s.is_empty()) {
+            h["user"] = json!({"id":user,"source":"agent_account"});
+        }
+        let sub = &p["source"]["subagent"]["thread_spawn"];
+        if let Some(parent) = sub["parent_thread_id"]
+            .as_str()
+            .or(p["parent_thread_id"].as_str())
+        {
+            h["parent"] = json!({"session":session_ref(parent),"kind":"subagent"});
+            if let Some(role) = p["agent_role"].as_str().or(sub["agent_role"].as_str()) {
+                h["parent"]["role"] = role.into();
+            }
+        } else if let Some(parent) = p["forked_from_id"].as_str() {
+            h["parent"] = json!({"session":session_ref(parent),"kind":"fork"});
+        } else if let Some(base) = p["history_base"]["thread_id"].as_str()
+            && let Some(parent) = self
+                .rollouts
+                .get(base)
+                .filter(|id| Some(id.as_str()) != p["id"].as_str())
+        {
+            h["parent"] = json!({"session":session_ref(parent),"kind":"continues"});
+        }
+        if h["parent"].is_object()
+            && let Some(last) = &self.copied_last
+        {
+            h["parent"]["copiedThrough"] = last.clone().into();
+        }
+        // Older logs and referenced forks do not establish a local copied boundary.
+        if self.copied_last.is_none() || p.get("_asrIdentityRecovery").is_some() {
+            missing.insert("copies".into());
+        }
+        let mut native = p.clone();
+        if let Some(m) = native.as_object_mut() {
+            m.remove("base_instructions");
+            m.remove("dynamic_tools");
+        }
+        if let Some(remote) = native["git"]["repository_url"].as_str().map(str::to_owned) {
+            let safe = safe_remote(&remote);
+            if safe != remote {
+                missing.insert("secrets".into());
+                h["truncated"] = true.into();
+            }
+            native["git"]["repository_url"] = safe.into();
+        }
+        let losses = strip_private(&mut native);
+        if losses.0 || !clean_secrets(&mut native, &self.index.secrets).is_empty() {
+            missing.insert("secrets".into());
+            h["truncated"] = true.into();
+        }
+        if losses.1 {
+            missing.insert("reasoning".into());
+        }
+        if p.get("_asrIdentityRecovery").is_some() {
+            missing.insert("session_metadata".into());
+        }
+        meta(&mut h, "sessionMeta", native);
+        h["missing"] = json!(missing);
+        h
+    }
+
+    pub(super) fn session_meta(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        if p["id"] != self.meta["id"] {
+            return self.audit(base, "inherited_session_meta", p);
+        }
+        if let Some(instructions) = p["base_instructions"]["text"].as_str() {
+            let mut r = record(base, "message");
+            r["role"] = "system".into();
+            r["origin"] = "instructions".into();
+            r["content"] = json!([text(instructions)]);
+            self.emit(r)?;
+        }
+        if p["dynamic_tools"].is_array() {
+            self.tools(base, &p["dynamic_tools"])?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn compaction(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        if let Some(summary) = p["message"].as_str() {
+            let mut r = record(base, "message");
+            r["role"] = "user".into();
+            r["author"] = "harness".into();
+            r["origin"] = "compaction".into();
+            r["content"] = json!([text(summary)]);
+            self.native_id(&mut r, &p["id"]);
+            meta(&mut r, "compaction", p.clone());
+            self.emit(r)?;
+        } else {
+            self.audit(base, "compaction", p)?;
+        }
+        // A replacement changes the model's context, but does not itself delete
+        // the durable rollout. Only an explicit saved loss warrants a gap here.
+        if p["history_lost"] == true {
+            let mut r = record(base, "gap");
+            r["reason"] = "not_retained".into();
+            self.missing.insert("history".into());
+            self.gaps += 1;
+            self.emit(r)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn world(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        self.audit(base, "world_state", p)?;
+        if p["full"] == true {
+            for (key, field) in [
+                ("agents_md", "text"),
+                ("host_skills", "body"),
+                ("permissions", "instructions"),
+                ("collaboration_mode", "instructions"),
+            ] {
+                if let Some(s) = p["state"][key][field].as_str() {
+                    let mut r = record(base, "message");
+                    r["role"] = "developer".into();
+                    r["author"] = "harness".into();
+                    r["origin"] = "instructions".into();
+                    r["content"] = json!([text(s)]);
+                    self.emit(r)?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn tools(&mut self, base: &Value, definitions: &Value) -> anyhow::Result<()> {
+        self.audit(base, "tool_definitions", definitions)
+    }
+}
+
+fn full_commit(s: &str) -> bool {
+    matches!(s.len(), 40 | 64)
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn safe_remote(s: &str) -> String {
+    if let Some((scheme, rest)) = s.split_once("://") {
+        let (host, path) = rest.split_once('/').unwrap_or((rest, ""));
+        let host = host.rsplit_once('@').map_or(host, |(_, host)| host);
+        // Query and fragment components can contain bearer credentials.
+        let path = path.split(['?', '#']).next().unwrap_or_default();
+        format!("{scheme}://{host}/{path}")
+    } else {
+        s.to_owned()
+    }
+}
diff --git a/codex-rs/session-export/src/mapping/tools.rs b/codex-rs/session-export/src/mapping/tools.rs
new file mode 100644
index 0000000000..c9ace6b5c1
--- /dev/null
+++ b/codex-rs/session-export/src/mapping/tools.rs
@@ -0,0 +1,243 @@
+use super::*;
+use crate::source::arguments;
+
+impl Mapper {
+    pub(super) fn model_call(&mut self, base: &Value, p: &Value) -> anyhow::Result<()> {
+        let mut r = record(base, "tool_call");
+        self.native_id(&mut r, &p["id"]);
+        let call = p["call_id"]
+            .as_str()
+            .or(p["id"].as_str())
+            .map(str::to_owned)
+            .unwrap_or_else(|| format!("asr:call:{}", self.position));
+        r["callId"] = call.clone().into();
+        r["requestedBy"] = "model".into();
+        copy(&mut r, "name", p, "name");
+        if let Some(kind) = p["name"].as_str().and_then(tool_kind) {
+            r["kind"] = kind.into();
+        }
+        if p["type"] == "custom_tool_call" {
+            copy(&mut r, "inputText", p, "input");
+        } else if let Some(raw) = p["arguments"].as_str() {
+            match serde_json::from_str::<Value>(raw) {
+                Ok(v) => r["input"] = v,
+                Err(_) => r["inputText"] = raw.into(),
+            }
+        } else if let Some(v) = p.get("arguments").or(p.get("action")) {
+            r["input"] = v.clone();
+        }
+        let args = arguments(p);
+        if p["name"] == "spawn_agent" {
+            let mut sub = json!({});
+            copy(&mut sub, "role", &args, "agent_type");
+            copy(&mut sub, "description", &args, "message");
+            r["subagent"] = sub;
+        }
+        meta(&mut r, "call", p.clone());
+        stringify_wide_numbers(&mut r);
+        let mut input = json!({});
+        for key in ["input", "inputText"] {
+            if let Some(value) = r.get(key) {
+                input[key] = value.clone();
+            }
+        }
+        self.call_inputs.insert(call.clone(), input);
+        self.emit(r)?;
+        self.emitted_calls.insert(call.clone());
+        if p["name"] == "apply_patch"
+            && let Some(patch) = p["input"].as_str()
+        {
+            // Only file activity is decoded from the bespoke patch grammar. It
+            // is never mislabeled as a unified diff or as an applied edit.
+            let mut changes: Vec<Value> = Vec::new();
+            for line in patch.lines() {
+                let header = [
+                    ("*** Add File: ", "add"),
+                    ("*** Update File: ", "modify"),
+                    ("*** Delete File: ", "delete"),
+                ]
+                .into_iter()
+                .find_map(|(prefix, op)| line.strip_prefix(prefix).map(|p| (p, op)));
+                if let Some((path, op)) = header {
+                    changes.push(json!({"path":self.path(path),"op":op}));
+                } else if let Some(to) = line.strip_prefix("*** Move to: ")
+                    && let Some(change) = changes.last_mut()
+                {
+                    change["oldPath"] = change["path"].clone();
+                    change["path"] = self.path(to).into();
+                    change["op"] = "move".into();
+                }
+            }
+            for change in changes {
+                let mut r = record(base, "file_change");
+                for (k, v) in change.as_object().into_iter().flatten() {
+                    r[k] = v.clone();
+                }
+                r["callId"] = call.clone().into();
+                r["status"] = "proposed".into();
+                self.emit(r)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn execution(&mut self, base: &Value, item: &Value) -> anyhow::Result<()> {
+        let Some(call) = item["id"].as_str() else {
+            return self.audit(base, "execution_without_id", item);
+        };
+        let kind = item["type"].as_str().unwrap_or_default();
+        if !self.index.model_calls.contains(call) && self.emitted_calls.insert(call.to_owned()) {
+            let mut r = record(base, "tool_call");
+            self.native_id(&mut r, &item["id"]);
+            r["callId"] = call.into();
+            if item["source"] == "user_shell" {
+                r["requestedBy"] = "user".into();
+            } else if let Some(parent) = self.index.parents.get(call) {
+                r["requestedBy"] = "code".into();
+                r["parentCallId"] = parent.clone().into();
+            }
+            if kind == "CommandExecution" {
+                r["kind"] = "execute".into();
+                r["input"] = json!({"command":item["command"],"cwd":item["cwd"]});
+            }
+            if kind == "FileChange" {
+                r["kind"] = "edit".into();
+            }
+            if matches!(
+                kind,
+                "McpToolCall" | "DynamicToolCall" | "CollabAgentToolCall"
+            ) {
+                copy(&mut r, "name", item, "tool");
+                copy(&mut r, "input", item, "arguments");
+            }
+            meta(&mut r, "invocation", item.clone());
+            self.emit(r)?;
+        }
+        let mut r = record(base, "tool_result");
+        r["callId"] = call.into();
+        r["status"] = status(&item["status"]).unwrap_or("unknown").into();
+        if matches!(kind, "McpToolCall" | "DynamicToolCall")
+            && let Some(args) = item.get("arguments")
+            && self
+                .call_inputs
+                .get(call)
+                .is_some_and(|old| old.get("input") != Some(args) || !old["inputText"].is_null())
+        {
+            r["input"] = args.clone();
+        }
+        if kind == "FileChange" && item["auto_approved"] == true {
+            meta(&mut r, "approvalSnapshot", json!({"auto_approved":true}));
+        }
+        if let Some(ms) = duration(&item["duration"]) {
+            r["durationMs"] = json!(ms);
+        }
+        if kind == "CommandExecution" {
+            let mut exec = json!({});
+            for (src, dst) in [
+                ("command", "command"),
+                ("exit_code", "exitCode"),
+                ("stdout", "stdout"),
+                ("stderr", "stderr"),
+                ("aggregated_output", "output"),
+                ("signal", "signal"),
+            ] {
+                copy(&mut exec, dst, item, src);
+            }
+            if let Some(cwd) = item["cwd"]
+                .as_str()
+                .map(|s| self.path(s))
+                .filter(|s| absolute(s))
+            {
+                exec["cwd"] = cwd.into();
+            }
+            if item["aggregated_output"]
+                .as_str()
+                .is_some_and(|s| s.contains("\n... command output truncated for persistence ...\n"))
+            {
+                r["truncated"] = true.into();
+                self.missing.insert("tool_output".into());
+            }
+            r["exec"] = exec;
+        }
+        if let Some(error) = item.get("error").filter(|e| !e.is_null()) {
+            if error.is_string() {
+                r["error"] = json!({"message":error});
+            } else if error.is_object() {
+                let mut e = json!({});
+                copy(&mut e, "message", error, "message");
+                copy(&mut e, "code", error, "code");
+                r["error"] = e;
+            }
+        }
+        if kind == "CollabAgentToolCall"
+            && item["tool"] == "spawn_agent"
+            && let Some(ids) = item["receiver_thread_ids"].as_array()
+            && ids.len() == 1
+            && let Some(child) = ids[0].as_str()
+        {
+            r["subagent"] = json!({"session":session_ref(child)});
+        }
+        meta(&mut r, "execution", item.clone());
+        self.result(r)?;
+        if kind == "FileChange" {
+            self.files(base, call, item)?;
+        }
+        Ok(())
+    }
+
+    fn files(&mut self, base: &Value, call: &str, item: &Value) -> anyhow::Result<()> {
+        for (path, change) in item["changes"].as_object().into_iter().flatten() {
+            let mut r = record(base, "file_change");
+            r["path"] = self.path(path).into();
+            r["callId"] = call.into();
+            r["status"] = match status(&item["status"]) {
+                Some("completed") => "applied",
+                Some("failed" | "denied") => "failed",
+                _ => "unknown",
+            }
+            .into();
+            match change["type"].as_str() {
+                Some("add") => {
+                    r["op"] = "add".into();
+                    if let Some(s) = change["content"].as_str() {
+                        r["after"] = json!({"text":s});
+                    }
+                }
+                Some("delete") => {
+                    r["op"] = "delete".into();
+                    if let Some(s) = change["content"].as_str() {
+                        r["before"] = json!({"text":s});
+                    }
+                }
+                Some("update") => {
+                    r["op"] = "modify".into();
+                    if let Some(to) = change["move_path"].as_str() {
+                        r["oldPath"] = r["path"].clone();
+                        r["path"] = self.path(to).into();
+                        r["op"] = "move".into();
+                    }
+                    if let Some(patch) = change["unified_diff"].as_str() {
+                        r["patch"] = patch.into();
+                    }
+                }
+                _ => {
+                    r["op"] = "unknown".into();
+                    meta(&mut r, "fileChange", change.clone());
+                }
+            }
+            self.emit(r)?;
+        }
+        Ok(())
+    }
+}
+
+// Fixed name map; arguments and output text never determine tool kind.
+fn tool_kind(name: &str) -> Option<&'static str> {
+    match name {
+        "exec_command" | "write_stdin" | "exec" => Some("execute"),
+        "apply_patch" => Some("edit"),
+        "view_image" => Some("read"),
+        "tool_search_tool" | "search_contents" => Some("search"),
+        _ => None,
+    }
+}
