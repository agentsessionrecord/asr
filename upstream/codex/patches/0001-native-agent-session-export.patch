+//! Small driver for profiling the same command used by the full Codex CLI.
+use clap::Parser;
+
+#[derive(Parser)]
+struct Cli {
+    #[command(flatten)]
+    sessions: codex_session_export::SessionsCommand,
+}
+
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    Cli::parse().sessions.run().await
+}
diff --git a/codex-rs/session-export/src/content.rs b/codex-rs/session-export/src/content.rs
new file mode 100644
index 0000000000..2e750a012c
--- /dev/null
+++ b/codex-rs/session-export/src/content.rs
@@ -0,0 +1,270 @@
+use serde_json::Value;
+use serde_json::json;
+
+pub(crate) fn text(value: &str) -> Value {
+    json!({"type":"text","text":value})
+}
+
+pub(crate) fn parts(value: &Value, metadata: &Value) -> Vec<Value> {
+    if let Some(s) = value.as_str() {
+        return vec![text(s)];
+    }
+    value.as_array().into_iter().flatten().enumerate().map(|(i, p)| {
+        let mut part = match p["type"].as_str().unwrap_or_default() {
+            "input_text" | "output_text" | "text" | "Text" => {
+                let mut value = text(p["text"].as_str().unwrap_or_default());
+                let mut extra = p.clone();
+                if let Some(m) = extra.as_object_mut() {m.remove("text"); m.remove("type");}
+                if extra.as_object().is_some_and(|m| !m.is_empty()) { meta(&mut value, "content", extra); }
+                value
+            }
+            "input_image" | "image" if p["image_url"].is_string() => image_url(p["image_url"].as_str().unwrap_or_default()),
+            "local_image" | "local_audio" | "skill" | "mention" => json!({"type":"resource_link","uri":p["path"],"name":p["name"].as_str().unwrap_or(p["type"].as_str().unwrap_or("attachment"))}),
+            "encrypted_content" => json!({"type":"reasoning","visibility":"encrypted"}),
+            "refusal" => json!({"type":"refusal","text":p["refusal"].as_str().or(p["text"].as_str()).unwrap_or_default()}),
+            "image" | "audio" | "resource" | "resource_link" => p.clone(),
+            _ => json!({"type":"com.openai.codex/content","_meta":{"com.openai.codex":{"content":p}}}),
+        };
+        let kind = metadata["content_item_kinds"][i].as_str().unwrap_or_default();
+        let provenance = &metadata["content_item_metadata"][i]["provenance"];
+        let (author, origin) = match kind {
+            "user.text" | "user.image" | "user.audio" => (Some("human"), Some("prompt")),
+            "hooks.additional_context" => (Some("hook"),Some("injected")),
+            "multi_agent.subagent_notification" => (Some("agent"),Some("subagent_report")),
+            "multi_agent.inter_agent_message" | "multi_agent.inter_agent_completion_message" => (Some("agent"),Some("injected")),
+            "generic.developer_instructions" => (None,Some("injected")),
+            "memories.instructions" => (Some("harness"),Some("memory")),
+            "environments.environment_context" => (Some("harness"),Some("injected")),
+            s if s.ends_with(".instructions") => (Some("harness"),Some("instructions")),
+            _ => match provenance["type"].as_str() {
+                Some("user") => (Some("human"),Some("prompt")),
+                Some("harness") if provenance["hook"] == true => (Some("hook"),Some("injected")),
+                Some("harness" | "agents_md" | "skills") => (Some("harness"),Some("injected")),
+                Some("tool") => (Some("tool"),Some("injected")),
+                Some("developer_instructions") => (None,Some("injected")),
+                _ => (None,None),
+            }
+        };
+        if let Some(author) = author { part["author"] = author.into(); }
+        if let Some(origin) = origin { part["origin"] = origin.into(); }
+        if !kind.is_empty() { meta(&mut part,"contentKind",json!(kind)); }
+        if !provenance.is_null() { meta(&mut part,"provenance",provenance.clone()); }
+        part
+    }).collect()
+}
+
+pub(crate) fn image_url(url: &str) -> Value {
+    if let Some(data) = url.strip_prefix("data:")
+        && let Some((mime, data)) = data.split_once(";base64,")
+    {
+        return json!({"type":"image","mimeType":mime,"data":data});
+    }
+    json!({"type":"resource_link","uri":url,"name":"image"})
+}
+
+pub(crate) fn meta(record: &mut Value, name: &str, value: Value) {
+    if record.get("_meta").is_none() {
+        record["_meta"] = json!({});
+    }
+    if !record["_meta"]["com.openai.codex"].is_object() {
+        record["_meta"]["com.openai.codex"] = json!({});
+    }
+    record["_meta"]["com.openai.codex"][name] = value;
+}
+
+/// Exclude explicit credential fields and opaque provider state everywhere,
+/// including vendor data. Return (redacted secrets, omitted opaque state).
+pub(crate) fn strip_private(value: &mut Value) -> (bool, bool) {
+    let mut losses = (false, false);
+    match value {
+        Value::Object(o) => {
+            let encrypted = o.get("encrypted_content").is_some_and(|v| !v.is_null());
+            o.retain(|key, v| {
+                if matches!(
+                    key.as_str(),
+                    "encrypted_content" | "encrypted_function_args" | "signature"
+                ) {
+                    losses.1 |= !v.is_null();
+                    return false;
+                }
+                if matches!(
+                    key.to_ascii_lowercase().as_str(),
+                    "api_key"
+                        | "access_token"
+                        | "refresh_token"
+                        | "password"
+                        | "authorization"
+                        | "client_secret"
+                ) && v.is_string()
+                {
+                    losses.0 = true;
+                    return false;
+                }
+                true
+            });
+            if encrypted {
+                o.insert("_asr_encrypted_content".into(), true.into());
+            }
+            for child in o.values_mut() {
+                let nested = strip_private(child);
+                losses.0 |= nested.0;
+                losses.1 |= nested.1;
+            }
+        }
+        Value::Array(a) => {
+            for child in a {
+                let nested = strip_private(child);
+                losses.0 |= nested.0;
+                losses.1 |= nested.1;
+            }
+        }
+        Value::String(s) if matches!(s.trim_start().chars().next(), Some('{' | '[')) => {
+            // Encoded tool arguments are still records, not an escape hatch for
+            // known credential fields. Leave their exact bytes alone otherwise.
+            if let Ok(mut parsed) = serde_json::from_str::<Value>(s) {
+                losses = strip_private(&mut parsed);
+                if losses.0 || losses.1 {
+                    *s = parsed.to_string();
+                }
+            }
+        }
+        _ => {}
+    }
+    losses
+}
+
+pub(crate) fn collect_credentials(value: &Value, secrets: &mut Vec<String>) {
+    match value {
+        Value::Object(o) => {
+            for (key, child) in o {
+                if matches!(
+                    key.to_ascii_lowercase().as_str(),
+                    "api_key"
+                        | "access_token"
+                        | "refresh_token"
+                        | "password"
+                        | "authorization"
+                        | "client_secret"
+                ) && let Some(s) = child.as_str().filter(|s| !s.is_empty())
+                {
+                    secrets.push(s.to_owned());
+                }
+                collect_credentials(child, secrets);
+            }
+        }
+        Value::Array(a) => {
+            for child in a {
+                collect_credentials(child, secrets);
+            }
+        }
+        Value::String(s) if matches!(s.trim_start().chars().next(), Some('{' | '[')) => {
+            if let Ok(parsed) = serde_json::from_str::<Value>(s) {
+                collect_credentials(&parsed, secrets);
+            }
+        }
+        _ => {}
+    }
+}
+
+pub(crate) fn copy(record: &mut Value, dest: &str, source: &Value, key: &str) {
+    if let Some(value) = source.get(key).filter(|v| !v.is_null()) {
+        record[dest] = value.clone();
+    }
+}
+
+/// Preserve wide native values before a reader can round them through binary64.
+pub(crate) fn stringify_wide_numbers(value: &mut Value) -> bool {
+    match value {
+        Value::Number(n) if n.as_f64().is_none_or(|n| n.abs() > 9_007_199_254_740_991.0) => {
+            *value = Value::String(n.to_string());
+            true
+        }
+        Value::Array(values) => values
+            .iter_mut()
+            .fold(false, |changed, v| stringify_wide_numbers(v) | changed),
+        Value::Object(values) => values
+            .values_mut()
+            .fold(false, |changed, v| stringify_wide_numbers(v) | changed),
+        _ => false,
+    }
+}
+
+pub(crate) fn timestamp(value: &Value) -> Option<String> {
+    if let Some(s) = value.as_str() {
+        return chrono::DateTime::parse_from_rfc3339(s).ok().map(|t| {
+            t.with_timezone(&chrono::Utc)
+                .to_rfc3339_opts(chrono::SecondsFormat::AutoSi, true)
+        });
+    }
+    value
+        .as_i64()
+        .and_then(chrono::DateTime::from_timestamp_millis)
+        .map(|t| t.to_rfc3339_opts(chrono::SecondsFormat::Millis, true))
+}
+
+/// Scrub known secret answers, including copies inside JSON-encoded strings.
+/// This is deliberately not a general archive sharing or credential detector.
+pub(crate) fn clean_secrets(value: &mut Value, secrets: &[String]) -> Vec<String> {
+    let mut paths = Vec::new();
+    if !secrets.is_empty() {
+        scrub(value, secrets, "", &mut paths, 0);
+    }
+    paths
+}
+
+fn scrub(value: &mut Value, secrets: &[String], path: &str, paths: &mut Vec<String>, depth: usize) {
+    match value {
+        Value::String(s) => {
+            let before = s.clone();
+            if depth < 8
+                && matches!(s.trim_start().chars().next(), Some('{' | '['))
+                && let Ok(mut parsed) = serde_json::from_str::<Value>(s)
+            {
+                let mut nested = Vec::new();
+                scrub(&mut parsed, secrets, "", &mut nested, depth + 1);
+                if !nested.is_empty() {
+                    *s = parsed.to_string();
+                }
+            }
+            for secret in secrets {
+                if !secret.is_empty() {
+                    *s = s.replace(secret, "[REDACTED SECRET]");
+                }
+            }
+            if *s != before {
+                paths.push(path.to_owned());
+            }
+        }
+        Value::Array(a) => {
+            for (i, v) in a.iter_mut().enumerate() {
+                scrub(v, secrets, &format!("{path}/{i}"), paths, depth);
+            }
+        }
+        Value::Object(o) => {
+            for (k, v) in o {
+                scrub(
+                    v,
+                    secrets,
+                    &format!("{path}/{}", k.replace('~', "~0").replace('/', "~1")),
+                    paths,
+                    depth,
+                );
+            }
+        }
+        _ => {}
+    }
+}
+
+pub(crate) fn session_ref(id: &str) -> String {
+    let mut encoded = String::new();
+    for c in id.chars() {
+        if c.is_control() || matches!(c, ' ' | '%' | ':' | '#') {
+            for b in c.to_string().as_bytes() {
+                encoded.push_str(&format!("%{b:02X}"));
+            }
+        } else {
+            encoded.push(c);
+        }
+    }
+    format!("codex:{encoded}")
+}
diff --git a/codex-rs/session-export/src/export.rs b/codex-rs/session-export/src/export.rs
new file mode 100644
index 0000000000..1bd7aaf0af
--- /dev/null
+++ b/codex-rs/session-export/src/export.rs
@@ -0,0 +1,253 @@
+use std::collections::HashMap;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::time::Instant;
+
+use anyhow::Context;
+use anyhow::ensure;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+
+use crate::ExportArgs;
+use crate::content::*;
+use crate::mapping::Mapper;
+use crate::source;
+use crate::source::Index;
+use crate::source::Source;
+use crate::state::Snapshot;
+
+#[derive(Default, Serialize)]
+pub(crate) struct Stats {
+    pub threads: u64,
+    pub rollouts: u64,
+    pub native_lines: u64,
+    pub records: u64,
+    pub decoded_bytes: u64,
+    pub output_bytes: u64,
+    pub typed_fallbacks: u64,
+    pub gaps: u64,
+    pub recovered_headers: u64,
+    pub unavailable_sources: u64,
+    pub elapsed_seconds: f64,
+}
+
+pub(crate) fn run(home: &Path, args: &ExportArgs, mut state: Snapshot) -> anyhow::Result<Stats> {
+    let started = Instant::now();
+    ensure!(args.max_line_bytes > 0, "--max-line-bytes must be positive");
+    let inventory = source::inventory(home, args.max_line_bytes, &state.threads)?;
+    let rollouts: HashMap<_, _> = inventory
+        .segments
+        .iter()
+        .map(|s| (s.rollout_id.clone(), s.thread_id.clone()))
+        .collect();
+    let rollouts = std::sync::Arc::new(rollouts);
+    let mut groups = source::groups(inventory.segments)?;
+    if let Some(thread) = args.thread {
+        groups.retain(|id, _| id == &thread.to_string());
+        ensure!(!groups.is_empty(), "thread not found");
+    }
+    let mut output = None;
+    if let Some(path) = &args.out {
+        ensure!(
+            !path.exists(),
+            "output already exists; select a new directory"
+        );
+        let parent = path
+            .parent()
+            .filter(|p| !p.as_os_str().is_empty())
+            .unwrap_or(Path::new("."));
+        fs::create_dir_all(parent)?;
+        let mut builder = tempfile::Builder::new();
+        builder.prefix(".codex-asr-");
+        let mut sessions = fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            use std::os::unix::fs::PermissionsExt;
+            builder.permissions(fs::Permissions::from_mode(0o700));
+            sessions.mode(0o700);
+        }
+        let staging = builder.tempdir_in(parent)?;
+        sessions.create(staging.path().join("sessions"))?;
+        output = Some(staging);
+    }
+    let mut stats = Stats {
+        unavailable_sources: inventory.unavailable.len() as u64,
+        ..Stats::default()
+    };
+    let mut entries = Vec::new();
+    for (id, segments) in groups {
+        let mut readers = Vec::new();
+        let mut index = Index::default();
+        for segment in &segments {
+            stats.recovered_headers +=
+                u64::from(segment.meta.get("_asrIdentityRecovery").is_some());
+            let mut reader = Source::open(&segment.path, args.max_line_bytes)?;
+            stats.decoded_bytes += reader.bytes;
+            index.scan(&mut reader)?;
+            readers.push(reader);
+        }
+        for reader in &mut readers {
+            index.scan_secrets(reader)?;
+        }
+        let first = segments.first().context("empty segment group")?;
+        let mut meta = first.meta.clone();
+        clean_secrets(&mut meta, &index.secrets);
+        let mut mapper = Mapper::new(
+            meta,
+            index,
+            first.rollout_id.clone(),
+            rollouts.clone(),
+            home.to_string_lossy().into_owned(),
+        )?;
+        if segments.len() > 1 {
+            mapper.missing.insert("segment_order".into());
+        }
+        for (segment, reader) in segments.iter().zip(&mut readers) {
+            while let Some(line) = reader.next()? {
+                mapper.line(segment, line)?;
+            }
+        }
+        let mut row = state.threads.remove(&id);
+        if let Some(row) = &mut row {
+            clean_secrets(row, &mapper.index.secrets);
+        }
+        let annotations = annotations(
+            &mut mapper,
+            row.as_ref(),
+            state.rows.remove(&id).unwrap_or_default(),
+        )?;
+        if !state.available {
+            mapper.missing.insert("thread_metadata".into());
+        }
+        mapper.stream.finish()?;
+        let mut completed = tempfile::NamedTempFile::new()?;
+        serde_json::to_writer(&mut completed, &mapper.header())?;
+        completed.write_all(b"\n")?;
+        std::io::copy(&mut mapper.stream.file.reopen()?, &mut completed)?;
+        completed.flush()?;
+        let mut digest = Sha256::new();
+        std::io::copy(&mut completed.reopen()?, &mut digest)?;
+        let digest = format!("{:x}", digest.finalize());
+        let bytes = completed.as_file().metadata()?.len();
+        let records = mapper.stream.count + 1;
+        if let Some(output) = &output {
+            let storage = format!("{:x}", Sha256::digest(session_ref(&id).as_bytes()));
+            let relative = format!("sessions/{storage}.jsonl");
+            // Copy into a create-new file with private permissions, then publish
+            // the complete directory and manifest together.
+            let mut dest = private_file(&output.path().join(&relative))?;
+            std::io::copy(&mut completed.reopen()?, &mut dest)?;
+            dest.sync_all()?;
+            if !annotations.is_empty() {
+                let mut sidecar = private_file(
+                    &output
+                        .path()
+                        .join(format!("sessions/{storage}.annotations.jsonl")),
+                )?;
+                for annotation in &annotations {
+                    serde_json::to_writer(&mut sidecar, annotation)?;
+                    sidecar.write_all(b"\n")?;
+                }
+                sidecar.sync_all()?;
+            }
+            entries.push(json!({"agent":"codex","sessionId":id,"status":"present","path":relative,"digest":{"alg":"sha256","value":digest},"recordCount":records}));
+        } else {
+            std::io::copy(&mut completed.reopen()?, &mut std::io::stdout().lock())?;
+            if !annotations.is_empty() {
+                eprintln!("later metadata requires --out for annotation sidecars");
+            }
+        }
+        stats.threads += 1;
+        stats.rollouts += segments.len() as u64;
+        stats.native_lines += mapper.native_lines;
+        stats.records += records;
+        stats.output_bytes += bytes;
+        stats.typed_fallbacks += mapper.fallbacks;
+        stats.gaps += mapper.gaps;
+        if stats.threads.is_multiple_of(1000) {
+            eprintln!("exported {} threads", stats.threads);
+        }
+    }
+    if let Some(output) = output {
+        let manifest = json!({"formatVersion":"0.1","producer":{"name":"codex","version":env!("CARGO_PKG_VERSION")},"purpose":"archive","sessions":entries,"unavailableSources":inventory.unavailable});
+        let mut file = private_file(&output.path().join("bundle.json"))?;
+        serde_json::to_writer_pretty(&mut file, &manifest)?;
+        file.write_all(b"\n")?;
+        file.sync_all()?;
+        let target = args.out.as_ref().context("missing output path")?;
+        ensure!(!target.exists(), "output appeared during export");
+        fs::rename(output.path(), target)?;
+    }
+    stats.elapsed_seconds = started.elapsed().as_secs_f64();
+    Ok(stats)
+}
+
+fn private_file(path: &Path) -> anyhow::Result<fs::File> {
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    Ok(options.open(path)?)
+}
+
+// Mutable side stores establish facts at collection time, never earlier actions.
+// Their collection timestamp is valid for annotations, not for event timestamps.
+fn annotations(
+    mapper: &mut Mapper,
+    row: Option<&Value>,
+    rows: Vec<(String, Value)>,
+) -> anyhow::Result<Vec<Value>> {
+    let at = chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+    let session = session_ref(
+        mapper.meta["id"]
+            .as_str()
+            .context("missing thread identity")?,
+    );
+    let mut annotations = Vec::new();
+    let base = json!({"type":"annotation","session":session,"at":at,
+        "source":{"name":"codex","version":env!("CARGO_PKG_VERSION")}});
+    if let Some(row) = row {
+        if let Some(title) = row["name"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .or(row["title"].as_str())
+        {
+            let mut r = base.clone();
+            r["kind"] = "title".into();
+            r["data"] = json!({"title":title});
+            annotations.push(r);
+        }
+        mapper.missing.insert("thread_metadata".into());
+    }
+    for (table, value) in rows {
+        if table == "thread_attachments" {
+            let p = value["payload"]
+                .as_str()
+                .or(value["payload_json"].as_str())
+                .and_then(|s| serde_json::from_str::<Value>(s).ok());
+            if let Some(p) = p
+                && let Some(url) = p["url"].as_str()
+            {
+                let mut r = base.clone();
+                r["kind"] = "vcs".into();
+                r["data"] = json!({"action":"pr_link","status":"unknown","evidence":"reported","pr":{"url":url}});
+                annotations.push(r);
+            }
+        }
+    }
+    for (i, r) in annotations.iter_mut().enumerate() {
+        r["id"] = format!("asr:annotation:{i}").into();
+        if !clean_secrets(r, &mapper.index.secrets).is_empty() || strip_private(r).0 {
+            mapper.missing.insert("secrets".into());
+        }
+    }
+    Ok(annotations)
+}
