+use crate::ExportArgs;
+use crate::mapping::Mapper;
+use crate::source::{Index, Segment, Source};
+use pretty_assertions::assert_eq;
+use serde_json::{Value, json};
+use std::collections::HashMap;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::sync::Arc;
+
+const THREAD: &str = "019a3c2e-7b1f-7d40-9e2a-5c8b1d3f6e70";
+const CHILD: &str = "019a3c2e-7b1f-7d40-9e2a-5c8b1d3f6e71";
+fn header() -> Value {
+    json!({"id":THREAD,"timestamp":"2026-10-27T12:00:00Z","cwd":"/work/repo","cli_version":"0.163.0","source":"cli"})
+}
+fn line(kind: &str, p: Value) -> Value {
+    json!({"type":kind,"timestamp":"2026-10-27T12:00:00Z","payload":p})
+}
+fn mapped(lines: Vec<Value>) -> (Value, Vec<Value>) {
+    mapped_meta(header(), lines)
+}
+fn mapped_meta(meta: Value, lines: Vec<Value>) -> (Value, Vec<Value>) {
+    let mut source_file = tempfile::NamedTempFile::new().unwrap();
+    for line in &lines {
+        writeln!(source_file, "{line}").unwrap();
+    }
+    let mut source = Source::open(source_file.path(), 16 * 1024 * 1024).unwrap();
+    let mut index = Index::default();
+    index.scan(&mut source).unwrap();
+    index.scan_secrets(&mut source).unwrap();
+    let seg = Segment {
+        path: "unused".into(),
+        rollout_id: THREAD.into(),
+        thread_id: meta["id"].as_str().unwrap().into(),
+        meta: meta.clone(),
+    };
+    let mut mapper = Mapper::new(
+        meta,
+        index,
+        THREAD.into(),
+        Arc::new(HashMap::new()),
+        "/unused".into(),
+    )
+    .unwrap();
+    for line in lines {
+        mapper.line(&seg, line).unwrap();
+    }
+    mapper.stream.finish().unwrap();
+    let records = fs::read_to_string(mapper.stream.file.path())
+        .unwrap()
+        .lines()
+        .map(|s| serde_json::from_str(s).unwrap())
+        .collect::<Vec<Value>>();
+    let header = mapper.header();
+    validate(&header, &records);
+    (header, records)
+}
+fn validate(header: &Value, records: &[Value]) {
+    if let Some(validator) = std::env::var_os("ASR_VALIDATOR") {
+        let mut file = tempfile::NamedTempFile::new().unwrap();
+        writeln!(file, "{header}").unwrap();
+        for r in records {
+            writeln!(file, "{r}").unwrap();
+        }
+        let output = std::process::Command::new("node")
+            .arg(validator)
+            .arg(file.path())
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stdout)
+        );
+    }
+}
+fn rows<'a>(r: &'a [Value], kind: &str) -> Vec<&'a Value> {
+    r.iter().filter(|r| r["type"] == kind).collect()
+}
+fn call(id: &str) -> Value {
+    line(
+        "response_item",
+        json!({"type":"function_call","call_id":id,"name":"exec_command","arguments":"{}"}),
+    )
+}
+fn output(id: &str, text: &str) -> Value {
+    line(
+        "response_item",
+        json!({"type":"function_call_output","call_id":id,"output":text}),
+    )
+}
+fn completion(id: &str) -> Value {
+    line(
+        "event_msg",
+        json!({"type":"item_completed","item":{"type":"CommandExecution","id":id,"command":["false"],"cwd":"/work/repo","status":"failed","exit_code":1,"aggregated_output":"display","duration":{"secs":1,"nanos":500000000}}}),
+    )
+}
+
+#[test]
+fn identities_and_reasoning_follow_current_spec() {
+    let mut meta = header();
+    meta["creator_user_id"] = "synthetic-user".into();
+    meta["creator_account_id"] = "synthetic-account".into();
+    let (h, r) = mapped_meta(
+        meta,
+        vec![
+            line(
+                "response_item",
+                json!({"type":"reasoning","id":"reasoning","summary":[],"encrypted_content":"synthetic-ciphertext","signature":"synthetic-signature"}),
+            ),
+            line(
+                "response_item",
+                json!({"type":"reasoning","id":"opaque","encrypted_content":"synthetic-ciphertext"}),
+            ),
+            line(
+                "response_item",
+                json!({"type":"message","id":"prompt","role":"user","content":[{"type":"input_text","text":"AGENTS\r\n"},{"type":"input_text","text":"Hello"}],"internal_chat_message_metadata_passthrough":{"content_item_kinds":["agents_md.instructions","user.text"]}}),
+            ),
+        ],
+    );
+    assert_eq!(
+        h["user"],
+        json!({"id":"synthetic-user","source":"agent_account"})
+    );
+    assert_eq!(r[0]["id"], "reasoning");
+    assert_eq!(r[0]["content"][0]["summary"], json!([]));
+    assert_eq!(r[0]["content"][0]["visibility"], "summary");
+    assert_eq!(r[1]["content"][0]["visibility"], "encrypted");
+    assert_eq!(r[2]["content"][0]["text"], "AGENTS\r\n");
+    assert_eq!(r[2]["content"][1]["author"], "human");
+    let encoded = json!(r).to_string();
+    assert!(!encoded.contains("synthetic-ciphertext"));
+    assert!(!encoded.contains("synthetic-signature"));
+    assert!(h.get("seq").is_none());
+    assert_eq!(h["producer"]["source"], "codex-rollout");
+}
+#[test]
+fn tool_updates_fold_once_at_last_source_position_in_either_order() {
+    for order in [
+        vec![call("c"), output("c", "model"), completion("c")],
+        vec![call("c"), completion("c"), output("c", "model")],
+    ] {
+        let (_, r) = mapped(order);
+        let results = rows(&r, "tool_result");
+        assert_eq!(results.len(), 1);
+        assert_eq!(results[0]["status"], "failed");
+        assert_eq!(results[0]["content"][0]["text"], "model");
+        assert_eq!(results[0]["exec"]["output"], "display");
+        assert_eq!(results[0]["exec"]["exitCode"], 1);
+        assert_eq!(results[0]["durationMs"], 1500.0);
+        assert_eq!(
+            results[0]["_meta"]["com.openai.codex"]["sourcePosition"]["line"],
+            3
+        );
+    }
+}
+#[test]
+fn duplicate_calls_and_outputs_keep_ambiguous_native_call_id() {
+    let (_, r) = mapped(vec![
+        call("c"),
+        call("c"),
+        output("c", "old"),
+        output("c", "new"),
+        output("orphan", "value"),
+    ]);
+    assert_eq!(rows(&r, "tool_call").len(), 2);
+    assert_eq!(rows(&r, "tool_result").len(), 2);
+    assert_eq!(r[2]["content"][0]["text"], "new");
+    assert_ne!(r[0]["id"], r[1]["id"]);
+}
+#[test]
+fn patches_preserve_file_endpoints_and_require_recorded_application() {
+    let (_, r) = mapped(vec![
+        line(
+            "response_item",
+            json!({"type":"custom_tool_call","name":"apply_patch","call_id":"patch","input":"*** Begin Patch\n*** Update File: old.txt\n*** Move to: new.txt\n@@\n-a\n+b\n*** End Patch"}),
+        ),
+        line(
+            "event_msg",
+            json!({"type":"patch_apply_end","call_id":"patch","success":true,"changes":{"old.txt":{"type":"update","move_path":"new.txt","unified_diff":"@@ -1 +1 @@\n-a\n+b\n"}}}),
+        ),
+        output("patch", "ok"),
+    ]);
+    let changes = rows(&r, "file_change");
+    assert_eq!(changes.len(), 2);
+    assert_eq!(changes[0]["status"], "proposed");
+    assert!(changes[0].get("patch").is_none());
+    assert_eq!(changes[1]["status"], "applied");
+    assert_eq!(changes[1]["oldPath"], "/work/repo/old.txt");
+    assert_eq!(changes[1]["path"], "/work/repo/new.txt");
+    assert_eq!(changes[1]["patch"], "@@ -1 +1 @@\n-a\n+b\n");
+    assert_eq!(rows(&r, "tool_result").len(), 1);
+}
+#[test]
+fn copied_prefix_and_subagent_parent_do_not_use_root_session_identity() {
+    let mut h = header();
+    h["id"] = CHILD.into();
+    h["session_id"] = "unrelated-root".into();
+    h["source"] =
+        json!({"subagent":{"thread_spawn":{"parent_thread_id":THREAD,"agent_role":"reviewer"}}});
+    h["subagent_history_start_ordinal"] = 3.into();
+    let mut a = line(
+        "response_item",
+        json!({"type":"message","role":"user","content":[]}),
+    );
+    a["ordinal"] = 1.into();
+    let mut b = line(
+        "response_item",
+        json!({"type":"message","role":"assistant","content":[]}),
+    );
+    b["ordinal"] = 3.into();
+    let (h, r) = mapped_meta(h, vec![a, b]);
+    assert_eq!(h["sessionId"], CHILD);
+    assert_eq!(h["parent"]["session"], format!("codex:{THREAD}"));
+    assert_eq!(h["parent"]["copiedThrough"], r[0]["id"]);
+}
+#[test]
+fn unknown_turn_model_keeps_the_identified_inference() {
+    let (h, r) = mapped(vec![line(
+        "token_usage_record",
+        json!({"turn_id":"missing","response_id":"r","usage":{"input_tokens":2}}),
+    )]);
+    let inference = rows(&r, "inference");
+    assert_eq!(inference.len(), 1);
+    assert!(inference[0].get("model").is_none());
+    assert_eq!(inference[0]["usage"]["inputTokens"], 2);
+    assert!(h["missing"].as_array().unwrap().contains(&json!("model")));
+}
+
+#[test]
+fn wide_native_values_are_strings_and_unsafe_core_counts_are_omitted() {
+    let wide: Value = serde_json::from_str(r#"{"type":"function_call","call_id":"wide","name":"read","arguments":"{\"counter\":9007199254740993}"}"#).unwrap();
+    let (_, r) = mapped(vec![
+        line("response_item", wide),
+        line(
+            "token_usage_record",
+            json!({"response_id":"wide-response","usage":{"input_tokens":9007199254740993u64,"output_tokens":0}}),
+        ),
+    ]);
+    assert_eq!(
+        rows(&r, "tool_call")[0]["input"]["counter"],
+        "9007199254740993"
+    );
+    assert!(
+        rows(&r, "inference")[0]["usage"]
+            .get("inputTokens")
+            .is_none()
+    );
+    assert_eq!(rows(&r, "inference")[0]["usage"]["outputTokens"], 0);
+}
+
+#[test]
+fn completion_arguments_do_not_rewrite_the_original_call() {
+    let initial = line(
+        "response_item",
+        json!({"type":"function_call","call_id":"c","name":"lookup","arguments":"{}"}),
+    );
+    let completion = line(
+        "event_msg",
+        json!({"type":"item_completed","item":{"type":"McpToolCall","id":"c","tool":"lookup","arguments":null,"status":"completed"}}),
+    );
+    let (_, r) = mapped(vec![initial, completion]);
+    assert_eq!(rows(&r, "tool_call")[0]["input"], json!({}));
+    assert_eq!(rows(&r, "tool_result")[0].get("input"), Some(&Value::Null));
+}
+#[test]
+fn compaction_does_not_claim_retained_history_was_deleted() {
+    let (_, r) = mapped(vec![line(
+        "compacted",
+        json!({"message":"synthetic summary","replacement_history":[],"encrypted_content":"synthetic-ciphertext"}),
+    )]);
+    assert_eq!(r[0]["origin"], "compaction");
+    assert!(rows(&r, "gap").is_empty());
+}
+#[test]
+fn secrets_are_removed_even_from_escaped_copies() {
+    let secret = "synthetic-\"secret\"-value";
+    let (h, r) = mapped(vec![
+        line(
+            "response_item",
+            json!({"type":"function_call","name":"request_user_input","call_id":"secret","arguments":json!({"questions":[{"isSecret":true}]}).to_string()}),
+        ),
+        line(
+            "retained_context",
+            json!({"call_id":"secret","questions":[{"answer":secret}]}),
+        ),
+        output(
+            "secret",
+            &json!({"answers":{"q":{"answers":[secret]}}}).to_string(),
+        ),
+        line(
+            "response_item",
+            json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":json!({"copy":secret}).to_string()}]}),
+        ),
+    ]);
+    assert!(!json!(r).to_string().contains("synthetic-"));
+    assert!(r.iter().any(|r| r["truncated"] == true));
+    assert!(h["missing"].as_array().unwrap().contains(&json!("secrets")));
+}
+#[test]
+fn dynamic_string_errors_have_the_required_object_shape() {
+    let (_, r) = mapped(vec![line(
+        "event_msg",
+        json!({"type":"item_completed","item":{"type":"DynamicToolCall","id":"d","tool":"synthetic","status":"failed","error":"synthetic failure"}}),
+    )]);
+    assert_eq!(r[1]["error"], json!({"message":"synthetic failure"}));
+}
+#[test]
+fn valid_native_ids_take_precedence_and_derived_ids_avoid_collisions() {
+    let (_, r) = mapped(vec![
+        line(
+            "response_item",
+            json!({"type":"message","id":"asr:2:0","role":"user","content":[]}),
+        ),
+        call("call"),
+    ]);
+    assert_eq!(r[0]["id"], "asr:2:0");
+    assert_ne!(r[0]["id"], r[1]["id"]);
+}
+#[test]
+fn header_collisions_keep_ids_bounded_and_unique() {
+    let ids = (0..=250)
+        .map(|n| format!("header{}", "-".repeat(n)))
+        .chain((1..=300).map(|n| format!("header:{n}")));
+    let (h, r) = mapped(
+        ids.map(|id| {
+            line(
+                "response_item",
+                json!({"type":"message","id":id,"role":"user","content":[]}),
+            )
+        })
+        .collect(),
+    );
+    assert!(h["id"].as_str().unwrap().len() <= 256);
+    assert!(r.iter().all(|record| record["id"] != h["id"]));
+}
+fn args(out: &Path) -> ExportArgs {
+    ExportArgs {
+        format: "agent-session".into(),
+        thread: None,
+        all: true,
+        out: Some(out.into()),
+        codex_home: None,
+        sqlite_home: None,
+        max_line_bytes: 1024 * 1024,
+    }
+}
+fn rollout(home: &Path, compressed: bool) -> std::path::PathBuf {
+    let root = home.join("sessions");
+    fs::create_dir_all(&root).unwrap();
+    let path = root.join(format!(
+        "rollout-2026-10-27T12-00-00-{THREAD}.jsonl{}",
+        if compressed { ".zst" } else { "" }
+    ));
+    let bytes = format!(
+        "{}\n{}\n{{torn",
+        line("session_meta", header()),
+        line(
+            "response_item",
+            json!({"type":"message","role":"user","content":[]})
+        )
+    );
+    fs::write(
+        &path,
+        if compressed {
+            zstd::stream::encode_all(bytes.as_bytes(), 1).unwrap()
+        } else {
+            bytes.into_bytes()
+        },
+    )
+    .unwrap();
+    path
+}
+#[test]
+fn plain_and_compressed_exports_are_deterministic_private_and_read_only() {
+    for compressed in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        let path = rollout(home.path(), compressed);
+        let before = fs::read(&path).unwrap();
+        let out = home.path().join("out");
+        let stats = crate::export::run(home.path(), &args(&out), Default::default()).unwrap();
+        assert_eq!(stats.gaps, 1);
+        assert_eq!(fs::read(&path).unwrap(), before);
+        let out2 = home.path().join("out2");
+        crate::export::run(home.path(), &args(&out2), Default::default()).unwrap();
+        assert_eq!(
+            fs::read(out.join("bundle.json")).unwrap(),
+            fs::read(out2.join("bundle.json")).unwrap()
+        );
+        assert!(crate::export::run(home.path(), &args(&out), Default::default()).is_err());
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            for dir in [&out, &out.join("sessions")] {
+                assert_eq!(
+                    fs::metadata(dir).unwrap().permissions().mode() & 0o777,
+                    0o700
+                );
+            }
+        }
+        for file in fs::read_dir(out.join("sessions")).unwrap() {
+            let file = file.unwrap().path();
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                assert_eq!(
+                    fs::metadata(&file).unwrap().permissions().mode() & 0o777,
+                    0o600
+                );
+            }
+            let rows = fs::read_to_string(file)
+                .unwrap()
+                .lines()
+                .map(|s| serde_json::from_str::<Value>(s).unwrap())
+                .collect::<Vec<_>>();
+            validate(&rows[0], &rows[1..]);
+        }
+    }
+}
