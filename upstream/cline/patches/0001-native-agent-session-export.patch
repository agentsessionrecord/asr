diff --git a/apps/cli/src/commands/history-asr.test.ts b/apps/cli/src/commands/history-asr.test.ts
new file mode 100644
index 0000000..14bacb1
--- /dev/null
+++ b/apps/cli/src/commands/history-asr.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it, vi } from "vitest";
+
+const read = vi.hoisted(() => vi.fn());
+const exportFile = vi.hoisted(() => vi.fn());
+vi.mock("../session/session", () => ({
+	readSessionMessagesArtifact: read,
+	deleteSession: vi.fn(),
+	listSessions: vi.fn(),
+	updateSession: vi.fn(),
+}));
+vi.mock("../session/history-export", () => ({
+	exportHistorySession: exportFile,
+}));
+
+import { runHistoryExport } from "./history";
+
+describe("history export --format agent-session", () => {
+	it("writes a single native stream to stdout", async () => {
+		read.mockResolvedValue({
+			sessionId: "native-id",
+			startedAt: "2026-01-01T00:00:00Z",
+			cwd: "/work/example",
+			messages: [{ id: "m", role: "user", content: "synthetic" }],
+		});
+		const write = vi
+			.spyOn(process.stdout, "write")
+			.mockImplementation(() => true);
+		const io = { writeln: vi.fn(), writeErr: vi.fn() };
+		let code = -1;
+		let output = "";
+		try {
+			code = await runHistoryExport(
+				"native-id",
+				undefined,
+				"text",
+				io,
+				"agent-session",
+			);
+			output = String(write.mock.calls[0][0]);
+		} finally {
+			write.mockRestore();
+		}
+		expect(code).toBe(0);
+		expect(JSON.parse(output.split("\n")[0])).toMatchObject({
+			type: "session",
+			sessionId: "native-id",
+			producer: { method: "native" },
+			cwd: "/work/example",
+			startedAt: "2026-01-01T00:00:00Z",
+		});
+		expect(exportFile).not.toHaveBeenCalled();
+		expect(io.writeln).not.toHaveBeenCalled();
+	});
+	it("rejects an unavailable native source with no stdout", async () => {
+		read.mockResolvedValue(undefined);
+		const io = { writeln: vi.fn(), writeErr: vi.fn() };
+		expect(
+			await runHistoryExport("absent", undefined, "text", io, "agent-session"),
+		).toBe(1);
+		expect(io.writeErr).toHaveBeenCalledOnce();
+	});
+	it("rejects unknown formats", async () => {
+		const io = { writeln: vi.fn(), writeErr: vi.fn() };
+		expect(await runHistoryExport("id", undefined, "text", io, "json")).toBe(1);
+		expect(io.writeErr).toHaveBeenCalledWith(
+			"Unsupported export format. Use html or agent-session.",
+		);
+	});
+});
diff --git a/apps/cli/src/commands/history-command.ts b/apps/cli/src/commands/history-command.ts
