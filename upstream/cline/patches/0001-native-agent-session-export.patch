-import { exportHistorySession } from "../session/history-export";
-import { deleteSession, listSessions, updateSession } from "../session/session";
+import { exportAgentSession } from "../session/agent-session";
+import {
+	exportHistorySession,
+	type HistoryExportFormat,
+} from "../session/history-export";
+import {
+	deleteSession,
+	listSessions,
+	readSessionMessagesArtifact,
+	updateSession,
+} from "../session/session";
 import { formatHistoryListLine } from "../utils/history-format";
 import { writeln } from "../utils/output";
 import type { CliOutputMode } from "../utils/types";
@@ -106,16 +115,31 @@ async function runHistoryExport(
 	outputPath: string | undefined,
 	outputMode: CliOutputMode,
 	io: HistoryIo,
+	format: HistoryExportFormat = "html",
 ): Promise<number> {
 	if (!sessionId) {
 		io.writeErr("history export requires <session-id>");
 		return 1;
 	}
 
+	if (format !== "html" && format !== "agent-session") {
+		io.writeErr("Unsupported export format. Use html or agent-session.");
+		return 1;
+	}
+
 	try {
+		if (format === "agent-session" && !outputPath) {
+			const data = await readSessionMessagesArtifact(sessionId);
+			if (!data)
+				throw new Error("Session is unavailable or has no retained messages");
+			process.stdout.write(
+				exportAgentSession(data.sessionId ?? sessionId, data.messages, data),
+			);
+			return 0;
+		}
 		const targetPath = await exportHistorySession({
 			sessionId,
-			format: "html",
+			format,
 			outputPath,
 		});
 
