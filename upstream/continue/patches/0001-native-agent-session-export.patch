diff --git a/extensions/cli/src/commands/sessions.ts b/extensions/cli/src/commands/sessions.ts
new file mode 100644
index 0000000..bb2a51b
--- /dev/null
+++ b/extensions/cli/src/commands/sessions.ts
@@ -0,0 +1,84 @@
+import { createHash } from "node:crypto";
+import { mkdir, readFile, readdir, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import path from "node:path";
+
+import type { Command } from "commander";
+import type { Session } from "core/index.js";
+
+import { exportAgentSession } from "../agent-session.js";
+
+export async function exportSessions(
+  options: {
+    session?: string[];
+    format: string;
+    output?: string;
+    source?: string;
+  },
+  write: (text: string) => void = (text) => {
+    process.stdout.write(text);
+  },
+): Promise<void> {
+  if (options.format !== "agent-session")
+    throw new Error("Unsupported format. Use agent-session.");
+  const directory =
+    options.source ??
+    path.join(
+      process.env.CONTINUE_GLOBAL_DIR ?? path.join(homedir(), ".continue"),
+      "sessions",
+    );
+  const files = (await readdir(directory))
+    .filter((name) => name.endsWith(".json") && name !== "sessions.json")
+    .sort();
+  const wanted = new Set(options.session);
+  if (!options.output && wanted.size !== 1)
+    throw new Error(
+      "Select exactly one --session for stdout, or use --output.",
+    );
+  const found = new Set<string>();
+  const exports: { id: string; contents: string }[] = [];
+  for (const name of files) {
+    // Match against the stored identity, never interpolate a supplied ID into a path.
+    const session: Session = JSON.parse(
+      await readFile(path.join(directory, name), "utf8"),
+    );
+    if (!session?.sessionId || !Array.isArray(session.history))
+      throw new Error("Invalid native session file");
+    if (wanted.size && !wanted.has(session.sessionId)) continue;
+    if (found.has(session.sessionId))
+      throw new Error("Duplicate native session identity");
+    found.add(session.sessionId);
+    exports.push({
+      id: session.sessionId,
+      contents: exportAgentSession(session),
+    });
+  }
+  if ([...wanted].some((id) => !found.has(id)))
+    throw new Error("A selected session is unavailable");
+  if (!options.output) {
+    write(exports[0]!.contents);
+    return;
+  }
+  await mkdir(options.output, { recursive: true, mode: 0o700 });
+  for (const entry of exports) {
+    const filename =
+      createHash("sha256").update(entry.id).digest("hex") + ".jsonl";
+    await writeFile(path.join(options.output, filename), entry.contents, {
+      mode: 0o600,
+    });
+  }
+}
+
+export function registerSessionsCommand(program: Command): void {
+  program
+    .command("sessions")
+    .description("Export saved native sessions")
+    .command("export")
+    .requiredOption("--format <format>", "Export format: agent-session")
+    .option("--session <id...>", "Native session IDs")
+    .option("--output <directory>", "Write one JSONL file per session")
+    .option("--source <directory>", "Native sessions directory")
+    .action(async (options) => {
+      await exportSessions(options);
+    });
+}
