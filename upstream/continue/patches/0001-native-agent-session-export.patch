diff --git a/extensions/cli/src/agent-session.test.ts b/extensions/cli/src/agent-session.test.ts
new file mode 100644
index 0000000..b087993
--- /dev/null
+++ b/extensions/cli/src/agent-session.test.ts
@@ -0,0 +1,190 @@
+import { describe, expect, it } from "vitest";
+import fixture from "./agent-session.native.json";
+import { exportAgentSession } from "./agent-session.js";
+
+const records = (session: unknown = fixture) =>
+  exportAgentSession(session as Parameters<typeof exportAgentSession>[0])
+    .trim()
+    .split("\n")
+    .map((line) => JSON.parse(line));
+const native = (messages: unknown[]) => ({
+  sessionId: "synthetic",
+  title: "",
+  workspaceDirectory: "",
+  history: messages.map((message) => ({ message, contextItems: [] })),
+});
+
+describe("Agent Session Record export", () => {
+  it("keeps tool identity, native order, exact text and cumulative usage", () => {
+    const result = records();
+    expect(result.map((record) => record.type)).toEqual([
+      "session",
+      "message",
+      "message",
+      "tool_call",
+      "tool_result",
+      "message",
+      "session_info",
+    ]);
+    expect(result[1].content[0].text).toBe("Read the synthetic note.\n");
+    expect(result[1].author).toBeUndefined();
+    expect(result[3]).toMatchObject({
+      callId: "read-1",
+      name: "read_file",
+      inputText: '{"path":"/work/example/note.txt"}',
+    });
+    expect(result[4]).toMatchObject({ callId: "read-1", status: "completed" });
+    expect(result.at(-1)).toMatchObject({
+      agentSettings: { mode: "agent" },
+      usage: { inputTokens: 100, cacheReadTokens: 0, outputTokens: 12 },
+      cost: { amount: 0, currency: "USD", source: "harness_estimated" },
+    });
+    expect(result[0].endedAt).toBeUndefined();
+  });
+  it("never derives inferences or models from assistant message boundaries", () => {
+    expect(records().some((record) => record.type === "inference")).toBe(false);
+    expect(records()[0].missing).toContain("model");
+  });
+  it("leaves result status unknown without a unique native state", () => {
+    const result = records(
+      native([{ role: "tool", toolCallId: "unknown", content: "done" }]),
+    );
+    expect(result[1].status).toBe("unknown");
+  });
+  it("folds results at completion without moving an intervening message", () => {
+    const result = records(
+      native([
+        { role: "tool", toolCallId: "call", content: "partial" },
+        { role: "user", content: "notice" },
+        { role: "tool", toolCallId: "call", content: "final" },
+      ]),
+    );
+    expect(result.slice(1, 3).map((record) => record.content[0].text)).toEqual([
+      "notice",
+      "final",
+    ]);
+    expect(result[0].missing).toContain("tool_result_updates");
+  });
+  it("marks malformed history and keeps encrypted reasoning content-free", () => {
+    const result = records(
+      native([
+        { role: "future", content: "bad" },
+        {
+          role: "thinking",
+          content: "secret opaque text",
+          redactedThinking: "opaque-fixture",
+          signature: "opaque-fixture",
+        },
+      ]),
+    );
+    expect(result[1]).toMatchObject({ type: "gap", reason: "unparseable" });
+    expect(result[2].content).toEqual([
+      { type: "reasoning", visibility: "encrypted" },
+    ]);
+    expect(JSON.stringify(result)).not.toContain("opaque-fixture");
+  });
+  it("preserves exact wide arguments as text, without numeric parsing", () => {
+    const argument = '{"id":9007199254740993}';
+    const result = records(
+      native([
+        {
+          role: "assistant",
+          content: "",
+          toolCalls: [
+            { id: "wide", function: { name: "test", arguments: argument } },
+          ],
+        },
+      ]),
+    );
+    expect(result[2].inputText).toBe(argument);
+  });
+  it("records effective rewritten arguments and filters credential values", () => {
+    const session = native([
+      {
+        role: "assistant",
+        content: "",
+        toolCalls: [
+          { id: "test", function: { name: "test", arguments: "{}" } },
+        ],
+      },
+    ]);
+    Object.assign(session.history[0], {
+      toolCallStates: [
+        {
+          toolCallId: "test",
+          status: "done",
+          processedArgs: { password: "synthetic-value", keep: false },
+        },
+      ],
+    });
+    const result = records(session);
+    expect(result[2]).toMatchObject({
+      input: { password: "[redacted]", keep: false },
+      truncated: true,
+    });
+    expect(result[0].missing).toContain("secrets");
+  });
+  it("keeps compaction summaries separate from human authorship", () => {
+    const session = native([{ role: "assistant", content: "before" }]);
+    Object.assign(session.history[0], { conversationSummary: "Summary" });
+    expect(records(session)[2]).toMatchObject({
+      type: "message",
+      origin: "compaction",
+      content: [{ type: "text", text: "Summary" }],
+    });
+  });
+  it("exports deterministic bytes and rejects invalid top-level input", () => {
+    expect(
+      exportAgentSession(fixture as Parameters<typeof exportAgentSession>[0]),
+    ).toBe(
+      exportAgentSession(fixture as Parameters<typeof exportAgentSession>[0]),
+    );
+    expect(() => records({})).toThrow("Invalid native session");
+  });
+  it("marks destructive CLI compaction with one summary and a following gap", () => {
+    const session = native([{ role: "assistant", content: "Summary" }]);
+    Object.assign(session.history[0], { conversationSummary: "Summary" });
+    const result = records(session);
+    expect(result.map((record) => record.type)).toEqual([
+      "session",
+      "message",
+      "gap",
+      "session_info",
+    ]);
+    expect(result[1].origin).toBe("compaction");
+    expect(result[2].reason).toBe("not_retained");
+  });
+  it("marks missing remote media and filters quoted argument secrets", () => {
+    const result = records(
+      native([
+        {
+          role: "user",
+          content: [
+            {
+              type: "imageUrl",
+              imageUrl: { url: "https://example.com/not-fetched.png" },
+            },
+          ],
+        },
+        {
+          role: "assistant",
+          content: "",
+          toolCalls: [
+            {
+              id: "test",
+              function: {
+                name: "test",
+                arguments: '{"password":"synthetic-value"}',
+              },
+            },
+          ],
+        },
+      ]),
+    );
+    expect(result[1].truncated).toBe(true);
+    expect(result[0].missing).toEqual(
+      expect.arrayContaining(["media", "secrets"]),
+    );
+    expect(JSON.stringify(result)).not.toContain("synthetic-value");
+  });
+});
diff --git a/extensions/cli/src/agent-session.ts b/extensions/cli/src/agent-session.ts
new file mode 100644
index 0000000..60178ef
--- /dev/null
+++ b/extensions/cli/src/agent-session.ts
@@ -0,0 +1,337 @@
+import type { Session } from "core/index.js";
+
+type JsonObject = { [key: string]: unknown };
+
+type AsrRecord = JsonObject & { type: string; id: string };
+
+function object(value: unknown): JsonObject {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as JsonObject)
+    : {};
+}
+
+function scrub(value: unknown, changed: () => void, key = ""): unknown {
+  if (
+    /^(?:api[_-]?key|access[_-]?token|auth[_-]?token|refresh[_-]?token|session[_-]?token|password|authorization|secret|secret[_-]?key|client[_-]?secret|credential)$/i.test(
+      key,
+    ) &&
+    value !== undefined
+  ) {
+    changed();
+    return "[redacted]";
+  }
+  if (
+    typeof value === "number" &&
+    (!Number.isFinite(value) ||
+      (Number.isInteger(value) && !Number.isSafeInteger(value)))
+  ) {
+    throw new Error(
+      "Cannot export an unsafe native number. Store wide native values as strings.",
+    );
+  }
+  if (typeof value === "bigint") return value.toString();
+  if (typeof value === "string") {
+    const cleaned =
+      /^(?:api[_-]?key|access[_-]?token|refresh[_-]?token|password|authorization|secret)$/i.test(
+        key,
+      )
+        ? "[redacted]"
+        : value
+            .replace(
+              /\b(?:sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b/g,
+              "[redacted]",
+            )
+            .replace(/\bBearer\s+[A-Za-z0-9._~+\/-]+/gi, "Bearer [redacted]")
+            .replace(
+              /\b((?:api[_-]?key|access[_-]?token|auth[_-]?token|password|authorization|secret)["']?\s*[:=]\s*["']?)[^\s,"']+/gi,
+              "$1[redacted]",
+            );
+    if (cleaned !== value) changed();
+    return cleaned;
+  }
+  if (Array.isArray(value)) return value.map((item) => scrub(item, changed));
+  if (value !== null && typeof value === "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([name, item]) => [
+        name,
+        scrub(item, changed, name),
+      ]),
+    );
+  }
+  return value;
+}
+
+/** Export a saved native session without treating message boundaries as model calls. */
+export function exportAgentSession(session: Session): string {
+  if (!session?.sessionId || !Array.isArray(session.history))
+    throw new Error("Invalid native session");
+  if (scrub(session.sessionId, () => {}) !== session.sessionId)
+    throw new Error("Session identity contains a credential");
+  const missing = new Set([
+    "approvals",
+    "agent_settings",
+    "tools",
+    "file_changes",
+    "commits",
+    "subagents",
+    "copies",
+    "usage",
+    "model",
+    "inference_settings",
+    "timestamps",
+    "message_author",
+    "instructions",
+    "context",
+    "native_metadata",
+    "provider_state",
+  ]);
+  const records: AsrRecord[] = [];
+  let sequence = 0;
+  const emit = (type: string, fields: JsonObject) => {
+    if (
+      typeof fields.callId === "string" &&
+      scrub(fields.callId, () => {}) !== fields.callId
+    )
+      throw new Error("Tool identity contains a credential");
+    records.push({ type, id: `asr-${++sequence}`, ...fields });
+  };
+  const gap = (reason: string, detail: string) => {
+    missing.add("history");
+    emit("gap", { reason, detail });
+  };
+  let omittedParts = 0;
+  const parts = (content: unknown): JsonObject[] => {
+    if (typeof content === "string") return [{ type: "text", text: content }];
+    if (!Array.isArray(content)) {
+      missing.add("content");
+      omittedParts++;
+      return [];
+    }
+    return content.flatMap<JsonObject>((value) => {
+      const b = object(value);
+      if (b.type === "text" && typeof b.text === "string")
+        return [{ type: "text", text: b.text }];
+      if (b.type === "imageUrl") {
+        const url = object(b.imageUrl).url;
+        if (typeof url === "string") {
+          const match = /^data:([^;,]+);base64,([\s\S]*)$/.exec(url);
+          if (match)
+            return [{ type: "image", mimeType: match[1], data: match[2] }];
+        }
+        missing.add("media");
+        omittedParts++;
+        return [];
+      }
+      missing.add("content");
+      omittedParts++;
+      return [];
+    });
+  };
+  const states = new Map<
+    string,
+    Session["history"][number]["toolCallStates"]
+  >();
+  const lastResult = new Map<string, number>();
+  session.history.forEach((item, index) => {
+    if (item?.message?.role === "tool") {
+      if (lastResult.has(item.message.toolCallId))
+        missing.add("tool_result_updates");
+      lastResult.set(item.message.toolCallId, index);
+    }
+    for (const state of item?.toolCallStates ?? []) {
+      states.set(state.toolCallId, [
+        ...(states.get(state.toolCallId) ?? []),
+        state,
+      ]);
+    }
+  });
+  session.history.forEach((item, index) => {
+    const m = item?.message;
+    if (
+      !m ||
+      !["user", "assistant", "system", "thinking", "tool"].includes(m.role)
+    ) {
+      gap("unparseable", "Invalid native history item");
+      return;
+    }
+    const firstRecord = records.length;
+    const beforeParts = omittedParts;
+    const compaction =
+      item.conversationSummary !== undefined &&
+      m.content === item.conversationSummary;
+    if (m.role === "tool") {
+      if (lastResult.get(m.toolCallId) !== index) return;
+      const candidates = states.get(m.toolCallId) ?? [];
+      const status =
+        candidates.length === 1 ? candidates[0]?.status : undefined;
+      emit("tool_result", {
+        callId: m.toolCallId,
+        status:
+          status === "done"
+            ? "completed"
+            : status === "errored"
+              ? "failed"
+              : status === "canceled"
+                ? "cancelled"
+                : "unknown",
+        content: parts(m.content),
+      });
+    } else if (m.role === "thinking") {
+      const thinking = parts(m.content).map((part) =>
+        part.type === "text" ? asrReasoning(part.text, false) : part,
+      );
+      emit("message", {
+        role: "assistant",
+        author: "model",
+        content: m.redactedThinking !== undefined
+          ? [{ type: "reasoning", visibility: "encrypted" }]
+          : thinking.length ? thinking : [asrReasoning("")],
+      });
+    } else {
+      emit("message", {
+        role: m.role,
+        ...(m.role === "assistant"
+          ? { author: "model" }
+          : m.role === "system"
+            ? { origin: "instructions" }
+            : {}),
+        ...(compaction ? { origin: "compaction" } : {}),
+        content: parts(m.content),
+      });
+      if (m.role === "assistant")
+        for (const call of m.toolCalls ?? []) {
+          if (!call.id || !call.function?.name) {
+            gap("not_recorded", "Incomplete native tool request");
+            continue;
+          }
+          const candidates = states.get(call.id) ?? [];
+          const effective =
+            candidates.length === 1 ? candidates[0]?.processedArgs : undefined;
+          emit("tool_call", {
+            callId: call.id,
+            name: call.function.name,
+            requestedBy: "model",
+            ...(effective !== undefined
+              ? {
+                  input: effective,
+                  _meta: {
+                    "dev.continue": {
+                      requestedArguments: call.function.arguments,
+                    },
+                  },
+                }
+              : call.function.arguments !== undefined
+                ? { inputText: call.function.arguments }
+                : {}),
+          });
+        }
+    }
+    if (compaction)
+      gap(
+        "not_retained",
+        "Earlier CLI history was replaced by the native compaction summary",
+      );
+    if (item.conversationSummary !== undefined && !compaction) {
+      emit("message", {
+        role: "user",
+        origin: "compaction",
+        content: [{ type: "text", text: item.conversationSummary }],
+      });
+    }
+    if (omittedParts > beforeParts)
+      for (const record of records.slice(firstRecord)) record.truncated = true;
+  });
+  const count = (value: unknown) => {
+    if (value === undefined) return undefined;
+    if (typeof value === "number" && Number.isSafeInteger(value) && value >= 0)
+      return value;
+    missing.add("usage_counts");
+    return undefined;
+  };
+  const usage = session.usage;
+  const info: JsonObject = {
+    ...(typeof session.title === "string" ? { title: session.title } : {}),
+    ...(session.mode !== undefined
+      ? { agentSettings: { mode: session.mode } }
+      : {}),
+    ...(usage
+      ? {
+          usage: {
+            inputTokens: count(usage.promptTokens),
+            outputTokens: count(usage.completionTokens),
+            cacheReadTokens: count(usage.promptTokensDetails?.cachedTokens),
+            cacheWriteTokens: count(
+              usage.promptTokensDetails?.cacheWriteTokens,
+            ),
+            reasoningTokens: count(
+              usage.completionTokensDetails?.reasoningTokens,
+            ),
+          },
+          ...(typeof usage.totalCost === "number" &&
+          Number.isFinite(usage.totalCost) &&
+          usage.totalCost >= 0
+            ? {
+                cost: {
+                  amount: usage.totalCost,
+                  currency: "USD",
+                  source: "harness_estimated",
+                },
+              }
+            : {}),
+        }
+      : {}),
+  };
+  // Mutable saved settings and totals are known only at this snapshot's tail.
+  if (Object.keys(info).length) emit("session_info", info);
+  const cleaned = records.map((record) => {
+    let shortened = false;
+    const result = scrub(record, () => {
+      shortened = true;
+    }) as AsrRecord;
+    if (shortened) {
+      result.truncated = true;
+      missing.add("secrets");
+    }
+    return result;
+  });
+  const header = {
+    type: "session",
+    id: "header",
+    formatVersion: "0.1",
+    agent: { name: "continue" },
+    sessionId: session.sessionId,
+    ...(typeof session.workspaceDirectory === "string" &&
+    (/^\//.test(session.workspaceDirectory) ||
+      /^[A-Za-z]:[\\/]/.test(session.workspaceDirectory))
+      ? { cwd: session.workspaceDirectory }
+      : {}),
+    producer: {
+      name: "continue-agent-session-export",
+      version: "0.1.0",
+      method: "native",
+      source: "continue-session",
+    },
+    missing: [...missing].sort(),
+  };
+  let shortenedHeader = false;
+  const safeHeader = scrub(header, () => {
+    shortenedHeader = true;
+  }) as JsonObject;
+  if (shortenedHeader) {
+    safeHeader.truncated = true;
+    missing.add("secrets");
+    safeHeader.missing = [...missing].sort();
+  }
+
+  return (
+    [safeHeader, ...cleaned]
+      .map((record) => JSON.stringify(record))
+      .join("\n") + "\n"
+  );
+}
+
+function asrReasoning(text: unknown, summary = false): { type: string; visibility?: string; text?: string; summary?: string[] } {
+  if (typeof text !== "string" || text.length === 0) return { type: "reasoning", visibility: "omitted" };
+  if (summary) return { type: "reasoning", visibility: "summary", summary: [text] };
+  return { type: "reasoning", text };
+}
diff --git a/extensions/cli/src/commands/sessions.test.ts b/extensions/cli/src/commands/sessions.test.ts
new file mode 100644
index 0000000..44d41ae
--- /dev/null
+++ b/extensions/cli/src/commands/sessions.test.ts
@@ -0,0 +1,91 @@
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { Command } from "commander";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import fixture from "../agent-session.native.json";
+import { exportSessions, registerSessionsCommand } from "./sessions.js";
+
+let directory: string;
+beforeEach(async () => {
+  directory = await mkdtemp(path.join(tmpdir(), "continue-asr-"));
+});
+afterEach(async () => {
+  await rm(directory, { recursive: true, force: true });
+});
+const seed = () =>
+  writeFile(path.join(directory, "native.json"), JSON.stringify(fixture));
+
+describe("sessions export", () => {
+  it("exports the selected stored identity to stdout", async () => {
+    await seed();
+    let output = "";
+    const program = new Command();
+    registerSessionsCommand(program);
+    const original = process.stdout.write;
+    process.stdout.write = ((text: string) => {
+      output += text;
+      return true;
+    }) as typeof process.stdout.write;
+    try {
+      await program.parseAsync(
+        [
+          "sessions",
+          "export",
+          "--format",
+          "agent-session",
+          "--session",
+          fixture.sessionId,
+          "--source",
+          directory,
+        ],
+        { from: "user" },
+      );
+    } finally {
+      process.stdout.write = original;
+    }
+    expect(JSON.parse(output.split("\n")[0]).sessionId).toBe(fixture.sessionId);
+  });
+  it("rejects unavailable selections and ambiguous stdout", async () => {
+    await seed();
+    await expect(
+      exportSessions({ format: "agent-session", source: directory }),
+    ).rejects.toThrow("exactly one");
+    await expect(
+      exportSessions({
+        format: "agent-session",
+        source: directory,
+        session: ["../absent"],
+      }),
+    ).rejects.toThrow("unavailable");
+    await expect(
+      exportSessions({ format: "bad", source: directory }),
