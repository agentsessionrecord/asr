+#[test]
+fn large_native_floats_are_strings_without_claiming_text_loss() {
+    let mut session = fixture();
+    let messages = session.conversation.as_mut().unwrap().messages_mut();
+    for message in messages {
+        for part in &mut message.content {
+            if let MessageContent::ToolRequest(request) = part {
+                request.tool_call.as_mut().unwrap().arguments = Some(
+                    json!({"large": 1.0e30, "small": 0.25})
+                        .as_object()
+                        .unwrap()
+                        .clone(),
+                );
+            }
+        }
+    }
+    let rows = records(&session);
+    assert_eq!(rows[3]["input"]["large"], "1e+30");
+    assert_eq!(rows[3]["input"]["small"], 0.25);
+    assert!(rows[3].get("truncated").is_none());
+}
