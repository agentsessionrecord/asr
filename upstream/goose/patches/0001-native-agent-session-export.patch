diff --git a/crates/goose/src/session/export_agent_session.rs b/crates/goose/src/session/export_agent_session.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a0fb23f4021acb174671a861c824d5f16cf528e6
--- /dev/null
+++ b/crates/goose/src/session/export_agent_session.rs
@@ -0,0 +1,293 @@
+use std::collections::{HashMap, HashSet};
+
+use anyhow::{anyhow, Result};
+use chrono::DateTime;
+use rmcp::model::Role;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+use crate::conversation::message::{ActionRequiredData, MessageContent};
+use crate::permission::Permission;
+use crate::session::Session;
+
+const VENDOR: &str = "com.block.goose";
+
+pub fn agent_session_namespace() -> Result<String> {
+    use std::io::Write;
+    let dir = crate::config::paths::Paths::data_dir();
+    std::fs::create_dir_all(&dir)?;
+    let path = dir.join("agent-session-namespace");
+    match std::fs::read_to_string(&path) {
+        Ok(value) if !value.trim().is_empty() => Ok(value.trim().to_string()),
+        Ok(_) => Err(anyhow!("Empty agent-session namespace file")),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            let value = uuid::Uuid::now_v7().to_string();
+            let mut file = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(path)?;
+            writeln!(file, "{value}")?;
+            Ok(value)
+        }
+        Err(error) => Err(error.into()),
+    }
+}
+
+/// Export stored history without applying the UI or active-context projection.
+pub fn export_session_to_agent_session(session: &Session, namespace: &str) -> Result<String> {
+    if session.id.is_empty() || namespace.is_empty() {
+        return Err(anyhow!(
+            "Session ID and installation namespace must be non-empty"
+        ));
+    }
+    let conversation = session
+        .conversation
+        .as_ref()
+        .ok_or_else(|| anyhow!("Session has no stored conversation"))?;
+    let mut records = vec![json!({
+        "type": "session", "id": "header", "formatVersion": "0.1",
+        "agent": {"name": "goose"}, "sessionId": session.id, "namespace": namespace,
+        "producer": {"name": "goose-session-export", "version": env!("CARGO_PKG_VERSION"),
+            "method": "native", "source": "goose-sqlite"},
+        "startedAt": session.created_at.to_rfc3339(),
+        "missing": ["approvals", "agent_settings", "tools", "usage", "model", "copies",
+            "subagents", "file_changes", "commits", "exit_codes", "inference_settings",
+            "native_metadata", "source_text_sanitization", "secrets", "history"]
+    })];
+    if session.working_dir.is_absolute() {
+        records[0]["cwd"] = json!(session.working_dir);
+    }
+    let mut native_ids = HashMap::new();
+    let mut last_results = HashMap::new();
+    for (mi, message) in conversation.messages().iter().enumerate() {
+        if let Some(id) = &message.id {
+            *native_ids.entry(id.as_str()).or_insert(0) += 1;
+        }
+        for (ci, part) in message.content.iter().enumerate() {
+            if let MessageContent::ToolResponse(response) = part {
+                last_results.insert(response.id.as_str(), (mi, ci));
+            }
+        }
+    }
+    let mut used_ids = HashSet::from(["header".to_string(), "snapshot".to_string()]);
+    for (mi, message) in conversation.messages().iter().enumerate() {
+        let mut pending = Vec::new();
+        let mut items = Vec::new();
+        for (ci, part) in message.content.iter().enumerate() {
+            let item = match part {
+                MessageContent::Text(text) => {
+                    pending.push(json!({"type": "text", "text": text.text}));
+                    continue;
+                }
+                MessageContent::Image(image) => {
+                    pending.push(serde_json::to_value(image)?);
+                    let last = pending.last_mut().unwrap();
+                    last["type"] = json!("image");
+                    continue;
+                }
+                MessageContent::Thinking(thinking) => {
+                    pending.push(asr_reasoning(&thinking.thinking, false));
+                    continue;
+                }
+                MessageContent::RedactedThinking(_) => {
+                    pending.push(json!({"type": "reasoning", "visibility": "encrypted"}));
+                    continue;
+                }
+                MessageContent::ToolRequest(request) => {
+                    let mut call = json!({"type": "tool_call", "callId": request.id});
+                    if let Ok(params) = &request.tool_call {
+                        call["name"] = json!(params.name);
+                        if let Some(arguments) = &params.arguments {
+                            call["input"] = json!(arguments);
+                        }
+                    }
+                    call
+                }
+                MessageContent::ToolResponse(response) => {
+                    if last_results.get(response.id.as_str()) != Some(&(mi, ci)) {
+                        json!({"type": "gap", "reason": "not_retained",
+                            "detail": "An intermediate tool result was folded into its last stored result."})
+                    } else {
+                        // This projection keeps model-facing output when MCP supplies two audiences.
+                        let projected = part.filter_for_audience(Role::Assistant).unwrap();
+                        let MessageContent::ToolResponse(response) = projected else {
+                            unreachable!()
+                        };
+                        match response.tool_result {
+                            Ok(result) => json!({"type": "tool_result", "callId": response.id,
+                                "status": match result.is_error { Some(true) => "failed", Some(false) => "completed", None => "unknown" },
+                                "content": result.content}),
+                            Err(error) => json!({"type": "tool_result", "callId": response.id,
+                                "status": "failed", "error": {"message": error.message, "code": error.code}}),
+                        }
+                    }
+                }
+                MessageContent::ActionRequired(action) => match &action.data {
+                    ActionRequiredData::ToolConfirmationResponse { id, permission } => {
+                        let (decision, scope) = match permission {
+                            Permission::AllowOnce => ("approved", Some("once")),
+                            Permission::AlwaysAllow => ("approved", Some("always")),
+                            Permission::DenyOnce => ("denied", Some("once")),
+                            Permission::AlwaysDeny => ("denied", Some("always")),
+                            Permission::Cancel => ("cancelled", None),
+                        };
+                        let mut approval = json!({"type": "approval", "callId": id,
+                            "decision": decision, "native": permission});
+                        if let Some(scope) = scope {
+                            approval["scope"] = json!(scope);
+                            approval["by"] = json!("user");
+                        }
+                        approval
+                    }
+                    ActionRequiredData::ElicitationResponse { .. } => json!({"type": "gap",
+                        "reason": "redacted", "detail": "Elicitation answers may contain secrets and are excluded."}),
+                    _ => json!({"type": "gap", "reason": "not_recorded",
+                        "detail": "The native interaction has no ASR mapping."}),
+                },
+                MessageContent::SystemNotification(notice) => {
+                    json!({"type": "message", "role": "user",
+                    "author": "harness", "origin": "notice", "content": [{"type": "text", "text": notice.msg}]})
+                }
+                _ => json!({"type": "gap", "reason": "not_recorded",
+                    "detail": "The native content part has no ASR mapping."}),
+            };
+            flush_message(&mut items, &mut pending, &message.role);
+            items.push(item);
+        }
+        flush_message(&mut items, &mut pending, &message.role);
+        if items.is_empty() {
+            items.push(json!({"type": "message", "role": message.role, "content": []}));
+        }
+        let single = items.len() == 1;
+        for (index, mut record) in items.into_iter().enumerate() {
+            let native = message.id.as_deref().filter(|id| {
+                single && native_ids.get(id) == Some(&1) && valid_id(id) && !used_ids.contains(*id)
+            });
+            let mut id = native.map(str::to_string).unwrap_or_else(|| {
+                let key = match message.id.as_deref() {
+                    Some(id) if native_ids.get(id) == Some(&1) => format!("message:{id}"),
+                    _ => format!("position:{mi}:{}", message.id.as_deref().unwrap_or("")),
+                };
+                format!(
+                    "asr-{}-{index}",
+                    Sha256::digest(key.as_bytes())
+                        .iter()
+                        .map(|byte| format!("{byte:02x}"))
+                        .collect::<String>()
+                )
+            });
+            while !used_ids.insert(id.clone()) {
+                id.push('x');
+            }
+            record["id"] = json!(id);
+            if let Some(ts) = DateTime::from_timestamp(message.created, 0) {
+                record["ts"] = json!(ts.to_rfc3339());
+            }
+            record["_meta"] = json!({VENDOR: {"messageId": message.id, "messagePosition": mi,
+                "userVisible": message.metadata.user_visible, "agentVisible": message.metadata.agent_visible}});
+            records.push(record);
+        }
+    }
+    // Mutable session settings establish only a latest-value snapshot at the tail.
+    records.push(
+        json!({"type": "session_info", "id": "snapshot", "title": session.name,
+        "agentSettings": {"mode": session.goose_mode},
+        "_meta": {VENDOR: {"gooseMode": session.goose_mode, "provider": session.provider_name,
+            "requestedModel": session.model_config.as_ref().map(|config| &config.model_name)}}}),
+    );
+    let mut output = String::new();
+    for mut record in records {
+        if clean_value(&mut record) {
+            record["truncated"] = json!(true);
+        }
+        output.push_str(&serde_json::to_string(&record)?);
+        output.push('\n');
+    }
+    Ok(output)
+}
+
+fn valid_id(id: &str) -> bool {
+    !id.is_empty() && id.chars().count() <= 256 && !id.chars().any(char::is_control)
+}
+
+fn flush_message(items: &mut Vec<Value>, pending: &mut Vec<Value>, role: &Role) {
+    if !pending.is_empty() {
+        let mut record =
+            json!({"type": "message", "role": role, "content": std::mem::take(pending)});
+        if *role == Role::Assistant {
+            record["author"] = json!("model");
+        }
+        items.push(record);
+    }
+}
+
+fn clean_value(value: &mut Value) -> bool {
+    match value {
+        Value::Number(number)
+            if number
+                .as_i64()
+                .is_some_and(|n| n.unsigned_abs() > 9_007_199_254_740_991)
+                || number.as_u64().is_some_and(|n| n > 9_007_199_254_740_991) =>
+        {
+            *value = Value::String(number.to_string());
+            false
+        }
+        Value::Number(number)
+            if number
+                .as_f64()
+                .is_some_and(|n| n.abs() > 9_007_199_254_740_991.0) =>
+        {
+            *value = Value::String(number.to_string());
+            false
+        }
+        Value::Array(values) => {
+            let mut changed = false;
+            for value in values {
+                changed = clean_value(value) || changed;
+            }
+            changed
+        }
+        Value::Object(values) => {
+            let mut changed = false;
+            for (key, value) in values {
+                if [
+                    "password",
+                    "api_key",
+                    "apikey",
+                    "access_token",
+                    "refresh_token",
+                    "authorization",
+                    "secret",
+                ]
+                .contains(&key.to_ascii_lowercase().as_str())
+                {
+                    *value = json!("[redacted]");
+                    changed = true;
+                } else {
+                    changed = clean_value(value) || changed;
+                }
+            }
+            changed
+        }
+        Value::String(text) => {
+            static SECRETS: std::sync::LazyLock<regex::Regex> = std::sync::LazyLock::new(|| {
+                regex::Regex::new(r#"(?i)(?:bearer\s+[^\s\"']+|(?:api[_-]?key|password|access_token|refresh_token|secret)\s*[=:]\s*[^\s,;\"']+|(?:sk-|gh[pousr]_|github_pat_|xox[baprs]-)[a-zA-Z0-9_-]{16,}|eyJ[a-zA-Z0-9_-]{12,}\.[a-zA-Z0-9_-]{12,}\.[a-zA-Z0-9_-]{12,}|(?:AKIA|ASIA)[A-Z0-9]{16}|https?://[^\s/@]+:[^\s/@]+@|-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z0-9 ]*PRIVATE KEY-----)"#).unwrap()
+            });
+            let cleaned = SECRETS.replace_all(text, "[redacted]").into_owned();
+            let changed = *text != cleaned;
+            *text = cleaned;
+            changed
+        }
+        _ => false,
+    }
+}
+
+fn asr_reasoning(text: &str, summary: bool) -> serde_json::Value {
+    if text.is_empty() {
+        serde_json::json!({"type":"reasoning", "visibility":"omitted"})
+    } else if summary {
+        serde_json::json!({"type":"reasoning", "visibility":"summary", "summary":[text]})
+    } else {
+        serde_json::json!({"type":"reasoning", "text":text})
+    }
+}
