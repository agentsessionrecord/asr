+#[test]
+fn excludes_secrets_and_secret_answers_and_keeps_unique_ids() {
+    let mut session = fixture();
+    let messages = session.conversation.as_mut().unwrap().messages_mut();
+    messages.push(
+        Message::user()
+            .with_id("prompt")
+            .with_text("password=synthetic-value"),
+    );
+    messages.push(Message::user().with_content(
+        MessageContent::action_required_elicitation_response(
+            "secret-answer",
+            json!({"answer":"synthetic-answer"}),
+            rmcp::model::ElicitationAction::Accept,
+        ),
+    ));
+    messages.push(Message::user().with_content(
+        MessageContent::action_required_tool_confirmation_response("read-1", Permission::Cancel),
+    ));
+    let output = export_session_to_agent_session(&session, "synthetic-installation").unwrap();
+    assert!(!output.contains("synthetic-value"));
+    assert!(!output.contains("synthetic-answer"));
+    let rows = records(&session);
+    let ids: std::collections::HashSet<_> =
+        rows.iter().map(|row| row["id"].as_str().unwrap()).collect();
+    assert_eq!(ids.len(), rows.len());
+    let cancel = rows
+        .iter()
+        .find(|row| row["decision"] == "cancelled")
+        .unwrap();
+    assert!(cancel.get("scope").is_none());
+    assert!(cancel.get("by").is_none());
+    assert!(rows.iter().any(|row| row["truncated"] == true));
+}
