+#[test]
+fn tool_status_requires_an_explicit_native_outcome() {
+    for (flag, expected) in [
+        (None, "unknown"),
+        (Some(false), "completed"),
+        (Some(true), "failed"),
+    ] {
+        let mut session = fixture();
+        for message in session.conversation.as_mut().unwrap().messages_mut() {
+            for part in &mut message.content {
+                if let MessageContent::ToolResponse(response) = part {
+                    if let Ok(result) = &mut response.tool_result {
+                        result.is_error = flag;
+                    }
+                }
+            }
+        }
+        let rows = records(&session);
+        assert_eq!(
+            rows.iter()
+                .find(|row| row["type"] == "tool_result")
+                .unwrap()["status"],
+            expected
+        );
+    }
+}
