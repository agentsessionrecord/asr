diff --git a/crates/goose/tests/agent_session_export.rs b/crates/goose/tests/agent_session_export.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3d3029d354ed942a4791730f19582a0bbc108525
--- /dev/null
+++ b/crates/goose/tests/agent_session_export.rs
@@ -0,0 +1,201 @@
+use goose::conversation::message::{Message, MessageContent};
+use goose::permission::Permission;
+use goose::session::{export_session_to_agent_session, Session};
+use serde_json::{json, Value};
+
+fn fixture() -> Session {
+    serde_json::from_str(include_str!("fixtures/agent_session/session.json")).unwrap()
+}
+
+fn records(session: &Session) -> Vec<Value> {
+    export_session_to_agent_session(session, "synthetic-installation")
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect()
+}
+
+#[test]
+fn preserves_order_folds_results_and_keeps_explicit_approval() {
+    let session = fixture();
+    let rows = records(&session);
+    assert_eq!(rows[0]["sessionId"], session.id);
+    assert_eq!(rows[0]["producer"]["method"], "native");
+    assert_eq!(rows[1]["id"], "prompt");
+    assert_eq!(rows[1]["content"][0]["text"], "Read fixture.txt.\n");
+    assert!(rows[1].get("author").is_none());
+    assert!(rows[0].get("endedAt").is_none());
+    assert_eq!(rows[3]["type"], "tool_call");
+    assert_eq!(rows[3]["input"]["nativeCounter"], "9007199254740993");
+    assert!(rows[3].get("requestedBy").is_none());
+    assert_eq!(rows[4]["type"], "gap");
+    assert_eq!(rows[5]["type"], "approval");
+    assert_eq!(rows[5]["decision"], "approved");
+    assert_eq!(rows[5]["scope"], "once");
+    assert_eq!(rows[6]["type"], "tool_result");
+    assert_eq!(rows[6]["content"][0]["text"], "sample\n");
+    assert_eq!(
+        rows[7]["content"][0],
+        json!({"type":"reasoning","visibility":"encrypted"})
+    );
+    assert!(rows[1]["ts"].as_str().unwrap() > rows[2]["ts"].as_str().unwrap());
+    assert_eq!(rows, records(&session));
+    let mut retained = session.clone();
+    retained
+        .conversation
+        .as_mut()
+        .unwrap()
+        .messages_mut()
+        .remove(0);
+    let after_removal = records(&retained);
+    assert_eq!(rows[3]["id"], after_removal[2]["id"]);
+}
