+#[tokio::test]
+async fn storage_export_keeps_insertion_order_when_clocks_regress() {
+    use goose::config::GooseMode;
+    use goose::session::{SessionManager, SessionType};
+    let directory = tempfile::tempdir().unwrap();
+    let manager = SessionManager::new(directory.path().to_path_buf());
+    let session = manager
+        .create_session(
+            directory.path().to_path_buf(),
+            "Synthetic".into(),
+            SessionType::User,
+            GooseMode::Auto,
+        )
+        .await
+        .unwrap();
+    let mut first = Message::user().with_text("first");
+    first.created = 10;
+    let mut second = Message::assistant()
+        .with_text("second")
+        .with_visibility(false, true);
+    second.created = 9;
+    manager.add_message(&session.id, &first).await.unwrap();
+    manager.add_message(&session.id, &second).await.unwrap();
+    let database = directory.path().join("sessions/sessions.db");
+    let pool = sqlx::SqlitePool::connect(&format!("sqlite://{}", database.display()))
+        .await
+        .unwrap();
+    sqlx::query(
+        "UPDATE messages SET created_timestamp = 9 WHERE session_id = ? AND role = 'assistant'",
+    )
+    .bind(&session.id)
+    .execute(&pool)
+    .await
+    .unwrap();
+    pool.close().await;
+    let loaded = manager
+        .get_session_for_agent_session_export(&session.id)
+        .await
+        .unwrap();
+    let rows = records(&loaded);
+    assert_eq!(rows[1]["content"][0]["text"], "first");
+    assert_eq!(rows[2]["content"][0]["text"], "second");
+    assert!(rows[1]["ts"].as_str().unwrap() > rows[2]["ts"].as_str().unwrap());
+    assert_eq!(rows[2]["_meta"]["com.block.goose"]["userVisible"], false);
+}
