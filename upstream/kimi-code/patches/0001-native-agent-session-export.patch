+describe('Agent Session Record export', () => {
+  it('keeps native order, exact text, final results, and excludes opaque reasoning', () => {
+    const source = [
+      { type: 'metadata', protocol_version: '1.5', created_at: 1 },
+      { type: 'context.append_message', message: { role: 'user', origin: { kind: 'user' }, content: [{ type: 'text', text: 'Exact\r\n' }] } },
+      { type: 'context.append_loop_event', event: { type: 'tool.call', toolCallId: 'c', name: 'read', args: { path: 'fixture.txt' } } },
+      { type: 'context.append_loop_event', event: { type: 'tool.result', toolCallId: 'c', result: { output: 'old', isError: false } } },
+      { type: 'context.append_loop_event', event: { type: 'content.part', part: { type: 'think', think: '', encrypted: 'SYNTHETIC-OPAQUE' } } },
+      { type: 'context.append_loop_event', event: { type: 'tool.result', toolCallId: 'c', result: { output: 'new', isError: true } } },
+    ].map(row => JSON.stringify(row)).join('\n') + '\n';
+    const output = formatAgentSession(source, 'synthetic');
+    expect(output).not.toContain('SYNTHETIC-OPAQUE');
+    const rows = output.trimEnd().split('\n').map(line => JSON.parse(line));
+    expect(rows[1].content).toEqual([{ type: 'text', text: 'Exact\r\n' }]);
+    expect(rows[1].author).toBe('human');
+    expect(rows.filter(row => row.type === 'tool_result')).toHaveLength(1);
+    expect(rows.at(-1).status).toBe('failed');
+    expect(formatAgentSession(source, 'synthetic')).toBe(output);
