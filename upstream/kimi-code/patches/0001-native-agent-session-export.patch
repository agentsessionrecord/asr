new file mode 100644
index 000000000..ce8772186
--- /dev/null
+++ b/packages/agent-core-v2/src/app/sessionExport/agent-session.ts
@@ -0,0 +1,175 @@
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+type Row = Record<string, unknown>;
+
+export async function readAgentSession(sessionDir: string, sessionId: string): Promise<string> {
+  const source = await readFile(join(sessionDir, 'agents', 'main', 'wire.jsonl'), 'utf8');
+  return formatAgentSession(source, sessionId);
+}
+
+export function formatAgentSession(source: string, sessionId: string): string {
+  if (!sessionId) throw new Error('Session ID is required');
+  const lines = source.split('\n');
+  const first: unknown = JSON.parse(lines[0] ?? '');
+  const metadata = object(first);
+  if (metadata?.['type'] !== 'metadata') {
+    throw new Error('Wire metadata is required');
+  }
+  if (metadata['protocol_version'] !== '1.5') {
+    throw new Error('Unsupported wire protocol version');
+  }
+  const header: Row = {
+    type: 'session', id: 'header', formatVersion: '0.1',
+    agent: { name: 'kimi-code' }, sessionId,
+    producer: { name: 'kimi-code-asr-export', version: '1', method: 'native', source: 'kimi-code-wire' },
+    missing: ['usage', 'model', 'approvals', 'agent_settings', 'tools', 'file_changes', 'commits',
+      'subagents', 'copies', 'media', 'provider_state', 'native_events', 'message_author', 'reasoning', 'tool_result_updates'],
+  };
+  const created = metadata['created_at'];
+  if (typeof created === 'number' && Number.isFinite(created)) {
+    const date = new Date(created);
+    if (!Number.isNaN(date.getTime())) header['startedAt'] = date.toISOString();
+  }
+  const rows: (Row | undefined)[] = [header];
+  const nativeIds = new Map<string, string>();
+  const counts = new Map<string, number>();
+  for (let index = 1; index < lines.length - 1; index++) {
+    try {
+      const record = object(JSON.parse(lines[index]!) as unknown);
+      const candidate = record?.['type'] === 'context.append_message'
+        ? object(record['message'])?.['id'] : object(record?.['event'])?.['uuid'];
+      if (typeof candidate === 'string' && candidate.length > 0 && candidate.length <= 256
+        && candidate !== 'header' && !/[\u0000-\u001f\u007f-\u009f]/u.test(candidate)) {
+        nativeIds.set(`wire-${index + 1}`, candidate);
+        counts.set(candidate, (counts.get(candidate) ?? 0) + 1);
+      }
+    } catch {}
+  }
+  const results = new Map<string, number>();
+  const emit = (row: Row, id: string, time: unknown): void => {
+    const candidate = nativeIds.get(id);
+    if (candidate !== undefined && counts.get(candidate) === 1) row['id'] = candidate;
+    else {
+      while (counts.has(id)) id += '-derived';
+      row['id'] = id;
+    }
+    if (typeof time === 'number' && Number.isFinite(time)) {
+      const date = new Date(time);
+      if (!Number.isNaN(date.getTime())) row['ts'] = date.toISOString();
+    }
+    if (row['type'] === 'tool_result' && typeof row['callId'] === 'string') {
+      const previous = results.get(row['callId']);
+      if (previous !== undefined) rows[previous] = undefined;
+      results.set(row['callId'], rows.length);
+    }
+    rows.push(row);
+  };
+  for (let index = 1; index < lines.length; index++) {
+    const line = lines[index]!;
+    if (index === lines.length - 1 && line === '') continue;
+    const id = `wire-${index + 1}`;
+    if (index === lines.length - 1) {
+      emit({ type: 'gap', reason: 'not_retained', detail: 'Incomplete native journal tail.' }, id, undefined);
+      continue;
+    }
+    let value: unknown;
+    try {
+      value = JSON.parse(line, (_key: string, item: unknown, context?: { source: string }) => {
+        if (typeof item === 'number' && Number.isInteger(item) && !Number.isSafeInteger(item)) {
+          if (context === undefined) throw new Error('Lossless JSON parsing is unavailable');
+          return context.source;
+        }
+        return item;
+      }) as unknown;
+    } catch {
+      emit({ type: 'gap', reason: 'unparseable', count: 1 }, id, undefined);
+      continue;
+    }
+    const record = object(value);
+    if (record === undefined || typeof record['type'] !== 'string') {
+      emit({ type: 'gap', reason: 'unparseable', count: 1 }, id, undefined);
+      continue;
+    }
+    const message = object(record['message']);
+    if (record['type'] === 'context.apply_compaction') {
+      const summary = record['summary'] ?? record['contextSummary'];
+      const content = typeof summary === 'string' ? [{ type: 'text', text: summary }] : parts(object(summary)?.['content']);
+      emit({ type: 'message', role: 'user', author: 'harness', origin: 'compaction', content }, id, record['time']);
+      continue;
+    }
+    if (record['type'] === 'context.append_message' && message === undefined) {
+      emit({ type: 'gap', reason: 'unparseable', count: 1 }, id, record['time']);
+      continue;
+    }
+    if (record['type'] === 'context.append_message' && message !== undefined) {
+      const role = message['role'];
+      if (role === 'tool') {
+        emit({ type: 'tool_result', callId: message['toolCallId'],
+          status: status(message['isError']), content: parts(message['content']) }, id, record['time']);
+      } else if (role === 'user' || role === 'assistant' || role === 'system') {
+        const origin = object(message['origin'])?.['kind'];
+        const row: Row = { type: 'message', role, content: parts(message['content']) };
+        if (role === 'assistant') row['author'] = 'model';
+        if (role === 'system') Object.assign(row, { author: 'harness', origin: 'instructions' });
+        if (origin === 'user') Object.assign(row, { author: 'human', origin: 'prompt' });
+        if (origin === 'injection') Object.assign(row, { author: 'harness', origin: 'injected' });
+        if (origin === 'compaction_summary') Object.assign(row, { author: 'harness', origin: 'compaction' });
+        emit(row, id, record['time']);
+        const calls = message['toolCalls'];
+        if (Array.isArray(calls)) calls.forEach((call: unknown, part: number) => {
+          const item = object(call);
+          if (typeof item?.['id'] !== 'string' || !item['id'] || typeof item['name'] !== 'string' || !item['name']) return;
+          emit({ type: 'tool_call', callId: item['id'], name: item['name'], inputText: typeof item['arguments'] === 'string' ? item['arguments'] : undefined },
+            `${id}-call-${part}`, record['time']);
+        });
+      }
+      continue;
+    }
+    if (record['type'] !== 'context.append_loop_event') continue;
+    const event = object(record['event']);
+    if (event === undefined) { emit({ type: 'gap', reason: 'unparseable', count: 1 }, id, record['time']); continue; }
+    switch (event['type']) {
+      case 'content.part':
+        emit({ type: 'message', role: 'assistant', author: 'model', content: parts([event['part']]) }, id, record['time']);
+        break;
+      case 'tool.call':
+        if (typeof event['toolCallId'] !== 'string' || !event['toolCallId']) throw new Error('Missing tool call ID');
+        if (typeof event['name'] !== 'string' || !event['name']) throw new Error('Missing tool name');
+        emit({ type: 'tool_call', callId: event['toolCallId'], name: event['name'], input: event['args'], requestedBy: 'model' }, id, record['time']);
+        break;
+      case 'tool.result': {
+        const result = object(event['result']);
+        if (result === undefined) throw new Error('Missing tool result');
+        const output = result['output'];
+        emit({ type: 'tool_result', callId: event['toolCallId'], status: status(result['isError']),
+          content: typeof output === 'string' ? [{ type: 'text', text: output }] : parts(output) }, id, record['time']);
+        break;
+      }
+    }
+  }
+  return rows.filter(row => row !== undefined).map(row => JSON.stringify(row)).join('\n') + '\n';
+}
+
+function object(value: unknown): Row | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Row : undefined;
+}
+
+function status(error: unknown): string {
+  return error === true ? 'failed' : error === false ? 'completed' : 'unknown';
+}
+
+function parts(value: unknown): Row[] {
+  if (!Array.isArray(value)) return [];
+  return value.flatMap((item: unknown): Row[] => {
+    const part = object(item);
+    if (part?.['type'] === 'text' && typeof part['text'] === 'string') return [{ type: 'text', text: part['text'] }];
+    if (part?.['type'] === 'think') {
+      const result: Row[] = [];
+      if (typeof part['think'] === 'string' && part['think'] !== '') result.push({ type: 'reasoning', text: part['think'] });
+      if (typeof part['encrypted'] === 'string' && part['encrypted'] !== '') result.push({ type: 'reasoning', visibility: 'encrypted' });
+      return result.length > 0 ? result : [{ type: 'reasoning', visibility: 'omitted' }];
+    }
+    return [];
+  });
+}
