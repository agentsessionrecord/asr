diff --git a/libs/code/tests/unit_tests/test_session_export.py b/libs/code/tests/unit_tests/test_session_export.py
new file mode 100644
index 00000000..73a50479
--- /dev/null
+++ b/libs/code/tests/unit_tests/test_session_export.py
@@ -0,0 +1,134 @@
+"""Native export behavior, independent of model services."""
+
+import json
+import sqlite3
+from contextlib import closing
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+import pytest
+from langchain_core.messages import AIMessage, HumanMessage, RemoveMessage, ToolMessage
+from langgraph.checkpoint.serde.jsonplus import JsonPlusSerializer
+
+from deepagents_code.session_export import export_threads, messages_to_asr
+
+
+def test_order_updates_and_unknown_authorship() -> None:
+    messages = [
+        HumanMessage(" exact\n", id="header"),
+        AIMessage("partial", id="reply"),
+        HumanMessage("notice", id="notice"),
+        AIMessage("final", id="reply"),
+    ]
+    records = [
+        json.loads(line)
+        for line in messages_to_asr("synthetic-thread", messages).splitlines()
+    ]
+    assert [record["id"] for record in records[1:]] == ["header", "notice", "reply"]
+    assert records[1]["content"][0]["text"] == " exact\n"
+    assert "author" not in records[1]
+    assert "endedAt" not in records[0]
+
+
+def test_calls_results_removals_and_corruption() -> None:
+    messages = [
+        AIMessage(
+            "", tool_calls=[{"id": "call", "name": "echo", "args": {"n": 2**60}}]
+        ),
+        ToolMessage("old", tool_call_id="call"),
+        HumanMessage("between"),
+        ToolMessage("done", tool_call_id="call", status="error"),
+        HumanMessage("retained", id="gone"),
+        RemoveMessage(id="gone"),
+        None,
+    ]
+    records = [
+        json.loads(line)
+        for line in messages_to_asr("synthetic-thread", messages).splitlines()
+    ]
+    call = next(record for record in records if record["type"] == "tool_call")
+    assert call["input"]["n"] == str(2**60)
+    results = [record for record in records if record["type"] == "tool_result"]
+    assert len(results) == 1
+    assert results[0]["status"] == "failed"
+    assert (
+        next(record for record in records if record["id"] == "gone")["content"][0][
+            "text"
+        ]
+        == "retained"
+    )
+    assert [record["reason"] for record in records if record["type"] == "gap"] == [
+        "unparseable",
+    ]
+
+
+def test_excludes_secrets_and_provider_state() -> None:
+    message = AIMessage(
+        content=[
+            {"type": "text", "text": "password=synthetic-secret"},
+            {"type": "thinking", "thinking": "inspect", "signature": "opaque"},
+            {"type": "redacted_thinking", "data": "opaque"},
+        ]
+    )
+    stream = messages_to_asr("synthetic-thread", [message])
+    assert "synthetic-secret" not in stream
+    assert "opaque" not in stream
+    records = [json.loads(line) for line in stream.splitlines()]
+    assert records[1]["truncated"] is True
+    assert "secrets" in records[0]["missing"]
+    assert stream == messages_to_asr("synthetic-thread", [message])
+
+
+def test_derives_absent_call_identity() -> None:
+    message = AIMessage(
+        "", tool_calls=[{"id": None, "name": "echo", "args": {"text": "ready"}}]
+    )
+    records = [
+        json.loads(line)
+        for line in messages_to_asr("synthetic-thread", [message]).splitlines()
+    ]
+    assert isinstance(records[2]["callId"], str)
+    assert "tool_call_ids" in records[0]["missing"]
+
+
+def test_readonly_database_and_safe_output(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    from deepagents_code import sessions
+
+    database = tmp_path / "sessions.db"
+    with closing(sqlite3.connect(database)) as connection:
+        connection.execute("CREATE TABLE checkpoints(thread_id TEXT)")
+        connection.execute(
+            "CREATE TABLE writes(thread_id TEXT, checkpoint_ns TEXT, "
+            "checkpoint_id TEXT, task_id TEXT, idx INTEGER, channel TEXT, "
+            "type TEXT, value BLOB)"
+        )
+        connection.execute("INSERT INTO checkpoints VALUES (?)", ("../../synthetic",))
+        kind, blob = JsonPlusSerializer().dumps_typed(
+            [HumanMessage("hello", id="prompt")]
+        )
+        connection.execute(
+            "INSERT INTO writes VALUES (?, '', '1', 't', 0, 'messages', ?, ?)",
+            ("../../synthetic", kind, blob),
+        )
+        connection.commit()
+    monkeypatch.setattr(sessions, "get_db_path", lambda: database)
+    before = database.read_bytes()
+    export_threads(["../../synthetic"], None)
+    assert (
+        json.loads(capsys.readouterr().out.splitlines()[0])["sessionId"]
+        == "../../synthetic"
+    )
+    output = tmp_path / "out"
+    export_threads(["../../synthetic"], output)
+    assert len(list(output.glob("*.jsonl"))) == 1
+    assert database.read_bytes() == before
+    with pytest.raises(FileExistsError):
+        export_threads(["../../synthetic"], output)
+    with pytest.raises(ValueError, match="unavailable"):
+        export_threads(["absent"], None)
+    with pytest.raises(ValueError, match="exactly one"):
+        export_threads([], None)
