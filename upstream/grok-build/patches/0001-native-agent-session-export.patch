         }
@@ -54,6 +65,7 @@ impl EventWriter {
         Self {
             inner: Arc::new(EventWriterInner {
                 file: Mutex::new(None),
+                agent_session: Mutex::new(None),
                 error_logged: AtomicBool::new(true), // True from the start, so this writer never warns
             }),
         }
@@ -78,6 +90,13 @@ impl EventWriter {
         {
             tracing::warn!(error = %e, "{EVENTS_FILE} write failed");
         }
+        if let Ok(mut asr) = self.inner.agent_session.lock()
+            && let Some(writer) = asr.as_mut()
+            && let Err(error) = writer.emit(&entry.event, &entry.ts)
+        {
+            tracing::warn!(%error, "agent-session export stopped");
+            *asr = None;
+        }
     }
 }
 
