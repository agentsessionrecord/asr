+    pub(crate) fn open_internal(session_dir: &Path, export_asr: bool) -> Self {
         let path = session_dir.join(EVENTS_FILE);
         let file = std::fs::OpenOptions::new()
             .create(true)
@@ -45,6 +53,9 @@ impl EventWriter {
         Self {
             inner: Arc::new(EventWriterInner {
                 file: Mutex::new(file),
+                agent_session: Mutex::new(
+                    export_asr.then(|| crate::agent_session::AgentSessionWriter::new(session_dir)),
