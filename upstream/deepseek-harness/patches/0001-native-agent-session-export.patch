+### Agent Session Record 导出
+
+经过认证的客户端可以请求 `GET /api/session.agent-session?sessionId=<id>`，下载 `agent-session.jsonl`。`HEAD` 执行相同的会话读取，但不返回正文。查询无效时返回 400，会话不存在时返回 404，读取失败时返回经过清理的 500。
+
+原生导出器通过 `sessionQuery.readSession` 读取完整的已提交快照。它保留文本、可读推理、system 与 developer 指令、工具调用、最终工具结果和标题观察。继承前缀缺少原始 ASR 记录身份，因此表示为 gap。附件、不透明的 provider 状态、未稳定的尝试、审批和推理计量会声明为缺失。不运行模型轮次，也不修改会话数据。完整的 JSON Lines 正文缓冲在内存中。
+
+后端调用方也可以使用纯 `formatAgentSession(session, events, inheritedEventCount)` 格式化器。传入选中的原生 Header 及其按序排列的逻辑事件。继承事件数量用于避免重复计入共享前缀。
+
 ### 何时选择
 
 为需要面向用户的会话导出——复制可读的 Markdown 记录与下载 ZIP 归档——的 Web 部署选择它，也适用于已经持有完整已提交逻辑事件快照并需要相同 Markdown 转换的后端调用方。仅需 Host 路径写入时避免使用：浏览器操作把结果留在浏览器中，转换工具不执行 IO。日志从持久化读句柄序列化而来，因此任何已挂载后端都受支持。
diff --git a/packages/session-query/session-log-export/src/agent-session.ts b/packages/session-query/session-log-export/src/agent-session.ts
new file mode 100644
index 00000000..29433a17
--- /dev/null
+++ b/packages/session-query/session-log-export/src/agent-session.ts
@@ -0,0 +1,123 @@
+/** Native ASR projection of a detached, validated Session log observation. */
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+
+type Row = Record<string, unknown>
+
+/**
+ * Export original events in source order without loading an Agent or provider.
+ * @param session - Header from the same query observation as the events.
+ * @param events - Complete validated logical log, including inherited events.
+ * @param inheritedEventCount - Number of copied prefix events to exclude from credit.
+ * @returns One complete ASR JSON Lines stream.
+ */
+export function formatAgentSession(
+  session: SessionHeader,
+  events: readonly SessionEvent[],
+  inheritedEventCount: number,
+): string {
+  if (!session.id || !Number.isSafeInteger(inheritedEventCount)
+    || inheritedEventCount < 0 || inheritedEventCount > events.length) {
+    throw new Error('Invalid Session observation')
+  }
+  const header: Row = {
+    type: 'session', id: 'header', formatVersion: '0.1',
+    agent: { name: 'deepseek-harness' }, sessionId: session.id,
+    producer: { name: 'deepseek-harness-asr', version: '1', method: 'native', source: 'session-query-log' },
+    missing: ['copies', 'usage', 'model', 'approvals', 'agent_settings', 'tools',
+      'file_changes', 'commits', 'subagents', 'media', 'native_events', 'message_author', 'reasoning'],
+  }
+  const rows: Row[] = [header]
+  if (session.cwd !== undefined) header['cwd'] = session.cwd
+  const startedAt = timestamp(session.createdAt)
+  if (startedAt !== undefined) header['startedAt'] = startedAt
+  if (inheritedEventCount > 0) rows.push({
+    type: 'gap', id: 'inherited', reason: 'not_recorded', count: inheritedEventCount,
+    detail: 'Fork-inherited events are excluded because their original ASR record identities are unavailable.',
+  })
+  const results = new Map<string, number>()
+  for (const event of events.slice(inheritedEventCount)) {
+    let row: Row | undefined
+    switch (event.type) {
+      case 'user/message':
+        row = { type: 'message', role: 'user', content: parts(event.data.content) }
+        if (event.data.source.kind !== 'user') Object.assign(row, { author: 'harness', origin: 'injected' })
+        break
+      case 'system/message':
+      case 'developer/message':
+        row = { type: 'message', role: event.data.message.role, author: 'harness', origin: 'instructions',
+          content: parts(event.data.message.content) }
+        break
+      case 'assistant/message':
+        row = { type: 'message', role: 'assistant', author: 'model', content: parts(event.data.message.content) }
+        if (event.data.interrupted) row['truncated'] = true
+        break
+      case 'tool/call':
+        row = { type: 'tool_call', callId: event.data.callId, name: event.data.name,
+          ...argumentsValue(event.data.arguments), requestedBy: 'model' }
+        break
+      case 'tool/result': {
+        const message = event.data.message
+        const callId = message.source.callId
+        const previous = results.get(callId)
+        if (previous !== undefined) rows[previous] = { type: 'session_info', id: rows[previous]?.['id'], missing: ['tool_result_updates'] }
+        results.set(callId, rows.length)
+        row = { type: 'tool_result', callId, status: message.isError ? 'failed' : 'completed', content: parts(message.content) }
+        break
+      }
+      case 'assistant/attempt':
+        row = { type: 'gap', reason: 'not_recorded', detail: 'An unsettled model attempt is not normalized.' }
+        break
+      case 'session/title':
+        row = { type: 'session_info', title: event.data.title }
+        break
+      default:
+        // SessionEventMap is merge-extensible. Unknown event payloads stay private.
+        break
+    }
+    if (row !== undefined) {
+      const content = event.type === 'user/message' ? event.data.content
+        : event.type === 'assistant/message' || event.type === 'system/message' || event.type === 'developer/message' || event.type === 'tool/result'
+          ? event.data.message.content : undefined
+      if (content?.some(part => part.type !== 'text' && part.type !== 'reasoning')) row['truncated'] = true
+      row['id'] = `event-${event.seq}`
+      const ts = timestamp(event.time)
+      if (ts !== undefined) row['ts'] = ts
+      rows.push(row)
+    }
+  }
+  return `${rows.map(row => JSON.stringify(row)).join('\n')}\n`
+}
+
+function argumentsValue(text: string): Row {
+  try {
+    return { input: JSON.parse(text, (_key: string, value: unknown, context?: { source: string }) => {
+      if (typeof value === 'number' && Number.isInteger(value) && !Number.isSafeInteger(value)) {
+        if (context === undefined) throw new Error('Lossless JSON parsing is unavailable')
+        return context.source
+      }
+      return value
+    }) as unknown }
+  } catch {
+    return { inputText: text }
+  }
+}
+
+function parts(content: readonly { type: string; text?: string }[]): Row[] {
+  return content.flatMap((part) => {
+    if (part.type === 'text') return [{ type: 'text', text: part.text }]
+    if (part.type === 'reasoning') return [asrReasoning(part.text, false)]
+    return []
+  })
+}
+
+function timestamp(value: number): string | undefined {
+  if (!Number.isSafeInteger(value)) return undefined
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? undefined : date.toISOString()
+}
+
+function asrReasoning(text: unknown, summary = false): { type: string; visibility?: string; text?: string; summary?: string[] } {
+  if (typeof text !== "string" || text.length === 0) return { type: "reasoning", visibility: "omitted" };
+  if (summary) return { type: "reasoning", visibility: "summary", summary: [text] };
+  return { type: "reasoning", text };
+}
