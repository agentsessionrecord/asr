+/**
+ * Read one detached native snapshot through the authenticated Host connection.
+ * @param context - Host context carrying the session-query service.
+ * @param request - Request with a required sessionId query parameter.
+ * @returns A JSON Lines download, or an opaque preparation failure.
+ */
+async function sessionAgentRecordResponse(context: Context, request: Request): Promise<Response> {
+  const value = new URL(request.url).searchParams.get('sessionId')
+  if (!value) return new Response('missing or invalid sessionId query parameter', { status: 400 })
+  const query = context.get('sessionQuery')
+  if (!query) return new Response('session export is unavailable', { status: 500 })
+  try {
+    request.signal.throwIfAborted()
+    const snapshot = await query.readSession(brandString<SessionId>(value))
+    request.signal.throwIfAborted()
+    return new Response(formatAgentSession(snapshot.session, snapshot.events, snapshot.inheritedEventCount), {
+      headers: { 'content-type': 'application/x-ndjson; charset=utf-8',
+        'content-disposition': 'attachment; filename="agent-session.jsonl"', 'cache-control': 'no-store' },
+    })
+  } catch (error: unknown) {
+    request.signal.throwIfAborted()
+    return new Response(isSessionNotFound(error) ? 'session not found' : 'session export failed', {
+      status: isSessionNotFound(error) ? 404 : 500,
+    })
+  }
+}
+
 function connectionOf(ctx: Context): SessionLogConnection {
   return Reflect.get(ctx, 'connection') as SessionLogConnection
 }
