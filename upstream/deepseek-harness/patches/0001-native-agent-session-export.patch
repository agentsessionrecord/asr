@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createUserMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import { formatAgentSession } from '../src/agent-session.ts'
+
+describe('native Agent Session Record export', () => {
+  it('preserves exact text, final results, large arguments and unknown author', () => {
+    const session = Session.create(SessionId('synthetic'))
+    session.append('user/message', createUserMessage({ source: { kind: 'user' },
+      content: [{ type: 'text', text: 'Exact\r\n' }] }), { surfaceOp: 'append' })
+    session.append('tool/call', { turn: 1, step: 1, callId: ToolCallId('c'), name: 'read', arguments: '{"n":9007199254740993}' })
+    for (const text of ['old', 'new\n']) session.append('tool/result', {
+      turn: 1, step: 1, message: createToolResultMessage({ callId: ToolCallId('c'), content: [{ type: 'text', text }], isError: false }),
+    }, { surfaceOp: 'append' })
+    const source = session.snapshotEvents()
+    const output = formatAgentSession(session.header, source, 0)
+    const rows = output.trimEnd().split('\n').map(line => JSON.parse(line) as Record<string, unknown>)
+    expect(rows[1]?.['content']).toEqual([{ type: 'text', text: 'Exact\r\n' }])
+    expect(rows[1]?.['author']).toBeUndefined()
+    expect(rows.find(row => row['type'] === 'tool_call')?.['input']).toEqual({ n: '9007199254740993' })
+    expect(rows.filter(row => row['type'] === 'tool_result')).toHaveLength(1)
+    expect(rows.at(-1)?.['content']).toEqual([{ type: 'text', text: 'new\n' }])
+    expect(formatAgentSession(session.header, source, 0)).toBe(output)
+    const copied = formatAgentSession(session.header, source, source.length)
+    expect(copied).not.toContain('Exact')
+    expect(JSON.parse(copied.trimEnd().split('\n')[1] ?? '{}') as unknown).toMatchObject({ count: source.length })
+    expect(() => formatAgentSession(session.header, source, -1)).toThrow()
+  })
+})
