{
  "name": "dsh-plugin-asr-export",
  "version": "0.1.0",
  "description": "Unofficial Agent Session Record export for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "dsh-plugin",
    "agent-session-record",
    "unofficial"
  ],
  "engines": {
    "node": ">=24.15.0",
    "dsh": "0.2.2-alpha.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test.mjs",
    "lint": "oxlint --type-aware index.ts format.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
