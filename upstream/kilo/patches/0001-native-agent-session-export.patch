diff --git a/packages/opencode/src/kilocode/agent-session-v2.ts b/packages/opencode/src/kilocode/agent-session-v2.ts
new file mode 100644
index 0000000000..4f26c9f16b
--- /dev/null
+++ b/packages/opencode/src/kilocode/agent-session-v2.ts
@@ -0,0 +1,170 @@
+import { SessionEvent } from "@opencode-ai/schema/session-event"
+import { Schema } from "effect"
+
+type Row = { id: string; type: string; data: string }
+type Record = { type: string; [key: string]: unknown }
+
+export function project(
+  session: string,
+  rows: readonly Row[],
+  add: (row: Row, record: Record) => unknown,
+  missing: Set<string>,
+) {
+  const steps = new Map<string, { id: string; model: { id: string; providerID: string } }>()
+  const linked = new Set<string>()
+  const results = new Set<string>()
+  const output: { row: Row; record: Record }[] = []
+  const emit = (row: Row, record: Record) => output.push({ row, record })
+  for (const row of rows) {
+    if (!row.type.startsWith("session.next.")) continue
+    missing.add("tool_output")
+    missing.add("native_metadata")
+    try {
+      const event = Schema.decodeUnknownSync(Schema.toEncoded(SessionEvent.Durable))({
+        id: row.id,
+        type: row.type.replace(/\.\d+$/, ""),
+        data: JSON.parse(row.data, (_key, value: unknown, context?: { source: string }) => {
+          if (typeof value === "number" && Number.isInteger(value) && !Number.isSafeInteger(value))
+            return context!.source
+          return value
+        }),
+      })
+      if (event.data.sessionID !== session) throw new Error("Mismatched session identity")
+      const base = { ts: new Date(event.data.timestamp).toISOString() }
+      switch (event.type) {
+        case "session.next.agent.switched":
+          emit(row, { type: "session_info", ...base, agentSettings: { mode: event.data.agent } })
+          break
+        case "session.next.prompted":
+          emit(row, {
+            type: "message",
+            ...base,
+            role: "user",
+            content: [{ type: "text", text: event.data.prompt.text }],
+          })
+          break
+        case "session.next.synthetic":
+        case "session.next.context.updated":
+          emit(row, {
+            type: "message",
+            ...base,
+            role: "system",
+            author: "harness",
+            origin: "instructions",
+            content: [{ type: "text", text: event.data.text }],
+          })
+          break
+        case "session.next.step.started":
+          steps.set(event.data.assistantMessageID, { id: event.id, model: event.data.model })
+          break
+        case "session.next.text.ended":
+        case "session.next.reasoning.ended":
+          emit(row, {
+            type: "message",
+            ...base,
+            role: "assistant",
+            author: "model",
+            inferenceId: steps.get(event.data.assistantMessageID)?.id,
+            content: [
+              event.type === "session.next.text.ended"
+                ? { type: "text", text: event.data.text }
+                : event.data.text
+                  ? { type: "reasoning", text: event.data.text }
+                  : { type: "reasoning", visibility: "omitted" },
+            ],
+          })
+          break
+        case "session.next.tool.called":
+          emit(row, {
+            type: "tool_call",
+            ...base,
+            callId: event.data.callID,
+            name: event.data.tool,
+            input: event.data.input,
+            ...(event.data.provider.executed ? {} : { requestedBy: "model" }),
+            inferenceId: steps.get(event.data.assistantMessageID)?.id,
+          })
+          break
+        case "session.next.tool.success":
+        case "session.next.tool.failed": {
+          const callId = event.data.callID
+          const unique = !results.has(callId)
+          results.add(callId)
+          const success = event.type === "session.next.tool.success"
+          emit(row, {
+            type: "tool_result",
+            ...base,
+            ...(unique ? { callId } : {}),
+            status: success ? "completed" : "failed",
+            ...(event.type === "session.next.tool.success"
+              ? {
+                  content: event.data.content
+                    .filter((part) => part.type === "text")
+                    .map((part) => ({ type: "text", text: part.text })),
+                }
+              : { error: { message: event.data.error.message } }),
+          })
+          break
+        }
+        case "session.next.step.ended":
+        case "session.next.step.failed": {
+          const step = steps.get(event.data.assistantMessageID)
+          if (!step) {
+            emit(row, { type: "gap", ...base, reason: "not_retained", detail: "Model call start is unavailable" })
+            break
+          }
+          const { id, model } = step
+          const tokens = event.type === "session.next.step.ended" ? event.data.tokens : undefined
+          const usage = tokens && {
+            inputTokens: tokens.input + tokens.cache.read + tokens.cache.write,
+            outputTokens: tokens.output + tokens.reasoning,
+            reasoningTokens: tokens.reasoning,
+            cacheReadTokens: tokens.cache.read,
+            cacheWriteTokens: tokens.cache.write,
+          }
+          const safe = usage && Object.values(usage).every((value) => Number.isSafeInteger(value) && value >= 0)
+          emit(row, {
+            type: "inference",
+            id,
+            ...base,
+            model: { provider: model.providerID, requested: model.id },
+            ...(safe ? { usage } : {}),
+            ...(event.type === "session.next.step.ended"
+              ? { cost: { amount: event.data.cost, currency: "USD" }, stopReason: event.data.finish }
+              : { error: { message: event.data.error.message } }),
+          })
+          linked.add(id)
+          steps.delete(event.data.assistantMessageID)
+          break
+        }
+        case "session.next.compaction.ended":
+          emit(row, {
+            type: "message",
+            ...base,
+            role: "assistant",
+            author: "model",
+            origin: "compaction",
+            content: [{ type: "text", text: event.data.text }],
+          })
+          break
+        case "session.next.prompt.admitted":
+        case "session.next.text.started":
+        case "session.next.reasoning.started":
+        case "session.next.tool.input.started":
+        case "session.next.tool.input.ended":
+        case "session.next.tool.progress":
+          break
+        default:
+          emit(row, { type: "gap", ...base, reason: "not_recorded", detail: "Native event has no ASR mapping" })
+          missing.add("native_events")
+      }
+    } catch {
+      emit(row, { type: "gap", reason: "unparseable", count: 1, detail: "Native event could not be decoded" })
+      missing.add("corrupt_events")
+    }
+  }
+  for (const item of output) {
+    if (!linked.has(item.record.inferenceId as string)) delete item.record.inferenceId
+    add(item.row, item.record)
+  }
+}
diff --git a/packages/opencode/src/kilocode/agent-session.ts b/packages/opencode/src/kilocode/agent-session.ts
new file mode 100644
index 0000000000..c0d09c762a
--- /dev/null
+++ b/packages/opencode/src/kilocode/agent-session.ts
@@ -0,0 +1,386 @@
+import { project } from "./agent-session-v2"
+import { SessionV1 } from "@opencode-ai/schema/v1/session"
+import { PermissionV1 } from "@opencode-ai/schema/v1/permission"
+import { Schema } from "effect"
+import { Database } from "bun:sqlite"
+import { createHash } from "node:crypto"
+import fs from "node:fs/promises"
+import path from "node:path"
+
+type Row = { id: string; seq: number; type: string; data: string }
+type Record = { type: string; id: string; [key: string]: unknown }
+const digest = (id: string) => createHash("sha256").update(id).digest("hex")
+const stamp = (ms: number) => new Date(ms).toISOString()
+
+function clean(value: unknown, secrets: string[]): unknown {
+  if (typeof value === "string")
+    return secrets
+      .reduce((text, secret) => text.replaceAll(secret, "[redacted]"), value)
+      .replace(/\b(?:sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b/g, "[redacted]")
+      .replace(/\bBearer\s+[^\s"']+/gi, "Bearer [redacted]")
+      .replace(/-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----/g, "[redacted]")
+      .replace(/(https?:\/\/)[^\s/@]+:[^\s/@]+@/g, "$1[redacted]@")
+  if (Array.isArray(value)) return value.map((item) => clean(item, secrets))
+  if (value && typeof value === "object")
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [
+        key,
+        /^(?:password|authorization|(?:api|access|refresh|auth|secret)[_-]?(?:key|token))$/i.test(key)
+          ? "[redacted]"
+          : clean(item, secrets),
+      ]),
+    )
+  return value
+}
+
+function parse(text: string): unknown {
+  return JSON.parse(text, (_key: string, value: unknown, context?: { source: string }) =>
+    typeof value === "number" && Number.isInteger(value) && !Number.isSafeInteger(value) ? context!.source : value,
+  )
+}
+
+export function records(session: string, rows: readonly Row[], version: string, secrets: string[] = []) {
+  const created = rows.find((row) => row.type.replace(/\.\d+$/, "") === "session.created")
+  if (!created) throw new Error("Session creation history is unavailable")
+  const first = Schema.decodeUnknownSync(SessionV1.Event.Created.data)(parse(created.data)).info
+  if (first.id !== session) throw new Error("Session identity does not match its history")
+  const missing = new Set([
+    "approvals",
+    "agent_settings",
+    "tools",
+    "file_changes",
+    "commits",
+    "subagents",
+    "copies",
+    "provider_state",
+    "inference_settings",
+    "cost_provenance",
+    "usage",
+    "media",
+    "content_revisions",
+  ])
+  const output: Record[] = [
+    {
+      type: "session",
+      id: "header",
+      formatVersion: "0.1",
+      agent: { name: "kilo", version: first.version },
+      sessionId: session,
+      producer: { name: "kilo", version, method: "native", source: "kilo-sync-events" },
+      startedAt: stamp(first.time.created),
+      cwd: first.directory,
+      ...(first.parentID ? { _meta: { "ai.kilo": { parentSessionId: first.parentID } } } : {}),
+      missing: [],
+    },
+  ]
+  const messages = new Map<string, typeof SessionV1.Info.Type>()
+  const emitted = new Set<string>()
+  const calls = new Map<string, unknown>()
+  const results = new Set<string>()
+  const steps = new Map<string, string>()
+  const settings = new Map<string, string>()
+  const add = (row: Row, value: { type: string; [key: string]: unknown }, suffix = "") =>
+    output.push({ id: suffix ? `derived-${digest(row.id + suffix)}` : row.id, ...value })
+  const info = (row: Row, values: { mode?: string | null; approval?: unknown }, ts?: number) => {
+    const changed = Object.fromEntries(
+      Object.entries(values).filter(
+        ([key, value]) => value !== undefined && settings.get(key) !== JSON.stringify(value),
+      ),
+    )
+    if (!Object.keys(changed).length) return
+    for (const [key, value] of Object.entries(changed)) settings.set(key, JSON.stringify(value))
+    add(
+      row,
+      { type: "session_info", ...(ts === undefined ? {} : { ts: stamp(ts) }), agentSettings: changed },
+      "settings",
+    )
+  }
+  info(created, { mode: first.agent, approval: first.permission }, first.time.created)
+  // Both durable families may occur in a session that spans the V2 migration.
+  // Core projects V2 events into message tables without emitting V1 events.
+  const projected = new Map<string, { type: string; [key: string]: unknown }[]>()
+  project(
+    session,
+    rows,
+    (row, record) => {
+      const values = projected.get(row.id) ?? []
+      values.push(record)
+      projected.set(row.id, values)
+    },
+    missing,
+  )
+  for (const row of rows) {
+    if (row.type.startsWith("session.next.")) {
+      for (const record of projected.get(row.id) ?? []) add(row, record)
+      continue
+    }
+    const type = row.type.replace(/\.\d+$/, "")
+    try {
+      const raw = parse(row.data)
+      // Preserve exact core counts before decoding the native numeric schema.
+      const exact = raw as {
+        part?: {
+          type?: string
+          tokens?: {
+            input: number | string
+            output: number | string
+            reasoning: number | string
+            cache: { read: number | string; write: number | string }
+          }
+          cost?: number | string
+        }
+      }
+      const counts = exact.part?.type === "step-finish" ? exact.part.tokens : undefined
+      const unsafe =
+        counts &&
+        [counts.input, counts.output, counts.reasoning, counts.cache.read, counts.cache.write].some(
+          (value) => typeof value === "string",
+        )
+      const decoded =
+        exact.part?.type === "step-finish"
+          ? {
+              ...exact,
+              part: {
+                ...exact.part,
+                ...(unsafe ? { tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } } } : {}),
+                ...(typeof exact.part.cost === "string" ? { cost: 0 } : {}),
+              },
+            }
+          : raw
+      if (type === "session.created") continue
+      if (type === "session.updated") {
+        const data = Schema.decodeUnknownSync(
+          Schema.Struct({
+            info: Schema.Struct({
+              agent: Schema.optional(Schema.NullOr(Schema.String)),
+              permission: Schema.optional(Schema.NullOr(PermissionV1.Ruleset)),
+            }),
+          }),
+        )(raw)
+        info(row, { mode: data.info.agent, approval: data.info.permission })
+        continue
+      }
+      if (type === "message.updated") {
+        const message = Schema.decodeUnknownSync(SessionV1.Event.MessageUpdated.data)(raw).info
+        messages.set(message.id, message)
+        info(row, { mode: message.agent }, message.time.created)
+        if (message.role === "user" && message.system !== undefined && !emitted.has(message.id)) {
+          add(row, {
+            type: "message",
+            ts: stamp(message.time.created),
+            role: "system",
+            author: "harness",
+            origin: "instructions",
+            content: [{ type: "text", text: message.system }],
+          })
+          emitted.add(message.id)
+        }
+        continue
+      }
+      if (type === "message.removed" || type === "message.part.removed") continue
+      if (type !== "message.part.updated") {
+        add(row, { type: "gap", reason: "not_recorded", detail: "Native event has no ASR mapping" })
+        missing.add("native_events")
+        continue
+      }
+      const data = Schema.decodeUnknownSync(SessionV1.Event.PartUpdated.data)(decoded)
+      const part = data.part
+      const message = messages.get(part.messageID)
+      const ts = stamp(data.time)
+      const inferenceId = steps.get(part.messageID)
+      const link = inferenceId ? { inferenceId } : {}
+      if (part.type === "step-start") {
+        steps.set(part.messageID, part.id)
+        continue
+      }
+      if (part.type === "text" || part.type === "reasoning") {
+        if (emitted.has(part.id)) continue
+        if (message?.role === "assistant" && part.time?.end === undefined) continue
+        if (!message) {
+          missing.add("message_context")
+          continue
+        }
+        emitted.add(part.id)
+        add(row, {
+          type: "message",
+          ts,
+          role: message.role,
+          ...link,
+          ...(message.role === "assistant"
+            ? { author: "model", ...(message.summary ? { origin: "compaction" } : {}) }
+            : {}),
+          ...(part.type === "text" && part.synthetic ? { author: "harness", origin: "injected" } : {}),
+          content: [part.type === "reasoning" ? asrReasoning(part.text, false) : { type: "text", text: part.text }],
+        })
+        continue
+      }
+      if (part.type === "tool") {
+        const state = part.state
+        if (state.status === "pending") continue
+        if (!calls.has(part.id)) {
+          calls.set(part.id, state.input)
+          add(
+            row,
+            {
+              type: "tool_call",
+              ts,
+              callId: part.callID,
+              name: part.tool,
+              input: state.input,
+              ...(message?.role === "assistant" ? { requestedBy: "model" } : {}),
+              ...link,
+            },
+            "call",
+          )
+        }
+        if ((state.status !== "completed" && state.status !== "error") || emitted.has(part.id)) continue
+        emitted.add(part.id)
+        const linked = !results.has(part.callID)
+        results.add(part.callID)
+        if (!linked) missing.add("ambiguous_calls")
+        const metadata = state.metadata
+        const approval = metadata?.approval as
+          | { source?: string; rule?: { action?: string }; outsideWorkspace?: boolean }
+          | undefined
+        if (approval?.rule?.action === "allow" || approval?.rule?.action === "deny")
+          add(
+            row,
+            {
+              type: "approval",
+              ...(linked ? { callId: part.callID } : { subject: part.tool }),
+              decision: approval.rule.action === "allow" ? "approved" : "denied",
+              by: "policy",
+              native: approval,
+            },
+            "approval",
+          )
+        const changed = JSON.stringify(calls.get(part.id)) !== JSON.stringify(state.input)
+        const compacted = state.status === "completed" && state.time.compacted !== undefined
+        add(row, {
+          type: "tool_result",
+          ts,
+          ...(linked ? { callId: part.callID } : {}),
+          status: state.status === "completed" ? "completed" : "failed",
+          ...(changed ? { input: state.input } : {}),
+          ...(state.status === "completed"
+            ? { content: [{ type: "text", text: state.output }] }
+            : { error: { message: state.error } }),
+          ...(compacted || metadata?.truncated === true ? { truncated: true } : {}),
+          ...(typeof metadata?.exit === "number" && Number.isSafeInteger(metadata.exit)
+            ? { exec: { exitCode: metadata.exit } }
+            : {}),
+          ...(state.time.end >= state.time.start ? { durationMs: state.time.end - state.time.start } : {}),
+        })
+        if (compacted || metadata?.truncated === true) missing.add("tool_output")
+        continue
+      }
+      if (part.type === "step-finish") {
+        if (emitted.has(part.id)) continue
+        emitted.add(part.id)
+        const tokens = part.tokens
+        const usage = {
+          inputTokens: tokens.input + tokens.cache.read + tokens.cache.write,
+          outputTokens: tokens.output + tokens.reasoning,
+          cacheReadTokens: tokens.cache.read,
+          cacheWriteTokens: tokens.cache.write,
+          reasoningTokens: tokens.reasoning,
+        }
+        const model =
+          part.model ??
+          (message?.role === "assistant" ? { providerID: message.providerID, modelID: message.modelID } : undefined)
+        if (!model) missing.add("model")
+        const safe = !unsafe && Object.values(usage).every((count) => Number.isSafeInteger(count) && count >= 0)
+        output.push({
+          type: "inference",
+          id: inferenceId ?? part.id,
+          ts,
+          ...(model ? { model: { provider: model.providerID, requested: model.modelID } } : {}),
+          ...(safe ? { usage } : {}),
+          ...(typeof exact.part?.cost === "string" ? {} : { cost: { amount: part.cost, currency: "USD" } }),
+          stopReason: part.reason,
+          ...(!safe || part.generationID || typeof exact.part?.cost === "string"
+            ? {
+                _meta: {
+                  "ai.kilo": {
+                    ...(part.generationID ? { responseId: part.generationID } : {}),
+                    ...(!safe
+                      ? {
+                          tokens: counts,
+                          inputTokens: String(
+                            BigInt(counts!.input) + BigInt(counts!.cache.read) + BigInt(counts!.cache.write),
+                          ),
+                          outputTokens: String(BigInt(counts!.output) + BigInt(counts!.reasoning)),
+                        }
+                      : {}),
+                    ...(typeof exact.part?.cost === "string" ? { cost: exact.part.cost } : {}),
+                  },
+                },
+              }
+            : {}),
+        })
+        steps.delete(part.messageID)
+        continue
+      }
+      if (part.type === "file") {
+        missing.add("media")
+        continue
+      }
+    } catch {
+      add(row, { type: "gap", reason: "unparseable", count: 1, detail: "Native event could not be decoded" })
+      missing.add("corrupt_events")
+    }
+  }
+  if (steps.size) {
+    const unfinished = new Set(steps.values())
+    for (const record of output) if (unfinished.has(record.inferenceId as string)) delete record.inferenceId
+  }
+  if (new Set(output.map((record) => record.id)).size !== output.length) throw new Error("Duplicate native record IDs")
+  const safe = output.map((record) => {
+    const value = clean(record, secrets) as Record
+    if (JSON.stringify(value) !== JSON.stringify(record)) {
+      value.truncated = true
+      missing.add("secrets")
+    }
+    return value
+  })
+  safe[0]!.missing = [...missing].sort()
+  return safe
+}
+
+export async function write(input: { database: string; sessionID: string; output?: string; version: string }) {
+  using db = new Database(input.database, { readonly: true, strict: true, safeIntegers: true })
+  db.exec("BEGIN")
+  try {
+    const found = db.query<{ id: string }, [string]>("SELECT id FROM session WHERE id = ?").get(input.sessionID)
+    if (!found) throw new Error("Selected session is unavailable")
+    const rows = db
+      .query<Row, [string]>("SELECT id, type, data, seq FROM event WHERE aggregate_id = ? ORDER BY seq")
+      .all(input.sessionID)
+    const secrets = Object.entries(process.env).flatMap(([key, value]) =>
+      /(?:TOKEN|SECRET|PASSWORD|API_KEY)/i.test(key) && value && value.length >= 8 ? [value] : [],
+    )
+    const text =
+      records(input.sessionID, rows, input.version, secrets)
+        .map((record) => JSON.stringify(record))
+        .join("\n") + "\n"
+    if (input.output) {
+      await fs.mkdir(input.output, { mode: 0o700 })
+      await fs.writeFile(path.join(input.output, digest(input.sessionID) + ".jsonl"), text, {
+        mode: 0o600,
+        flag: "wx",
+      })
+    }
+    if (!input.output) process.stdout.write(text)
+  } finally {
+    db.exec("ROLLBACK")
+  }
+}
+
+function asrReasoning(
+  text: unknown,
+  summary = false,
+): { type: string; visibility?: string; text?: string; summary?: string[] } {
+  if (typeof text !== "string" || text.length === 0) return { type: "reasoning", visibility: "omitted" }
+  if (summary) return { type: "reasoning", visibility: "summary", summary: [text] }
+  return { type: "reasoning", text }
+}
diff --git a/packages/opencode/test/kilocode/agent-session.test.ts b/packages/opencode/test/kilocode/agent-session.test.ts
new file mode 100644
index 0000000000..fe431db7fe
--- /dev/null
+++ b/packages/opencode/test/kilocode/agent-session.test.ts
@@ -0,0 +1,124 @@
+import { expect, test } from "bun:test"
+import { records, write } from "../../src/kilocode/agent-session"
+import { Database } from "bun:sqlite"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+
+const rows = await Bun.file(path.join(import.meta.dir, "fixtures/agent-session/native.json")).json()
+
+test("preserves interleaving, snapshot approvals and effective rewritten input", () => {
+  const result = records("ses_synthetic", rows, "test")
+  expect(result.map((record) => record.type)).toEqual([
+    "session",
+    "session_info",
+    "session_info",
+    "message",
+    "tool_call",
+    "message",
+    "approval",
+    "tool_result",
+    "message",
+    "inference",
+    "session_info",
+  ])
+  expect(result.find((record) => record.type === "tool_result")?.input).toEqual({ path: "/work/demo/rewritten.txt" })
+  expect(result.find((record) => record.type === "approval")?.ts).toBeUndefined()
+  expect(result.find((record) => record.type === "approval")?.by).toBe("policy")
+  expect(result.find((record) => record.type === "inference")?.usage).toEqual({
+    inputTokens: 14,
+    outputTokens: 6,
+    reasoningTokens: 2,
+    cacheReadTokens: 3,
+    cacheWriteTokens: 1,
+  })
+  expect(result.at(-1)?.agentSettings).toEqual({ mode: null, approval: null })
+  expect(records("ses_synthetic", rows, "test")).toEqual(result)
+})
+
+test("keeps exact native integers, excludes secrets and declares corrupt rows", () => {
+  const input = structuredClone(rows)
+  input[5].data = input[5].data.replace(
+    '"path": "/work/demo/input.txt"',
+    '"count": 9007199254740993, "password": "synthetic-secret"',
+  )
+  input.push({ id: "evt_corrupt", seq: 20, type: "message.updated.1", data: "{" })
+  const result = records("ses_synthetic", input, "test")
+  expect(result.find((record) => record.type === "tool_call")?.input).toEqual({
+    count: "9007199254740993",
+    password: "[redacted]",
+  })
+  expect(result.at(-1)?.type).toBe("gap")
+  expect(result[0]?.missing).toContain("secrets")
+})
+
+test("never invents approval decisions from successful tools", () => {
+  const input = structuredClone(rows)
+  const data = JSON.parse(input[7].data)
+  delete data.part.state.metadata.approval
+  input[7].data = JSON.stringify(data)
+  expect(records("ses_synthetic", input, "test").some((record) => record.type === "approval")).toBe(false)
+})
+
+test("rejects unavailable history", () => {
+  expect(() => records("ses_missing", [], "test")).toThrow("creation history")
+})
+
+test("reads a consistent SQLite source without changing it and writes private files", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "asr-export-"))
+  try {
+    const file = path.join(root, "native.db")
+    {
+      using db = new Database(file)
+      db.exec(
+        "CREATE TABLE session (id TEXT, time_updated INTEGER); CREATE TABLE event (id TEXT, seq INTEGER, type TEXT, aggregate_id TEXT, data TEXT)",
+      )
+      db.query("INSERT INTO session VALUES (?, ?)").run("ses_synthetic", 1767225600010)
+      for (const row of rows)
+        db.query("INSERT INTO event VALUES (?, ?, ?, ?, ?)").run(row.id, row.seq, row.type, "ses_synthetic", row.data)
+    }
+    const before = await fs.readFile(file)
+    const output = path.join(root, "output")
+    await write({ database: file, sessionID: "ses_synthetic", output, version: "test" })
+    expect(await fs.readFile(file)).toEqual(before)
+    const files = await fs.readdir(output)
+    expect(files[0]).toMatch(/^[a-f0-9]{64}\.jsonl$/)
+    if (process.platform !== "win32") expect((await fs.stat(path.join(output, files[0]!))).mode & 0o777).toBe(0o600)
+    await expect(
+      write({ database: file, sessionID: "ses_missing", output: path.join(root, "absent"), version: "test" }),
+    ).rejects.toThrow("unavailable")
+  } finally {
+    await fs.rm(root, { recursive: true, force: true })
+  }
+})
+
+test("retains exact unsafe core counts outside numeric usage", () => {
+  const input = structuredClone(rows)
+  const finish = input.find((row: { data: string }) => row.data.includes('"step-finish"'))!
+  finish.data = finish.data.replace('"input": 10', '"input": 9007199254740993')
+  const inference = records("ses_synthetic", input, "test").find((record) => record.type === "inference")!
+  expect(inference.usage).toBeUndefined()
+  expect(inference._meta).toMatchObject({
+    "ai.kilo": { tokens: { input: "9007199254740993" }, inputTokens: "9007199254740997" },
+  })
+})
+
+test("exports V2 durable history with retained legacy events", async () => {
+  const current = await Bun.file(path.join(import.meta.dir, "fixtures/agent-session/v2.json")).json()
+  const result = records("ses_synthetic", current, "test")
+  expect(result.find((record) => record.type === "tool_call")?.callId).toBe("read-1")
+  expect(result.find((record) => record.type === "tool_call")?.inferenceId).toBe(
+    result.find((record) => record.type === "inference")?.id,
+  )
+  expect(result.find((record) => record.type === "tool_result")?.content).toEqual([
+    { type: "text", text: "synthetic\n" },
+  ])
+  expect(result.find((record) => record.type === "inference")?.usage).toMatchObject({
+    inputTokens: 14,
+    outputTokens: 6,
+  })
+  expect(result.filter((record) => record.type === "inference")).toHaveLength(1)
+  expect(result.some((record) => record.type === "gap")).toBe(false)
+  const mixed = records("ses_synthetic", [...current, ...rows.slice(1)], "test")
+  expect(mixed.filter((record) => record.type === "inference")).toHaveLength(2)
+})
