--- /dev/null
+++ b/packages/opencode/src/kilocode/cli/cmd/agent-session.ts
@@ -0,0 +1,35 @@
+import { cmd } from "@/cli/cmd/cmd"
+
+export const AgentSessionCommand = cmd({
+  command: "sessions",
+  describe: "export Agent Session Records",
+  builder: (yargs) =>
+    yargs
+      .command({
+        command: "export",
+        describe: "export recorded session events as Agent Session Record JSONL",
+        builder: (yargs) =>
+          yargs
+            .option("format", { type: "string", choices: ["agent-session"], default: "agent-session" })
+            .option("session", { type: "string", array: true, default: [] })
+            .option("since", { type: "string" })
+            .option("output", { type: "string" })
+            .option("database", { type: "string" })
+            .option("write-discovery", { type: "boolean", default: false }),
+        handler: async (args) => {
+          const { write } = await import("@/kilocode/agent-session")
+          const { InstallationVersion } = await import("@opencode-ai/core/installation/version")
+          const { Database } = await import("@opencode-ai/core/database/database")
+          await write({
+            database: args.database ?? Database.path(),
+            sessions: args.session,
+            since: args.since,
+            output: args.output,
+            discovery: args.writeDiscovery,
+            version: InstallationVersion,
+          })
+        },
+      })
+      .demandCommand(),
+  handler() {},
+})
