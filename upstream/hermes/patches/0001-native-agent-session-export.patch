diff --git a/tests/hermes_cli/test_session_export_asr.py b/tests/hermes_cli/test_session_export_asr.py
new file mode 100644
index 00000000..8671f961
--- /dev/null
+++ b/tests/hermes_cli/test_session_export_asr.py
@@ -0,0 +1,155 @@
+"""Native ASR export contracts for durable history and the real session command."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from hermes_cli.session_export_asr import render_agent_session
+from hermes_cli.sessions_cmd import cmd_sessions
+from hermes_cli.subcommands.sessions import build_sessions_parser
+from hermes_state import SessionDB
+
+
+def rows(output):
+    assert output.endswith("\n")
+    return [json.loads(line) for line in output.splitlines()]
+
+
+def parse(*argv):
+    parser = argparse.ArgumentParser()
+    build_sessions_parser(parser.add_subparsers(), cmd_sessions=cmd_sessions)
+    return parser.parse_args(["sessions", "export", "--format", "agent-session", *argv])
+
+
+def test_synthetic_mapping_fixture():
+    fixture = json.loads((Path(__file__).parent / "fixtures" / "agent_session.json").read_text())
+    result = rows(render_agent_session(fixture["session"], fixture["messages"]))
+    assert result[0]["sessionId"] == fixture["session"]["id"]
+    assert result[3]["input"]["nativeCounter"] == "9007199254740993"
+    assert result[6]["content"][0]["text"] == "sample\n"
+
+
+def test_source_order_final_result_and_unknown_facts():
+    session = {"id": "synthetic-hermes", "started_at": 0, "model": "requested-alias"}
+    messages = [
+        {"id": 9007199254740993, "role": "user", "timestamp": 10, "content": "read\n"},
+        {"id": 2, "role": "assistant", "timestamp": 9, "tool_calls": [
+            {"id": "read-1", "function": {"name": "read_file", "arguments": '{"n":9007199254740993,"decimal":9007199254740993.1,"small":0.25}'}}]},
+        {"id": 3, "role": "tool", "tool_call_id": "read-1", "content": "intermediate"},
+        {"id": 4, "role": "user", "content": "a notice"},
+        {"id": 5, "role": "tool", "tool_call_id": "read-1", "content": "display",
+         "api_content": "model-facing\n", "effect_disposition": "none"},
+    ]
+    output = render_agent_session(session, messages)
+    result = rows(output)
+    assert result[1]["id"] == "9007199254740993"
+    assert result[1]["ts"] > result[2]["ts"]
+    assert result[1]["content"][0]["text"] == "read\n"
+    assert "author" not in result[1]
+    assert result[2]["input"]["n"] == "9007199254740993"
+    assert result[2]["input"]["decimal"] == "9007199254740993.1"
+    assert result[2]["input"]["small"] == 0.25
+    assert "truncated" not in result[2]
+    assert result[3]["type"] == "gap"
+    assert result[4]["content"][0]["text"] == "a notice"
+    assert result[5]["status"] == "unknown"
+    assert result[5]["content"][0]["text"] == "model-facing\n"
+    assert "endedAt" not in result[0]
+    assert not any(row["type"] in ("approval", "inference") for row in result)
+    assert render_agent_session(session, messages) == output
+
+
+def test_tool_call_only_turn_stored_with_empty_text_has_no_message():
+    session = {"id": "synthetic-hermes"}
+    messages = [
+        {"id": 1, "role": "assistant", "content": "", "tool_calls": [
+            {"id": "read-1", "function": {"name": "read_file", "arguments": "{}"}}]},
+        {"id": 2, "role": "tool", "tool_call_id": "read-1", "content": "done"},
+    ]
+    result = rows(render_agent_session(session, messages))
+    assert [row["type"] for row in result[1:]] == ["tool_call", "tool_result", "session_info"]
+    assert result[1]["id"] == "1"
+
+
+def test_redaction_corruption_compaction_and_copies():
+    session = {"id": "child", "parent_session_id": "parent:with#reserved"}
+    messages = [
+        {"id": 1, "role": "assistant", "content": "password=synthetic-secret"},
+        {"id": 2, "role": "assistant", "tool_calls": "{broken"},
+        {"id": 3, "role": "user", "content": "summary", "_compressed_summary": True,
+         "message_uid": "copied-uid"},
+    ]
+    output = render_agent_session(session, messages, copied_uids={"copied-uid"}, parent_kind="fork")
+    result = rows(output)
+    assert "synthetic-secret" not in output
+    assert result[1]["truncated"]
+    assert result[2]["reason"] == "unparseable"
+    assert result[3]["origin"] == "compaction"
+    assert result[3]["author"] == "harness"
+    assert result[4]["reason"] == "not_retained"
+    assert result[3]["copiedFrom"]["session"] == "hermes:parent%3Awith%23reserved"
+    assert "secrets_or_unsafe_numbers" in result[0]["missing"]
+
+
+def test_real_store_command_directory_and_read_only(tmp_path, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    path = tmp_path / "state.db"
