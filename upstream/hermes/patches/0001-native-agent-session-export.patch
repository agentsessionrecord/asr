--- /dev/null
+++ b/hermes_cli/session_export_asr.py
@@ -0,0 +1,391 @@
+"""Native Agent Session Record export of durable session rows."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from datetime import UTC, datetime
+from decimal import Decimal
+from pathlib import Path
+import sys
+from urllib.parse import quote
+
+VENDOR = "ai.nousresearch.hermes"
+MISSING = [
+    "approvals",
+    "agent_settings",
+    "tools",
+    "usage",
+    "model",
+    "copies",
+    "subagents",
+    "file_changes",
+    "commits",
+    "exit_codes",
+    "inference_settings",
+    "native_metadata",
+]
+SECRET_KEYS = frozenset(
+    {
+        "password",
+        "api_key",
+        "apikey",
+        "access_token",
+        "refresh_token",
+        "authorization",
+        "secret",
+    }
+)
+
+
+def _asr_reasoning(text: str, summary: bool = False) -> dict[str, object]:
+    if not text:
+        return {"type": "reasoning", "visibility": "omitted"}
+    if summary:
+        return {"type": "reasoning", "visibility": "summary", "summary": [text]}
+    return {"type": "reasoning", "text": text}
+
+
+def _timestamp(value):
+    if value is None:
+        return None
+    if isinstance(value, str):
+        value = datetime.fromisoformat(value).timestamp()
+    if not math.isfinite(value):
+        raise ValueError("Invalid source timestamp")
+    return datetime.fromtimestamp(value, UTC).isoformat().replace("+00:00", "Z")
+
+
+def _clean(value):
+    from agent.redact import redact_sensitive_text
+
+    if isinstance(value, str):
+        cleaned = redact_sensitive_text(value, force=True, redact_url_credentials=True)
+        return "[redacted]" if cleaned != value else value
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, int) and abs(value) > 2**53 - 1:
+        return str(value)
+    if isinstance(value, (float, Decimal)):
+        return str(value) if abs(value) > 2**53 - 1 else float(value)
+    if isinstance(value, list):
+        return [_clean(item) for item in value]
+    if isinstance(value, dict):
+        return {
+            key: "[redacted]" if key.lower() in SECRET_KEYS else _clean(item)
+            for key, item in value.items()
+            if key not in ("signature", "thoughtSignature")
+        }
+    return value
+
+
+def _parts(content):
+    if content is None:
+        return []
+    if isinstance(content, str):
+        return [{"type": "text", "text": content}] if content else []
+    if not isinstance(content, list):
+        raise ValueError("Unsupported native content")
+    parts = []
+    for part in content:
+        if not isinstance(part, dict):
+            raise ValueError("Invalid native content part")
+        kind = part.get("type")
+        if kind in ("text", "resource", "resource_link"):
+            parts.append(part)
+        elif kind == "image_url":
+            url = part["image_url"]["url"]
+            if url.startswith("data:") and ";base64," in url:
+                mime, data = url[5:].split(";base64,", 1)
+                parts.append({"type": "image", "mimeType": mime, "data": data})
+            else:
+                raise ValueError("Image bytes are not stored")
+        else:
+            raise ValueError("Unsupported native content part")
+    return parts
+
+
+def _redacted(before, after):
+    if isinstance(before, str):
+        return before != after
+    if isinstance(before, list):
+        return any(_redacted(a, b) for a, b in zip(before, after))
+    if isinstance(before, dict):
+        return any(
+            key not in after
+            or (key.lower() in SECRET_KEYS and value != after[key])
+            or _redacted(value, after[key])
+            for key, value in before.items()
+        )
+    return False
+
+
+def _decode_content(content):
+    if isinstance(content, str) and content.startswith("\x00json:"):
+        return json.loads(content[6:], parse_float=Decimal)
+    return content
+
+
+def _row_records(row):
+    content = _parts(
+        _decode_content(
+            row.get("api_content")
+            if row.get("api_content") is not None
+            else row.get("content")
+        )
+    )
+    role = row["role"]
+    if role == "tool":
+        result = {"type": "tool_result", "status": "unknown", "content": content}
+        if row.get("tool_call_id"):
+            result["callId"] = str(row["tool_call_id"])
+        return [result]
+    if role not in ("user", "assistant", "system", "developer"):
+        raise ValueError("Unsupported native role")
+    message = {"type": "message", "role": role, "content": content}
+    if role == "assistant":
+        message["author"] = "model"
+        reasoning = row.get("reasoning_content")
+        if reasoning is None:
+            reasoning = row.get("reasoning")
+        if reasoning is not None:
+            content.insert(0, _asr_reasoning(reasoning, False))
+    if role in ("system", "developer"):
+        message["origin"] = "instructions"
+    if row.get("_compressed_summary"):
+        message.update(author="harness", origin="compaction")
+    records = [message] if content or not row.get("tool_calls") else []
+    calls = row.get("tool_calls") or []
+    if isinstance(calls, str):
+        calls = json.loads(calls, parse_float=Decimal)
+    for index, call in enumerate(calls):
+        function = call["function"]
+        record = {
+            "type": "tool_call",
+            "callId": str(call.get("id") or f"row-{row['id']}-call-{index}"),
+        }
+        if function.get("name") is not None:
+            record["name"] = function["name"]
+        if "arguments" in function:
+            args = function["arguments"]
+            if isinstance(args, str):
+                try:
+                    record["input"] = json.loads(args, parse_float=Decimal)
+                except ValueError:
+                    record["inputText"] = args
+            else:
+                record["input"] = args
+        records.append(record)
+    if row.get("_compressed_summary"):
+        records.append(
+            {
+                "type": "gap",
+                "reason": "not_retained",
+                "detail": "The summary does not establish that all earlier history survives.",
+            }
+        )
+    return records
+
+
+def render_agent_session(session, messages, *, copied_uids=(), parent_kind=None):
+    sid = session["id"]
+    if not isinstance(sid, str) or not sid:
+        raise ValueError("Missing native session ID")
+    header = {
+        "type": "session",
+        "id": "header",
+        "formatVersion": "0.1",
+        "agent": {"name": "hermes"},
+        "sessionId": sid,
+        "producer": {
+            "name": "hermes-session-export",
+            "version": "1",
+            "method": "native",
+            "source": "hermes-sqlite",
+        },
+        "missing": list(MISSING),
+    }
+    for source, target in (("started_at", "startedAt"), ("ended_at", "endedAt")):
+        if session.get(source) is not None:
+            header[target] = _timestamp(session[source])
+    if session.get("cwd") and Path(session["cwd"]).is_absolute():
+        header["cwd"] = session["cwd"]
+    parent = session.get("parent_session_id")
+    if parent and parent_kind:
+        header["parent"] = {
+            "session": "hermes:" + quote(parent, safe="-._~"),
+            "kind": parent_kind,
+        }
+    last_results = {
+        str(row["tool_call_id"]): pos
+        for pos, row in enumerate(messages)
+        if row.get("role") == "tool" and row.get("tool_call_id")
+    }
+    records = [header]
+    for pos, row in enumerate(messages):
+        try:
+            items = _row_records(row)
+        except (ValueError, TypeError, KeyError):
+            items = [
+                {
+                    "type": "gap",
+                    "reason": "unparseable",
+                    "count": 1,
+                    "detail": "A native message row could not be mapped.",
+                }
+            ]
+            header["missing"].append("corrupt_or_unsupported_content")
+        if (
+            row.get("role") == "tool"
+            and row.get("tool_call_id")
+            and last_results[str(row["tool_call_id"])] != pos
+        ):
+            items = [
+                {
+                    "type": "gap",
+                    "reason": "not_retained",
+                    "detail": "An intermediate tool result was folded into its last stored result.",
+                }
+            ]
+            header["missing"].append("tool_result_updates")
+        for index, record in enumerate(items):
+            native_id = str(row["id"])
+            record["id"] = native_id if len(items) == 1 else f"{native_id}:{index}"
+            try:
+                if row.get("timestamp") is not None:
+                    record["ts"] = _timestamp(row["timestamp"])
+            except (ValueError, TypeError, OverflowError):
+                header["missing"].append("timestamps")
+            if row.get("message_uid") in copied_uids and parent:
+                record["copiedFrom"] = {
+                    "session": "hermes:" + quote(parent, safe="-._~")
+                }
+            record["_meta"] = {
+                VENDOR: {
+                    "nativeRowId": native_id,
+                    "active": row.get("active"),
+                    "compacted": row.get("compacted"),
+                    "effectDisposition": row.get("effect_disposition"),
+                }
+            }
+            records.append(record)
+    snapshot = {
+        "type": "session_info",
+        "id": "snapshot",
+        "missing": ["agent_settings"],
+        "_meta": {VENDOR: {"requestedModel": session.get("model")}},
+    }
+    if session.get("title") is not None:
+        snapshot["title"] = session["title"]
+    records.append(snapshot)
+    cleaned = []
+    for record in records:
+        result = _clean(record)
+        if _redacted(record, result):
+            result["truncated"] = True
+            header["missing"].append("secrets_or_unsafe_numbers")
+        cleaned.append(result)
+    cleaned[0]["missing"] = sorted(set(header["missing"]))
+    return "".join(
+        json.dumps(record, ensure_ascii=False, allow_nan=False) + "\n"
+        for record in cleaned
+    )
+
+
+def _snapshot(db, sid):
+    def read(conn):
+        conn.execute("BEGIN")
+        try:
+            session = conn.execute(
+                "SELECT * FROM sessions WHERE id = ?", (sid,)
+            ).fetchone()
+            if session is None:
+                raise ValueError("Selected session is unavailable")
+            session = dict(session)
+            messages = [
+                dict(row)
+                for row in conn.execute(
+                    "SELECT * FROM messages WHERE session_id = ? ORDER BY id", (sid,)
+                )
+            ]
+            parent = session.get("parent_session_id")
+            copied = {
+                row[0]
+                for row in conn.execute(
+                    "SELECT message_uid FROM messages WHERE session_id = ? AND message_uid IS NOT NULL",
+                    (parent,),
+                )
+            }
+            parent_row = conn.execute(
+                "SELECT end_reason FROM sessions WHERE id = ?", (parent,)
+            ).fetchone()
+            config = json.loads(session.get("model_config") or "{}")
+            kind = (
+                "fork"
+                if config.get("_branched_from") == parent and parent
+                else "subagent"
+                if config.get("_delegate_from") == parent and parent
+                else "continues"
+                if parent_row and parent_row[0] == "compression"
+                else None
+            )
+            return render_agent_session(
+                session, messages, copied_uids=copied, parent_kind=kind
+            )
+        finally:
+            conn.execute("ROLLBACK")
+
+    return db._read_retrying_ioerr(read)
+
+
+def run_agent_session_export(db, args):
+    try:
+        output = None if args.output == "-" else args.output
+        selected = [args.session_id] if args.session_id else []
+        if (
+            args.only
+            or args.upload
+            or args.delete_after_verified
+            or args.lineage != "single"
+        ):
+            raise ValueError(
+                "agent-session does not support view, upload, deletion or logical-lineage options"
+            )
+        if not output and len(selected) != 1:
+            raise ValueError("stdout requires --session-id")
+        ids = []
+        if selected:
+            for sid in selected:
+                resolved = db.resolve_session_id(sid)
+                if not resolved:
+                    raise ValueError("Selected session is unavailable or ambiguous")
+                if resolved not in ids:
+                    ids.append(resolved)
+        else:
+            ids = [
+                row[0]
+                for row in db._read_all(
+                    "SELECT id FROM sessions ORDER BY started_at, id"
+                )
+            ]
+        db.assert_exports_safe(ids)
+        streams = [(sid, _snapshot(db, sid)) for sid in ids]
+        if output:
+            directory = Path(output).expanduser()
+            directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+            for sid, stream in streams:
+                filename = hashlib.sha256(sid.encode()).hexdigest() + ".jsonl"
+                destination = directory / filename
+                with destination.open("x", encoding="utf-8", newline="\n") as target:
+                    destination.chmod(0o600)
+                    target.write(stream)
+            print(f"Exported {len(streams)} session(s).", file=sys.stderr)
+        elif len(streams) == 1:
+            sys.stdout.write(streams[0][1])
+        else:
+            raise ValueError("No selected session is available")
+        return 0
+    except (ValueError, OSError) as exc:
+        print(f"ASR export failed: {exc}", file=sys.stderr)
+        return 1
