diff --git a/src/cli/sessions.ts b/src/cli/sessions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..71f664f0bdd7a4db690ffc21f2a7894b54d98905
--- /dev/null
+++ b/src/cli/sessions.ts
@@ -0,0 +1,23 @@
+/** Explicit offline native-session export. No provider settings are loaded. */
+import { readFileSync, writeFileSync } from "node:fs";
+import { Command } from "commander";
+import { exportAgentSession } from "./agentSessionExport";
+import { getParseOptions } from "./argv";
+
+export async function main(): Promise<number> {
+  const command = new Command().name("xum sessions");
+  command
+    .command("export")
+    .requiredOption("--session <id>", "Native session ID")
+    .requiredOption("--source <file>", "Selected native chat.jsonl segment")
+    .option("--format <format>", "Export format", "agent-session")
+    .option("--output <file>", "Exclusive private output file, otherwise stdout")
+    .action((options: { session: string; source: string; format: string; output?: string }) => {
+      if (options.format !== "agent-session") throw new Error("Unsupported export format");
+      const stream = exportAgentSession(options.session, readFileSync(options.source, "utf8"));
+      if (options.output) writeFileSync(options.output, stream, { mode: 0o600, flag: "wx" });
+      else process.stdout.write(stream);
+    });
+  await command.parseAsync(process.argv, getParseOptions());
+  return 0;
+}
