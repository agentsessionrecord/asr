diff --git a/src/sessions/agent-session-discovery.ts b/src/sessions/agent-session-discovery.ts
new file mode 100644
index 00000000000..f554c87d7cc
--- /dev/null
+++ b/src/sessions/agent-session-discovery.ts
@@ -0,0 +1,50 @@
+import { randomUUID } from "node:crypto";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+export function writeAgentSessionDiscovery(options: {
+  nativePaths: string[];
+  exportCommand?: string[];
+  env?: NodeJS.ProcessEnv;
+  platform?: NodeJS.Platform;
+}): string {
+  const env = options.env ?? process.env;
+  const config =
+    (options.platform ?? process.platform) === "win32" ? env.APPDATA : env.XDG_CONFIG_HOME;
+  const directory = path.join(
+    config || path.join(env.HOME || os.homedir(), ".config"),
+    "agent-sessions",
+    "sources",
+  );
+  fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const destination = path.join(directory, "openclaw.json");
+  const temporary = path.join(directory, `.openclaw-${randomUUID()}.tmp`);
+  try {
+    fs.writeFileSync(
+      temporary,
+      `${JSON.stringify(
+        {
+          agent: "openclaw",
+          exportCommand: options.exportCommand ?? [
+            "openclaw",
+            "sessions",
+            "export",
+            "--format",
+            "agent-session",
+          ],
+          nativePaths: options.nativePaths,
+          formatVersions: ["0.1"],
+          supportsDeletionHook: false,
+        },
+        null,
+        2,
+      )}\n`,
+      { flag: "wx", mode: 0o600 },
+    );
+    fs.renameSync(temporary, destination);
+  } finally {
+    fs.rmSync(temporary, { force: true });
+  }
+  return destination;
+}
