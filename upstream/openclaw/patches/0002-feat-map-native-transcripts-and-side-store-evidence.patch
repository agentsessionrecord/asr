diff --git a/src/sessions/agent-session-export.evidence.ts b/src/sessions/agent-session-export.evidence.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a17a9793763b81412c12baa95742bf3eba66bf23
--- /dev/null
+++ b/src/sessions/agent-session-export.evidence.ts
@@ -0,0 +1,134 @@
+import { meta, object, parseObject, string } from "./agent-session-export.json.js";
+import type { TranscriptExport } from "./agent-session-export.transcript.js";
+import type { AsrRecord, JsonObject } from "./agent-session-export.types.js";
+
+/** Independent stores have no shared event ordinal. Keep their source-ordered
+ * logs and current rows as explicitly labeled metadata, not historical actions. */
+export function appendExportEvidence(transcript: TranscriptExport): AsrRecord[] {
+  const { source } = transcript;
+  const facts: JsonObject = {};
+  const unassigned: JsonObject[] = [];
+  const ownsRun = (run: string | null, table: string, key: string, row: unknown) => {
+    const owner = run ? source.runOwners.get(run) : undefined;
+    if (!owner) {
+      unassigned.push({ table, key, row });
+    }
+    return owner === source.window.session_id;
+  };
+  facts.approvals = source.evidence.approvals.filter(
+    (r) => !transcript.tools.exportedApprovals.has(r.approval_id),
+  );
+  facts.skills = source.evidence.skills.filter((r) =>
+    ownsRun(r.run_id, "skill_workshop_changes", r.change_id, r),
+  );
+  facts.audit = source.evidence.audit;
+  facts.reactions = source.evidence.reactions;
+  facts.bindings = source.evidence.bindings.map((r) => ({
+    plugin: r.plugin_id,
+    binding: parseObject(r.value_json),
+  }));
+  const queueIds = new Set<string>();
+  const knownQueues = new Set<string>();
+  facts.queue = source.evidence.queue.filter((row) => {
+    const entry = parseObject(row.entry_json);
+    const generation = object(entry.sessionGeneration);
+    const completion = object(entry.deliveryCompletion);
+    const sessionId =
+      string(generation.sessionId) ??
+      (completion.kind === "pending-final" ? string(completion.sessionId) : undefined);
+    if (sessionId) {
+      knownQueues.add(row.id);
+    } else {
+      unassigned.push({ table: "delivery_queue_entries", key: row.id, row });
+    }
+    if (sessionId === source.window.session_id) {
+      queueIds.add(row.id);
+    }
+    return sessionId === source.window.session_id;
+  });
+  facts.deliveries = source.evidence.deliveries.filter((row) => {
+    if (row.queue_id && queueIds.has(row.queue_id)) {
+      return true;
+    }
+    if (!row.queue_id || !knownQueues.has(row.queue_id)) {
+      unassigned.push({ table: "conversation_deliveries", key: row.operation_id, row });
+    }
+    return false;
+  });
+  const receipts = source.evidence.receipts.filter((r) =>
+    ownsRun(r.request_run_id, "cron_run_receipts", r.receipt_id, r),
+  );
+  const jobIds = new Set(receipts.map((r) => r.job_id));
+  facts.cron = source.evidence.cron
+    .filter((r) => jobIds.has(r.job_id))
+    .map((row) => {
+      const job = parseObject(row.job_json);
+      return {
+        jobId: row.job_id,
+        name: row.name,
+        enabled: row.enabled,
+        schedule: job.schedule,
+        updatedAt: row.updated_at,
+      };
+    });
+  facts.receipts = receipts;
+  facts.heartbeat = source.evidence.heartbeat.filter((r) =>
+    ownsRun(r.context_run_id, "heartbeat_outcomes", r.session_key, r),
+  );
+  if (unassigned.length) {
+    transcript.losses.add("unassigned_facts");
+    facts.unassignedLaneFacts = unassigned;
+  }
+  if (!source.evidence.sharedStateAvailable) {
+    transcript.losses.add("shared_state_unavailable");
+  }
+  const node = source.node;
+  const modelSettings =
+    typeof node?.thinkingLevel === "string" || node?.thinkingLevel === null
+      ? { reasoningEffort: node.thinkingLevel }
+      : undefined;
+  const agentSettings =
+    node?.permissionMode !== undefined || modelSettings
+      ? {
+          approval: node?.permissionMode,
+          modelSettings,
+        }
+      : undefined;
+  const record: AsrRecord = {
+    type: "session_info",
+    id: transcript.ids.claim(undefined, "snapshot", source.window.session_id),
+    title: string(node?.label) ?? string(node?.displayName),
+    agentSettings,
+    missing: ["native_side_tables", "agent_settings", "approvals"],
+    _meta: meta({
+      snapshot: true,
+      stores: facts,
+      node: node
+        ? {
+            updatedAt: node.updatedAt,
+            createdActor: node.createdActor,
+            createdVia: node.createdVia,
+            sandbox: node.sandbox,
+            sandboxMode: node.sandboxMode,
+            systemPromptSandbox: object(node.systemPromptReport).sandbox,
+            goal: node.goal,
+            owner: node.owner,
+            category: node.category,
+            cliSessionBindings: node.cliSessionBindings,
+            claudeCliSessionId: node.claudeCliSessionId,
+          }
+        : undefined,
+    }),
+  };
+  const records = [record];
+  if (source.cold) {
+    transcript.losses.add("cold_archive");
+    records.unshift({
+      type: "gap",
+      id: transcript.ids.claim(undefined, "cold", source.window.session_id),
+      reason: "not_retained",
+      detail: "Cold archive bodies are not read by this exporter.",
+    });
+  }
+  return records;
+}
diff --git a/src/sessions/agent-session-export.transcript.ts b/src/sessions/agent-session-export.transcript.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0c6786acf669c602cbeb95b6452539e6fef1d223
--- /dev/null
+++ b/src/sessions/agent-session-export.transcript.ts
@@ -0,0 +1,599 @@
+import { isTranscriptOnlyOpenClawAssistantMessage } from "../shared/transcript-only-openclaw-assistant.js";
+import {
+  array,
+  content,
+  ExportIds,
+  meta,
+  number,
+  object,
+  string,
+  sessionRef,
+  timestamp,
+} from "./agent-session-export.json.js";
+import { ExportTools } from "./agent-session-export.tools.js";
+import type {
+  AsrRecord,
+  ExportEvent,
+  JsonObject,
+  WindowExportSource,
+} from "./agent-session-export.types.js";
+
+export function eventRun(event: JsonObject): string | undefined {
+  const message = object(event.message);
+  return (
+    string(object(message["__openclaw"]).runId) ??
+    string(object(event["__openclaw"]).runId) ??
+    string(object(message["__openclaw"]).steerTargetRunId) ??
+    (message.customType === "openclaw.nested-tool.v1"
+      ? string(object(message.details).runId)
+      : undefined)
+  );
+}
+
+export function messageTrigger(
+  message: JsonObject,
+  source: WindowExportSource,
+): string | undefined {
+  const provenance = object(message.provenance);
+  if (["cron", "cron_execution"].includes(String(provenance.sourceTool))) {
+    return "scheduled";
+  }
+  if (
+    provenance.kind === "external_user" ||
+    string(object(object(message["__openclaw"]).transport).channel)
+  ) {
+    return "external";
+  }
+  if (
+    source.window.hook_external_content_source ||
+    /(?:^|:)hook:/.test(source.window.session_key)
+  ) {
+    return "external";
+  }
+  return undefined;
+}
+
+function inferenceKey(message: JsonObject): string | undefined {
+  const native = string(message.responseId) || string(message.turnId);
+  return native ? JSON.stringify([message.provider, native]) : undefined;
+}
+function modelMessage(message: JsonObject): boolean {
+  return (
+    message.role === "assistant" &&
+    message.provider !== "openclaw" &&
+    !isTranscriptOnlyOpenClawAssistantMessage(message)
+  );
+}
+function callsIn(event: JsonObject): JsonObject[] {
+  const message = object(event.message);
+  if (message.customType === "openclaw.nested-tool.v1") {
+    const nested = object(message.details);
+    return [{ id: nested.toolCallId, name: nested.toolName, arguments: nested.input }];
+  }
+  return modelMessage(message)
+    ? array(message.content)
+        .map(object)
+        .filter((p) => p.type === "toolCall")
+    : [];
+}
+
+export class TranscriptExport {
+  readonly records: AsrRecord[] = [];
+  readonly losses = new Set<string>([
+    "approvals",
+    "agent_settings",
+    "tools",
+    "inference_settings",
+    "file_changes",
+    "commits",
+    "subagents",
+    "copies",
+    "native_side_tables",
+    "request_context",
+    "provider_state",
+  ]);
+  readonly messages = new Map<string, AsrRecord>();
+  readonly tools: ExportTools;
+  readonly ids: ExportIds;
+  readonly cwd?: string;
+  copiedThrough?: string;
+  private readonly roots = new Map<string, string>();
+  private readonly lastRevision = new Map<string, string>();
+  private readonly lastResult = new Map<string, ExportEvent>();
+  private readonly pendingResults = new Map<string, JsonObject>();
+  private readonly inferenceEvents = new Map<string, ExportEvent>();
+  private readonly inferenceIds = new Map<string, string>();
+  private readonly copiedInferences = new Set<string>();
+  private readonly emittedInferences = new Set<string>();
+  private readonly seenTurns = new Set<string>();
+  private current?: ExportEvent;
+  private slot = 0;
+  private runId?: string;
+
+  constructor(readonly source: WindowExportSource) {
+    this.cwd = string(source.events.find(({ event }) => event?.type === "session")?.event?.cwd);
+    this.tools = new ExportTools(
+      (type, fields, id) => this.emit(type, fields, id),
+      this.cwd,
+      this.losses,
+      source.evidence.approvals,
+    );
+    for (const { event } of source.events) {
+      if (!event) {
+        continue;
+      }
+      const id = string(event.id);
+      if (id) {
+        const previous = string(event.supersedesEntryId);
+        const root = previous ? (this.roots.get(previous) ?? previous) : id;
+        this.roots.set(id, root);
+        this.lastRevision.set(root, id);
+      }
+      for (const call of callsIn(event)) {
+        if (
+          call.name === "secrets" ||
+          object(call.arguments).secret === true ||
+          array(object(call.arguments).questions).some((q) => object(q).secret === true)
+        ) {
+          if (typeof call.id === "string") {
+            this.tools.secretCalls.add(call.id);
+          }
+        }
+      }
+    }
+    const candidates: (string | undefined)[] = source.events.map(({ event }) => string(event?.id));
+    for (const item of source.events) {
+      const event = item.event;
+      if (!event) {
+        continue;
+      }
+      const message = object(event.message);
+      const id = string(event.id);
+      const latest = !id || this.lastRevision.get(this.roots.get(id) ?? id) === id;
+      if (latest) {
+        for (const call of callsIn(event)) {
+          const callId = string(call.id);
+          candidates.push(callId);
+          if (callId) {
+            this.tools.callCounts.set(callId, (this.tools.callCounts.get(callId) ?? 0) + 1);
+          }
+        }
+      }
+      if (message.role === "toolResult" && typeof message.toolCallId === "string") {
+        this.lastResult.set(message.toolCallId, item);
+      }
+      if (
+        modelMessage(message) &&
+        (!source.window.agent_harness_id || source.window.agent_harness_id === "openclaw")
+      ) {
+        const key = inferenceKey(message);
+        if (key) {
+          this.inferenceEvents.set(key, item);
+          if (source.ancestor?.eventIds.has(String(event.id))) {
+            this.copiedInferences.add(key);
+          }
+        }
+      }
+    }
+    for (const item of this.inferenceEvents.values()) {
+      const message = object(item.event?.message);
+      candidates.push(string(message.responseId) || string(message.turnId));
+    }
+    candidates.push(...source.evidence.approvals.map((row) => row.approval_id));
+    this.ids = new ExportIds(candidates);
+    for (const [key, item] of this.inferenceEvents) {
+      const message = object(item.event?.message);
+      this.inferenceIds.set(
+        key,
+        this.ids.claim(string(message.responseId) || string(message.turnId), "inference", key),
+      );
+    }
+  }
+
+  emit(type: string, fields: JsonObject = {}, nativeId?: string): AsrRecord {
+    const event = this.current?.event;
+    const primary = ["message", "tool_result", "session_info"].includes(type);
+    const record: AsrRecord = {
+      type,
+      id: this.ids.claim(
+        nativeId ?? (primary ? string(event?.id) : undefined),
+        "event",
+        string(event?.id) ?? this.current?.seq ?? "tail",
+        type,
+        ++this.slot,
+      ),
+      ts: timestamp(event?.timestamp),
+      turnId: this.runId,
+      ...fields,
+      _meta: meta({
+        entryId: event?.id,
+        parentId: event?.parentId,
+        supersedesEntryId: event?.supersedesEntryId,
+        appendMode: event?.appendMode,
+        ...object(object(fields._meta)["ai.openclaw"]),
+      }),
+    };
+    if (!record.ts) {
+      this.losses.add("timestamps");
+    }
+    this.records.push(record);
+    return record;
+  }
+
+  private inference(message: JsonObject): string | undefined {
+    const key = inferenceKey(message);
+    const id = key && this.inferenceIds.get(key);
+    if (!id || !key) {
+      this.losses.add("usage");
+      this.losses.add("model");
+      return undefined;
+    }
+    if (this.inferenceEvents.get(key) !== this.current || this.emittedInferences.has(key)) {
+      return id;
+    }
+    this.emittedInferences.add(key);
+    const usage = object(message.usage);
+    const unavailable = object(usage.usageReport).state === "unavailable";
+    if (unavailable || message.usage === undefined) {
+      this.losses.add("usage");
+    }
+    const cost = object(usage.cost);
+    const input = number(usage.input);
+    const cacheRead = number(usage.cacheRead);
+    const cacheWrite = number(usage.cacheWrite);
+    const total =
+      input === undefined ? undefined : number(input + (cacheRead ?? 0) + (cacheWrite ?? 0));
+    if (
+      (total === undefined && usage.input !== undefined) ||
+      ["input", "output", "cacheRead", "cacheWrite", "reasoningTokens"].some(
+        (field) => usage[field] !== undefined && number(usage[field]) === undefined,
+      )
+    ) {
+      this.losses.add("usage");
+    }
+    if (cost.total !== undefined && number(cost.total) === undefined) {
+      this.losses.add("cost");
+    }
+    const model = string(message.model) || string(message.responseModel);
+    if (!model) {
+      this.losses.add("model");
+    }
+    const copied = this.copiedInferences.has(key) && this.source.ancestor;
+    this.emit("inference", {
+      id,
+      ts: timestamp(this.current?.event?.timestamp),
+      copiedFrom: copied ? { session: sessionRef(copied.sessionId) } : undefined,
+      model: model
+        ? {
+            provider: string(message.provider),
+            id: string(message.responseModel),
+            requested: string(message.model),
+          }
+        : undefined,
+      stopReason: string(message.stopReason),
+      usage:
+        !unavailable && message.usage !== undefined
+          ? {
+              inputTokens: total,
+              cacheReadTokens: cacheRead,
+              cacheWriteTokens: cacheWrite,
+              outputTokens: number(usage.output),
+              reasoningTokens: number(usage.reasoningTokens),
+            }
+          : undefined,
+      cost:
+        !unavailable && number(cost.total) !== undefined
+          ? {
+              amount: cost.total,
+              currency: "USD",
+              source:
+                cost.totalOrigin === "provider-billed" ? "provider_reported" : "harness_estimated",
+            }
+          : undefined,
+      error:
+        message.errorMessage !== undefined || message.errorCode !== undefined
+          ? { message: string(message.errorMessage), code: message.errorCode }
+          : undefined,
+      _meta: meta({
+        responseId: message.responseId,
+        turnId: message.turnId,
+        api: message.api,
+        usageReport: usage.usageReport,
+        cacheTelemetry: usage.cacheTelemetry,
+        contextUsage: usage.contextUsage,
+        nativeUsage: message.usage,
+        cacheWrite1h: usage.cacheWrite1h,
+        cacheWrite5m: usage.cacheWrite5m,
+      }),
+    });
+    return id;
+  }
+
+  private message(event: JsonObject, entryId: string) {
+    const message = object(event.message);
+    const facts = object(message["__openclaw"]);
+    const provenance = object(message.provenance);
+    if (message.role === "toolResult") {
+      const callId = string(message.toolCallId);
+      if (callId && (this.tools.callCounts.get(callId) ?? 0) <= 1) {
+        const previous = this.pendingResults.get(callId);
+        const folded = {
+          ...previous,
+          ...message,
+          details: { ...object(previous?.details), ...object(message.details) },
+        };
+        if (typeof message.isError === "boolean" && object(message.details).status === undefined) {
+          delete folded.details.status;
+        }
+        if (this.lastResult.get(callId) !== this.current) {
+          this.pendingResults.set(callId, folded);
+          this.losses.add("tool_result_updates");
+          return;
+        }
+        this.pendingResults.delete(callId);
+        this.tools.result(folded);
+      } else {
+        this.tools.result(message);
+      }
+      return;
+    }
+    if (message.customType === "openclaw.nested-tool.v1") {
+      const nested = object(message.details);
+      this.tools.call(
+        { id: nested.toolCallId, name: nested.toolName, arguments: nested.input },
+        undefined,
+        "code",
+        nested.parentToolCallId,
+      );
+      this.records.at(-1)!.ts = timestamp(nested.startedAt);
+      this.tools.result(
+        { ...object(nested.result), toolCallId: nested.toolCallId, isError: nested.isError },
+        true,
+      );
+      return;
+    }
+    if (message.role === "bashExecution") {
+      this.tools.shell(message, entryId);
+      return;
+    }
+    const isModel = modelMessage(message);
+    const builtin =
+      !this.source.window.agent_harness_id || this.source.window.agent_harness_id === "openclaw";
+    const inferenceId = isModel && builtin ? this.inference(message) : undefined;
+    if (isModel && !builtin) {
+      this.losses.add("usage");
+      this.losses.add("model");
+    }
+    const identity = object(facts.senderIdentity);
+    let author: string | undefined = isModel ? "model" : undefined;
+    let origin: string | undefined;
+    if (message.role === "user") {
+      origin = this.source.inputRuns.has(entryId) ? "queued" : "prompt";
+      if (identity.type === "profile" || identity.senderKind === "human") {
+        author = "human";
+      }
+    }
+    if (message.operatorMessage) {
+      author = "human";
+    }
+    if (provenance.kind === "inter_session") {
+      author = "agent";
+      origin = "injected";
+    } else if (
+      provenance.kind === "internal_system" ||
+      message.synthetic ||
+      message.runtimeContext ||
+      message.role === "custom"
+    ) {
+      author = "harness";
+      origin = "injected";
+    }
+    if (message.provider === "openclaw" || isTranscriptOnlyOpenClawAssistantMessage(message)) {
+      author =
+        object(message.openclawAutomation).kind === "subagent-completion" ? "agent" : "harness";
+      origin = author === "agent" ? "subagent_report" : "injected";
+    }
+    if (["system", "developer"].includes(String(message.role))) {
+      origin = "instructions";
+    }
+    if (message.role === "user") {
+      const first = !this.runId || !this.seenTurns.has(this.runId);
+      origin =
+        messageTrigger(message, this.source) ??
+        (first && this.source.node?.createdVia === "cron" ? "scheduled" : origin);
+      if (this.runId) {
+        this.seenTurns.add(this.runId);
+      }
+    }
+    const personId = string(identity.id) || string(identity.profileId) || string(facts.senderId);
+    const personName = string(facts.senderName);
+    const person =
+      author === "human" && (personId || personName)
+        ? {
+            id: personId || undefined,
+            name: personName || undefined,
+            source: identity.type === "profile" ? "_ai.openclaw/profile" : "_ai.openclaw/channel",
+          }
+        : undefined;
+    const parts = content(message.content);
+    if (array(message.content).some((p) => object(p).type === "thinking" && object(p).redacted)) {
+      this.losses.add("reasoning");
+    }
+    const phases = new Set(
+      array(message.content)
+        .map((p) => object(object(p).textSignature).phase)
+        .filter((p) => p !== undefined),
+    );
+    const phase = phases.size === 1 ? [...phases][0] : undefined;
+    const role = ["user", "assistant", "system", "developer"].includes(String(message.role))
+      ? message.role
+      : "user";
+    if (!author) {
+      this.losses.add("message_author");
+    }
+    const mapped = this.emit("message", {
+      role,
+      author,
+      person,
+      origin,
+      inferenceId,
+      phase: phase === "final_answer" ? "final" : phase === "commentary" ? phase : undefined,
+      from:
+        typeof provenance.originSessionId === "string"
+          ? sessionRef(provenance.originSessionId)
+          : undefined,
+      status:
+        message.stopReason === "aborted"
+          ? "interrupted"
+          : message.stopReason === "error"
+            ? "error"
+            : isModel && ["stop", "toolUse", "length"].includes(String(message.stopReason))
+              ? "complete"
+              : undefined,
+      content: parts,
+      truncated: message.truncated === true || undefined,
+      _meta: meta({
+        nativeRole: role !== message.role ? message.role : undefined,
+        senderIdentity: facts.senderIdentity,
+        transport: facts.transport,
+        provenance: message.provenance,
+        modelPromptProjection: facts.modelPromptProjection,
+        media: facts.media,
+        displayContent: message.openclawDisplayContent,
+        excludeFromContext: message.excludeFromContext,
+        deliveryMirror: message.openclawDeliveryMirror,
+        mirrorIdentity: facts.mirrorIdentity,
+      }),
+    });
+    const mirror = object(message.openclawDeliveryMirror);
+    const original = this.messages.get(String(mirror.sourceMessageId));
+    if (original) {
+      mapped.copiedFrom = { record: original.id };
+    }
+    this.messages.set(entryId, mapped);
+    const latest =
+      !string(event.id) || this.lastRevision.get(this.roots.get(entryId) ?? entryId) === entryId;
+    if (isModel && latest) {
+      for (const call of callsIn(event)) {
+        this.tools.call(call, inferenceId, "model");
+      }
+    }
+  }
+
+  convert() {
+    let prefix = Boolean(this.source.ancestor);
+    const nativeIds = new Set(
+      this.source.events.flatMap(({ event }) => (typeof event?.id === "string" ? [event.id] : [])),
+    );
+    for (const item of this.source.events) {
+      this.current = item;
