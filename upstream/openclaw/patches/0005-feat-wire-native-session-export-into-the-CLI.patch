diff --git a/src/commands/sessions-export.ts b/src/commands/sessions-export.ts
new file mode 100644
index 00000000000..eb3bb099770
--- /dev/null
+++ b/src/commands/sessions-export.ts
@@ -0,0 +1,79 @@
+import { throwExpectedCliError } from "../cli/failure-output.js";
+import { captureRuntimeConfigAsyncReader } from "../config/config.js";
+import { resolveSqliteTargetFromSessionStorePath } from "../config/sessions/session-sqlite-target.js";
+import { writeRuntimeJson, type RuntimeEnv } from "../runtime.js";
+import { convertAgentSession, exportAgentSessionBundle } from "../sessions/agent-session-export.js";
+import { readAgentSessionExport } from "../sessions/agent-session-export.source.js";
+import type { AsrRecord } from "../sessions/agent-session-export.types.js";
+import { withArtifactPreservingStateReads } from "../state/artifact-preserving-state-reads.js";
+import { resolveCommandSessionStoreTargets } from "./session-store-targets.js";
+
+type SessionsExportOptions = {
+  format?: string;
+  sessionKey?: string;
+  session?: string[];
+  all?: boolean;
+  out?: string;
+  output?: string;
+  store?: string;
+  agent?: string;
+  allAgents?: boolean;
+};
+
+export async function sessionsExportCommand(
+  opts: SessionsExportOptions,
+  runtime: RuntimeEnv,
+): Promise<void> {
+  if (opts.format !== "agent-session") {
+    throwExpectedCliError("Use --format agent-session for ASR export");
+  }
+  if (
+    [Boolean(opts.sessionKey), Boolean(opts.session?.length), Boolean(opts.all)].filter(Boolean)
+      .length !== 1
+  ) {
+    throwExpectedCliError("Choose exactly one of --session-key <key>, --session <id...>, or --all");
+  }
+  if (opts.out && opts.output) {
+    throwExpectedCliError("Choose --out or --output, not both");
+  }
+  if (opts.sessionKey !== undefined && !opts.sessionKey.trim()) {
+    throwExpectedCliError("--session-key must not be blank");
+  }
+  const cfg = await withArtifactPreservingStateReads(() => captureRuntimeConfigAsyncReader()(), {
+    agentDatabases: true,
+  });
+  const targets = resolveCommandSessionStoreTargets({ cfg, opts });
+  const selections = targets.map((target) => ({
+    agentId: target.agentId,
+    path: resolveSqliteTargetFromSessionStorePath(target.storePath, { agentId: target.agentId })
+      .path,
+    sessionKey: opts.sessionKey,
+    sessions: opts.session,
+  }));
+  const output = opts.out ?? opts.output;
+  if (!output) {
+    if (opts.session?.length !== 1) {
+      throwExpectedCliError(
+        "Pass --output <directory> for multiple sessions, or select one --session for stdout",
+      );
+    }
+    let count = 0;
+    let records: AsrRecord[] = [];
+    for (const selection of selections) {
+      count += readAgentSessionExport(selection, (source) => {
+        records = convertAgentSession(source).records;
+      });
+    }
+    if (count !== 1) {
+      throwExpectedCliError(`Expected one stored window; found ${count}`);
+    }
+    for (const record of records) {
+      writeRuntimeJson(runtime, record, 0);
+    }
+  } else {
+    const result = exportAgentSessionBundle(selections, output);
+    runtime.error(
+      `Exported ${result.sessions} windows (${result.records} records) to ${result.output}`,
+    );
+  }
+}
