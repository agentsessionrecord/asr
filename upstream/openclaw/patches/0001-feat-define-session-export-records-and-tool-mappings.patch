@@ -0,0 +1,59 @@
+import type { Selectable } from "kysely";
+import type { DB as AgentDB } from "../state/openclaw-agent-db.generated.js";
+import type { DB as StateDB } from "../state/openclaw-state-db.generated.js";
+
+// ASR is an extensible wire format. Unknown native JSON is narrowed at the codec
+// boundary; it is never treated as executable input or a native TypeScript model.
+export type JsonObject = Record<string, unknown>;
+export type AsrRecord = JsonObject & { type: string; id: string };
+export type ExportEvent = { seq: number; event?: JsonObject };
+export type ExportWindow = Selectable<AgentDB["session_windows"]>;
+export type ExportConversation = Selectable<AgentDB["conversations"]> & { role?: string };
+export type ExportApproval = Pick<
+  Selectable<StateDB["operator_approvals"]>,
+  | "approval_id"
+  | "kind"
+  | "cursor_id"
+  | "source_session_id"
+  | "source_run_id"
+  | "source_tool_call_id"
+  | "status"
+  | "decision"
+  | "terminal_reason"
+  | "presentation_json"
+  | "created_at_ms"
+  | "expires_at_ms"
+  | "resolved_at_ms"
+  | "resolver_kind"
+  | "resolver_id"
+  | "consumed_at_ms"
+  | "consumed_by"
+>;
+export type ExportEvidence = {
+  approvals: ExportApproval[];
+  skills: Selectable<StateDB["skill_workshop_changes"]>[];
+  deliveries: Selectable<AgentDB["conversation_deliveries"]>[];
+  queue: Selectable<StateDB["delivery_queue_entries"]>[];
+  reactions: Selectable<AgentDB["session_reactions"]>[];
+  cron: Selectable<StateDB["cron_jobs"]>[];
+  receipts: Selectable<StateDB["cron_run_receipts"]>[];
+  heartbeat: Selectable<AgentDB["heartbeat_outcomes"]>[];
+  audit: Selectable<StateDB["audit_events"]>[];
+  bindings: Selectable<StateDB["plugin_state_entries"]>[];
+  heartbeatJobs: { jobId: string; since: number }[];
+  sharedStateAvailable: boolean;
+};
+export type WindowExportSource = {
+  agentId: string;
+  window: ExportWindow;
+  node?: JsonObject;
+  events: ExportEvent[];
+  conversations: ExportConversation[];
+  evidence: ExportEvidence;
+  // Only the known ancestor's IDs qualify as copies. No text matching.
+  ancestor?: { sessionId: string; eventIds: Set<string> };
+  inputRuns: Map<string, string>;
+  runOwners: Map<string, string | null>;
+  leafId?: string;
+  cold: boolean;
+};
