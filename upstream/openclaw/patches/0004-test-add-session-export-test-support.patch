+import { resolveOpenClawAgentSqlitePath } from "../state/openclaw-agent-db.paths.js";
+import type { DB as StateDB } from "../state/openclaw-state-db.generated.js";
+import { runOpenClawStateWriteTransaction } from "../state/openclaw-state-db.js";
+import type { JsonObject } from "./agent-session-export.types.js";
+
+export const syntheticTime = Date.parse("2026-10-26T12:00:00.000Z");
+export const syntheticKey = "agent:main:slack:group:asr-example";
+export const syntheticId = (n: number) => `00000000-0000-4000-8000-${String(n).padStart(12, "0")}`;
+const time = "2026-10-26T12:00:00.000Z";
+const text = (value: string) => [{ type: "text", text: value }];
+export function syntheticMessage(
+  id: string,
+  parentId: string | null,
+  message: JsonObject,
+): JsonObject {
+  return {
+    type: "message",
+    id,
+    parentId,
+    timestamp: time,
+    message: { timestamp: syntheticTime, ...message },
+  };
+}
+function assistant(content: unknown, runId = "run-main", extra: JsonObject = {}): JsonObject {
+  return {
+    role: "assistant",
+    content,
+    provider: "openai",
+    api: "openai-responses",
+    model: "fixture-model",
+    responseId: `response-${runId}`,
+    stopReason: "stop",
+    __openclaw: { runId },
+    usage: {
+      input: 12,
+      output: 4,
+      cacheRead: 8,
+      cacheWrite: 2,
+      cacheWrite1h: 2,
+      cacheWrite5m: 0,
+      totalTokens: 26,
+      cost: {
+        total: 0.0001,
+        input: 0.00004,
+        output: 0.00006,
+        cacheRead: 0,
+        cacheWrite: 0,
+        totalOrigin: "provider-billed",
+      },
+    },
+    ...extra,
+  };
+}
+export function syntheticEvents(sessionId: string): JsonObject[] {
