+use std::{env, fs, io};
+
+use agent::DbThread;
+use anyhow::{Result, anyhow};
+
+fn main() -> Result<()> {
+    let mut arguments = env::args().skip(1);
+    if arguments.next().as_deref() != Some("--format")
+        || arguments.next().as_deref() != Some("agent-session")
+    {
+        return Err(anyhow!("use --format agent-session SESSION_ID THREAD.json"));
+    }
+    let session_id = arguments.next().ok_or_else(|| {
+        anyhow!("usage: export_agent_session --format agent-session SESSION_ID THREAD.json")
+    })?;
+    let path = arguments
+        .next()
+        .ok_or_else(|| anyhow!("thread JSON is required"))?;
+    let thread: DbThread = serde_json::from_slice(&fs::read(path)?)?;
+    thread.write_agent_session(&session_id, io::stdout().lock())
+}
