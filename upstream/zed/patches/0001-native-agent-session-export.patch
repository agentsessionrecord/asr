--- /dev/null
+++ b/crates/agent/src/agent_session.rs
@@ -0,0 +1,209 @@
+use std::{collections::HashSet, io::Write};
+
+use anyhow::{Result, ensure};
+use language_model::{LanguageModelToolResultContent, LanguageModelToolUseInput};
+use serde_json::{Value, json};
+
+use crate::{AgentMessageContent, CompactionInfo, DbThread, Message, UserMessageContent};
+
+impl DbThread {
+    /// Exports a saved native-agent thread using its database session identity.
+    pub fn write_agent_session(&self, session_id: &str, mut output: impl Write) -> Result<()> {
+        ensure!(!session_id.is_empty(), "session ID is required");
+        let mut records = vec![
+            json!({"type":"session", "id":"header", "formatVersion":"0.1",
+            "agent":{"name":"zed"}, "sessionId":session_id,
+            "producer":{"name":"zed-agent-session", "version":"0.1.0", "method":"native", "source":"zed-db-thread-0.3.0"},
+            "missing":["timestamps", "usage", "model", "approvals", "agent_settings", "tools", "file_changes", "commits", "subagents", "copies", "images", "provider_state", "tool_result_order", "history", "partial_tool_calls"]}),
+        ];
+        let mut result_ids = HashSet::new();
+        let native_ids: Vec<String> = self
+            .messages
+            .iter()
+            .filter_map(|message| match &**message {
+                Message::User(user) => Some(user.id.message_id().to_string()),
+                _ => None,
+            })
+            .collect();
+        let mut used: HashSet<String> = native_ids.iter().cloned().collect();
+        used.insert("header".into());
+        let mut position = 0;
+        for message in &self.messages {
+            let mut next_id = || {
+                loop {
+                    let candidate = format!("asr-{position}");
+                    position += 1;
+                    if used.insert(candidate.clone()) {
+                        break candidate;
+                    }
+                }
+            };
+            match &**message {
+                Message::User(user) => {
+                    let native_id = user.id.message_id().to_string();
+                    let id = if native_id != "header" && native_id.chars().count() <= 256 && !native_id.is_empty()
+                        && !native_id.chars().any(char::is_control) && native_ids.iter().filter(|id| **id == native_id).count() == 1 {
+                        native_id
+                    } else { next_id() };
+                    let content: Vec<Value> = user.content.iter().filter_map(|part| match part {
+                        UserMessageContent::Text(text) => Some(json!({"type":"text", "text":text})),
+                        UserMessageContent::Mention { content, .. } => Some(json!({"type":"text", "text":content, "author":"harness", "origin":"injected"})),
+                        UserMessageContent::Image(_) => None,
+                    }).collect();
+                    let mut record = json!({"type":"message", "id":id, "role":"user", "content":content});
+                    if user.content.iter().any(|part| matches!(part, UserMessageContent::Image(_))) { record["truncated"] = json!(true); }
+                    records.push(record);
+                }
+                Message::Agent(agent) => {
+                    for part in &agent.content {
+                        let id = next_id();
+                        let record = match part {
+                            AgentMessageContent::Text(text) => json!({"type":"message", "id":id, "role":"assistant", "author":"model", "content":[{"type":"text", "text":text}]}),
+                            AgentMessageContent::Thinking { text, .. } => json!({"type":"message", "id":id, "role":"assistant", "author":"model", "content":[asr_reasoning(text, true)]}),
+                            AgentMessageContent::RedactedThinking(_) => json!({"type":"message", "id":id, "role":"assistant", "author":"model", "content":[{"type":"reasoning", "visibility":"encrypted"}]}),
+                            AgentMessageContent::ToolUse(call) => {
+                                ensure!(!call.id.to_string().is_empty() && !call.name.is_empty(), "tool identity is unavailable");
+                                if !call.is_input_complete {
+                                    records.push(json!({"type":"gap", "id":id, "reason":"not_recorded", "detail":"Incomplete tool input is excluded."}));
+                                    continue;
+                                }
+                                let input = if !call.raw_input.is_empty() { call.raw_input.clone() } else { match &call.input {
+                                    LanguageModelToolUseInput::Json(value) => serde_json::to_string(value)?,
+                                    LanguageModelToolUseInput::Text(text) => text.clone(),
+                                }};
+                                let mut record = json!({"type":"tool_call", "id":id, "callId":call.id.to_string(), "name":call.name, "requestedBy":"model"});
+                                match serde_json::from_str::<Value>(&input) {
+                                    Ok(mut value) => { stringify_wide_numbers(&mut value); record["input"] = value; }
+                                    Err(_) => record["inputText"] = input.into(),
+                                }
+                                record
+                            }
+                        };
+                        records.push(record);
+                    }
+                    for result in agent.tool_results.values() {
+                        ensure!(result_ids.insert(result.tool_use_id.to_string()), "duplicate result ID");
+                        let content: Vec<Value> = result.content.iter().filter_map(|part| match part {
+                            LanguageModelToolResultContent::Text(text) => Some(json!({"type":"text", "text":text})),
+                            LanguageModelToolResultContent::Image(_) => None,
+                        }).collect();
+                        let mut record = json!({"type":"tool_result", "id":next_id(), "callId":result.tool_use_id.to_string(), "status":if result.is_error { "failed" } else { "completed" }, "content":content});
+                        if result.content.iter().any(|part| matches!(part, LanguageModelToolResultContent::Image(_))) { record["truncated"] = json!(true); }
+                        records.push(record);
+                    }
+                }
+                Message::Resume => records.push(json!({"type":"message", "id":next_id(), "role":"user", "author":"harness", "origin":"command", "content":[{"type":"text", "text":"Continue where you left off"}]})),
+                Message::Compaction(CompactionInfo::Summary(summary)) => {
+                    records.push(json!({"type":"message", "id":next_id(), "role":"user", "author":"harness", "origin":"compaction", "content":[{"type":"text", "text":summary}]}));
+                    records.push(json!({"type":"gap", "id":next_id(), "reason":"not_retained", "detail":"Earlier context was replaced by this compaction summary."}));
+                },
+                Message::Compaction(CompactionInfo::ProviderNative { .. }) => records.push(json!({"type":"gap", "id":next_id(), "reason":"not_recorded", "detail":"Opaque provider compaction state is excluded."})),
+            }
+        }
+        for record in records {
+            serde_json::to_writer(&mut output, &record)?;
+            output.write_all(b"\n")?;
+        }
+        Ok(())
+    }
+}
+
+fn stringify_wide_numbers(value: &mut Value) {
+    match value {
+        Value::Number(number) => {
+            let wide = number.as_u64().is_some_and(|n| n > 9_007_199_254_740_991)
+                || number.as_i64().is_some_and(|n| n < -9_007_199_254_740_991)
+                || number
+                    .as_f64()
+                    .is_some_and(|n| n.abs() > 9_007_199_254_740_991.0);
+            if wide {
+                *value = Value::String(number.to_string());
+            }
+        }
+        Value::Array(values) => values.iter_mut().for_each(stringify_wide_numbers),
+        Value::Object(values) => values.values_mut().for_each(stringify_wide_numbers),
+        _ => {}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn agent_session_excludes_provider_state_and_export_time() -> Result<()> {
+        let fixture: DbThread = serde_json::from_value(
+            json!({"title":"Synthetic", "updated_at":"2026-01-01T00:00:00Z", "messages":[{"Agent":{"content":[{"Text":"hello\n"},{"RedactedThinking":"opaque-synthetic-state"}],"tool_results":{}}}]}),
+        )?;
+        let mut output = Vec::new();
+        fixture.write_agent_session("synthetic-session", &mut output)?;
+        let text = String::from_utf8(output)?;
+        assert!(!text.contains("opaque-synthetic-state"));
+        assert!(!text.contains("endedAt"));
+        assert!(text.contains("encrypted"));
+        Ok(())
+    }
+    #[test]
+    fn agent_session_records_summary_thinking_and_exact_json_arguments() -> Result<()> {
+        let fixture: DbThread = serde_json::from_value(
+            json!({"title":"Synthetic", "updated_at":"2026-01-01T00:00:00Z", "messages":[
+                {"Agent":{"content":[{"Thinking":{"text":"Visible summary", "signature":"excluded-signature"}},
+                    {"ToolUse":{"id":"one","name":"read","raw_input":"{\"nested\":[18446744073709551617,-9007199254740993,0]}","input":{"type":"text","value":"unused"},"is_input_complete":true}},
+                    {"ToolUse":{"id":"two","name":"shell","raw_input":"echo ready", "input":{"type":"text","value":"unused"},"is_input_complete":true}}
+                ],"tool_results":{}}}
+            ]}),
+        )?;
+        let mut output = Vec::new();
+        fixture.write_agent_session("synthetic-session", &mut output)?;
+        let records: Vec<Value> = String::from_utf8(output)?
+            .lines()
+            .map(serde_json::from_str)
+            .collect::<Result<_, _>>()?;
+        assert_eq!(
+            records[1]["content"][0],
+            json!({"type":"reasoning", "summary":["Visible summary"], "visibility":"summary"})
+        );
+        assert_eq!(
+            records[2]["input"]["nested"],
+            json!(["18446744073709551617", "-9007199254740993", 0])
+        );
+        assert!(records[2].get("inputText").is_none());
+        assert_eq!(records[3]["inputText"], "echo ready");
+        assert!(records[3].get("input").is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn agent_session_preserves_raw_tools_and_marks_compaction() -> Result<()> {
+        let fixture: DbThread = serde_json::from_value(
+            json!({"title":"Synthetic", "updated_at":"2026-01-01T00:00:00Z", "messages":[
+                {"User":{"id":"prompt","content":[{"Text":"hello\n"}]}},
+                {"Agent":{"content":[{"ToolUse":{"id":"call-1","name":"read","raw_input":"{ \"n\":9007199254740993 }","input":{"type":"json","value":{"n":9007199254740993_u64}},"is_input_complete":true}}],"tool_results":{"call-1":{"tool_use_id":"call-1","tool_name":"read","is_error":true,"content":[{"Text":"failed\n"}],"output":null}}}},
+                {"Compaction":{"Summary":"summary\n"}}
+            ]}),
+        )?;
+        let mut output = Vec::new();
+        fixture.write_agent_session("synthetic-session", &mut output)?;
+        let text = String::from_utf8(output)?;
+        let records: Vec<Value> = text
+            .lines()
+            .map(serde_json::from_str)
+            .collect::<Result<_, _>>()?;
+        assert_eq!(records[1]["id"], "prompt");
+        assert_eq!(records[2]["input"]["n"], "9007199254740993");
+        assert_eq!(records[2]["callId"], records[3]["callId"]);
+        assert_eq!(records[3]["status"], "failed");
+        assert_eq!(records[5]["reason"], "not_retained");
+        Ok(())
+    }
+}
+
+fn asr_reasoning(text: &str, summary: bool) -> serde_json::Value {
+    if text.is_empty() {
+        serde_json::json!({"type":"reasoning", "visibility":"omitted"})
+    } else if summary {
+        serde_json::json!({"type":"reasoning", "visibility":"summary", "summary":[text]})
+    } else {
+        serde_json::json!({"type":"reasoning", "text":text})
+    }
+}

