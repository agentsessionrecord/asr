diff --git a/packages/coding-agent/test/export-agent-session.test.ts b/packages/coding-agent/test/export-agent-session.test.ts
new file mode 100644
index 0000000..c98be7c
--- /dev/null
+++ b/packages/coding-agent/test/export-agent-session.test.ts
@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import type { ExtensionAPI, ExtensionCommandContext } from "../src/index.ts";
+import registerExport from "../examples/extensions/asr-export/index.ts";
+import { exportAgentSessionFile } from "../examples/extensions/asr-export/export.ts";
+
+const header = {
+	type: "session",
+	version: 3,
+	id: "synthetic-session",
+	timestamp: "2026-10-30T12:00:00Z",
+	cwd: "/work/synthetic",
+};
+const usage = {
+	input: 10,
+	output: 4,
+	cacheRead: 2,
+	cacheWrite: 3,
+	reasoning: 0,
+	totalTokens: 19,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+const source = `${[
+	header,
+	{
+		type: "message",
+		id: "u",
+		parentId: null,
+		timestamp: header.timestamp,
+		message: { role: "user", content: "Exact\r\n", timestamp: 1793361600000 },
+	},
+	{
+		type: "message",
+		id: "a",
+		parentId: "u",
+		timestamp: header.timestamp,
+		message: {
+			role: "assistant",
+			content: [
+				{ type: "thinking", thinking: "visible", thinkingSignature: "DO-NOT-COPY" },
+				{ type: "toolCall", id: "c", name: "read", arguments: { path: "fixture.txt" } },
+			],
+			api: "openai-completions",
+			provider: "fixture",
+			model: "requested",
+			responseModel: "served",
+			responseId: "response-7",
+			usage,
+			stopReason: "toolUse",
+			timestamp: 1793361600000,
+		},
+	},
+	{
+		type: "message",
+		id: "r",
+		parentId: "a",
+		timestamp: header.timestamp,
+		message: {
+			role: "toolResult",
+			toolCallId: "c",
+			toolName: "read",
+			content: [{ type: "text", text: "done\n" }],
+			isError: false,
+			timestamp: 1793361600000,
+		},
+	},
+	{
+		type: "message",
+		id: "branch",
+		parentId: "u",
+		timestamp: header.timestamp,
+		message: { role: "user", content: "Other branch", timestamp: 1793361600000 },
+	},
+]
+	.map((row) => JSON.stringify(row))
+	.join("\n")}\n`;
+
+test("extension command exports the saved session and refuses to overwrite files", async () => {
+	const directory = mkdtempSync(join(tmpdir(), "pi-asr-extension-"));
+	try {
+		const nativeFile = join(directory, "native.jsonl");
+		const destination = join(directory, "output.jsonl");
+		writeFileSync(nativeFile, source);
+		let command: Parameters<ExtensionAPI["registerCommand"]>[1] | undefined;
+		registerExport({ registerCommand: (_name, registered) => { command = registered; } } as ExtensionAPI);
+		assert.ok(command);
+		const context = {
+			cwd: directory,
+			sessionManager: { getSessionFile: () => nativeFile },
+			ui: { notify: () => {} },
+		} as unknown as ExtensionCommandContext;
+		await command.handler("output.jsonl", context);
+		assert.equal(readFileSync(destination, "utf8"), exportAgentSessionFile(source));
+		assert.equal(statSync(destination).mode & 0o777, 0o600);
+		await assert.rejects(() => command!.handler("output.jsonl", context), /EEXIST/);
+	} finally {
+		rmSync(directory, { recursive: true, force: true });
+	}
+});
+
+test("keeps branches, exact text, model identities and inclusive usage", () => {
+	const output = exportAgentSessionFile(source);
+	const rows = output
+		.trimEnd()
+		.split("\n")
+		.map((line) => JSON.parse(line));
+	assert.equal(rows[1].content[0].text, "Exact\r\n");
+	const inference = rows.find((row) => row.type === "inference");
+	assert.equal(inference.id, "response-7");
+	assert.equal(inference.model.id, "served");
+	assert.equal(inference.model.requested, "requested");
+	assert.equal(inference.usage.inputTokens, 15);
+	assert.equal(inference.usage.reasoningTokens, 0);
+	assert.equal(inference.cost.amount, 0);
+	assert.equal(rows.at(-1).content[0].text, "Other branch");
+	assert.equal(rows[1].author, undefined);
+	assert.ok(!output.includes("DO-NOT-COPY"));
+	assert.equal(output, exportAgentSessionFile(source));
+	assert.equal(new Set(rows.map((row) => row.id)).size, rows.length);
+});
+
+test("omits unsafe core counts and preserves their exact source spelling", () => {
+	const rows = exportAgentSessionFile(source.replace('"input":10', '"input":9007199254740993'))
+		.trimEnd()
+		.split("\n")
+		.map((line) => JSON.parse(line));
+	const inference = rows.find((row) => row.type === "inference");
+	assert.equal(inference.usage.inputTokens, undefined);
+	assert.equal(inference._meta["dev.pi.export"].exactCounts.input, "9007199254740993");
+});
+
+test("preserves integers beyond JS precision in tool input", () => {
+	const input = source.replace('"path":"fixture.txt"', '"n":9007199254740993');
+	const rows = exportAgentSessionFile(input)
+		.trimEnd()
+		.split("\n")
+		.map((line) => JSON.parse(line));
+	assert.equal(rows.find((row) => row.type === "tool_call").input.n, "9007199254740993");
+});
+
+test("rejects corrupt, incomplete, duplicate-header and unsupported sources", () => {
+	assert.throws(() => exportAgentSessionFile(source.slice(0, -1)), /Incomplete/);
+	assert.throws(() => exportAgentSessionFile(`${source}bad\n`));
+	assert.throws(() => exportAgentSessionFile(`${source + JSON.stringify(header)}\n`), /header/);
+	assert.throws(() => exportAgentSessionFile(source.replace('"version":3', '"version":99')), /version 3/);
+});
+
+test("does not turn a local failed assistant settlement into an inference", () => {
+	const failed = source
+		.replace('"stopReason":"toolUse"', '"stopReason":"error"')
+		.replace('"responseId":"response-7",', "");
+	const rows = exportAgentSessionFile(failed)
+		.trimEnd()
+		.split("\n")
+		.map((line) => JSON.parse(line));
+	assert.equal(rows.filter((row) => row.type === "inference").length, 0);
+	assert.ok(rows.filter((row) => row.type === "message").every((row) => row.inferenceId === undefined));
+});
+
+test("uses recorded provider evidence for summaries and omits empty thinking", () => {
+	for (const provider of ["anthropic", "openai", "fixture"]) {
+		const native = source
+			.trimEnd()
+			.split("\n")
+			.map((line) => JSON.parse(line));
+		const reply = native.find((entry) => entry.id === "a");
+		reply.message.provider = provider;
+		reply.message.content = [
+			{ type: "thinking", thinking: "Exact\r\n" },
+			{ type: "thinking", thinking: "" },
+		];
+		const records = exportAgentSessionFile(native.map((entry) => JSON.stringify(entry)).join("\n") + "\n")
+			.trimEnd()
+			.split("\n")
+			.map((line) => JSON.parse(line));
+		assert.deepEqual(
+			records.flatMap((record) => record.content ?? []).filter((part) => part.type === "reasoning"),
+			[
+				provider === "fixture"
