index 0000000000000000000000000000000000000000..1aa203f0254ab550a814c71c06ff4036b8f0c325
--- /dev/null
+++ b/src/utils/transcript-export/agent-session.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, it } from "vitest";
+import type { OpenHandsEvent } from "#/types/agent-server/core";
+import { eventsToAgentSession } from "./agent-session";
+
+const event = (fields: Record<string, unknown>) =>
+  fields as unknown as OpenHandsEvent;
+const parse = (events: OpenHandsEvent[]) =>
+  eventsToAgentSession(events, "synthetic-session")
+    .trimEnd()
+    .split("\n")
+    .map((line) => JSON.parse(line));
+
+describe("Agent Session Record export", () => {
+  it("preserves timezone-free native timestamps without inventing an offset", () => {
+    const records = parse([
+      event({
+        id: "naive",
+        kind: "MessageEvent",
+        timestamp: "2026-10-31T12:00:00.123456",
+        source: "user",
+        llm_message: { role: "user", content: [] },
+      }),
+    ]);
+    expect(records[1].ts).toBeUndefined();
+    expect(records[1]._meta["dev.openhands"].nativeTimestamp).toBe(
+      "2026-10-31T12:00:00.123456",
+    );
+    expect(records[0].missing).toContain("timestamps");
+  });
+
+  it("keeps source order and exact text without claiming human authorship", () => {
+    const records = parse([
+      event({
+        id: "header",
+        kind: "MessageEvent",
+        timestamp: "2026-10-31T12:00:02Z",
+        source: "user",
+        llm_message: {
+          role: "user",
+          content: [{ type: "text", text: " exact\n" }],
+        },
+      }),
+      event({
+        id: "reply",
+        kind: "MessageEvent",
+        timestamp: "2026-10-31T12:00:01Z",
+        source: "agent",
+        llm_message: {
+          role: "assistant",
+          content: [{ type: "text", text: "done" }],
+        },
+      }),
+    ]);
+    expect(records.slice(1).map((record) => record.id)).toEqual([
+      "header",
+      "reply",
+    ]);
+    expect(records[1].content[0].text).toBe(" exact\n");
+    expect(records[1].author).toBeUndefined();
+    expect(records[0].endedAt).toBeUndefined();
+  });
+
+  it("folds results at completion and records explicit rejection", () => {
+    const records = parse([
+      event({
+        id: "call",
+        kind: "ActionEvent",
+        source: "agent",
+        tool_name: "echo",
+        tool_call_id: "tool-1",
+        action: { kind: "MCPToolAction", text: "hello" },
+        thought: [],
+      }),
+      event({
+        id: "old",
+        kind: "ObservationEvent",
+        source: "environment",
+        action_id: "call",
+        tool_call_id: "tool-1",
+        observation: {
+          kind: "MCPToolObservation",
+          content: [{ type: "text", text: "partial" }],
+          is_error: false,
+        },
+      }),
+      event({
+        id: "notice",
+        kind: "MessageEvent",
+        llm_message: { role: "user", content: [] },
+      }),
+      event({
+        id: "final",
+        kind: "UserRejectObservation",
+        source: "environment",
+        action_id: "call",
+        tool_call_id: "tool-1",
+        rejection_reason: "Synthetic refusal",
+      }),
+    ]);
+    expect(records.map((record) => record.type)).toEqual([
+      "session",
+      "tool_call",
+      "message",
+      "approval",
+      "tool_result",
+    ]);
+    expect(records.at(-1).status).toBe("denied");
+    expect(records.at(-2).by).toBeUndefined();
+    expect(records.at(-1).id).toBe("final");
+  });
+
+  it("excludes credentials, media and opaque state with declared losses", () => {
+    const records = parse([
+      event({
+        id: "secret",
+        kind: "MessageEvent",
+        llm_message: {
+          role: "assistant",
+          content: [
+            { type: "text", text: "password=synthetic-secret" },
+            { type: "image", image_urls: ["https://example.invalid/private"] },
+          ],
+          thinking_blocks: [{ type: "redacted_thinking", data: "opaque" }],
+        },
+      }),
+    ]);
+    const stream = JSON.stringify(records);
+    expect(stream).not.toContain("synthetic-secret");
+    expect(stream).not.toContain("opaque");
+    expect(stream).not.toContain("example.invalid");
+    expect(records[1].truncated).toBe(true);
+    expect(records[0].missing).toContain("secrets");
+  });
+
+  it("rejects native integers whose exact bytes JavaScript has lost", () => {
+    expect(() =>
+      parse([
+        event({
+          id: "large",
+          kind: "ActionEvent",
+          tool_call_id: "tool",
+          tool_name: "echo",
+          source: "agent",
+          action: {
+            kind: "MCPToolAction",
+            number: Number.MAX_SAFE_INTEGER + 1,
+          },
+        }),
+      ]),
+    ).toThrow("exact JSON range");
+  });
+
+  it("keeps absent success unknown and produces deterministic IDs", () => {
+    const events = [
+      event({
+        id: "observation",
+        kind: "ObservationEvent",
+        source: "environment",
+        action_id: "call",
+        tool_call_id: "tool",
+        observation: {
+          kind: "MCPToolObservation",
+          content: [{ type: "text", text: "exit 0" }],
+        },
+      }),
+    ];
+    expect(parse(events).at(-1).status).toBe("unknown");
+    expect(eventsToAgentSession(events, "synthetic-session")).toBe(
+      eventsToAgentSession(events, "synthetic-session"),
+    );
+  });
+});
diff --git a/src/utils/transcript-export/agent-session.ts b/src/utils/transcript-export/agent-session.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3e3c8a25c698bf9af2d2ff6ce890d025eaaabf66
--- /dev/null
+++ b/src/utils/transcript-export/agent-session.ts
@@ -0,0 +1,261 @@
+import type { OpenHandsEvent } from "#/types/agent-server/core";
+import {
+  isActionEvent,
+  isMessageEvent,
+  isObservationEvent,
+  isUserRejectObservation,
+  isSystemPromptEvent,
+} from "#/types/agent-server/type-guards";
+
+import { REQUEST_SECRET_TOOL_NAME } from "#/constants/secret-request";
+
+type JsonRecord = Record<string, unknown>;
+const SECRET =
+  /bearer\s+\S+|sk-[\w-]{12,}|(?:api[_-]?key|password|token)["']?\s*[:=]\s*["']?[^\s,}]+/gi;
+
+function safe(value: unknown): unknown {
+  if (typeof value === "string") return value.replace(SECRET, "[REDACTED]");
+  if (
+    typeof value === "number" &&
+    !Number.isSafeInteger(value) &&
+    Number.isInteger(value)
+  ) {
+    // JavaScript has already lost the original bytes. Reject instead of rounding.
+    throw new Error("Native integer exceeds the exact JSON range");
+  }
+  if (Array.isArray(value)) return value.map(safe);
+  if (value && typeof value === "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [
+        key,
+        /secret|password|token|api.?key|authorization/i.test(key)
+          ? "[REDACTED]"
+          : safe(item),
+      ]),
+    );
+  }
+  return value;
+}
+
+function contentParts(content: unknown): {
+  parts: JsonRecord[];
+  lost: boolean;
+} {
+  const parts: JsonRecord[] = [];
+  let lost = false;
+  for (const part of Array.isArray(content) ? content : []) {
+    if (part?.type === "text" && typeof part.text === "string") {
+      parts.push({ type: "text", text: part.text });
+    } else {
+      lost = true;
+    }
+  }
+  return { parts, lost };
+}
+
+/** Export persisted events in their supplied source order, before UI folding. */
+export function eventsToAgentSession(
+  events: readonly OpenHandsEvent[],
+  sessionId: string,
+): string {
+  if (!sessionId) throw new Error("Missing native conversation identity");
+  const reserved = new Set(events.map((event) => event.id));
+  const used = new Set<string>();
+  const identity = (
+    position: number,
+    kind: string,
+    native?: string,
+  ): string => {
+    let id =
+      native &&
+      native.length <= 256 &&
+      ![...native].some(
+        (character) =>
+          character.charCodeAt(0) < 32 || character.charCodeAt(0) === 127,
+      )
+        ? native
+        : `asr:${position}:${kind}`;
+    while (used.has(id) || (id !== native && reserved.has(id)))
+      id = `asr:${id}`;
+    if (id.length > 256)
+      throw new Error("Repeated or oversized native event identity");
+    used.add(id);
+    return id;
+  };
+  const missing = new Set([
+    "usage",
+    "model",
+    "agent_settings",
+    "approvals",
+    "tools",
+    "file_changes",
+    "commits",
+    "copies",
+    "subagents",
+    "media",
+    "message_author",
+    "inference_settings",
+    "event_order",
+    "instructions",
+    "exit_codes",
+    "provider_state",
+    "reasoning",
+  ]);
+  const records: JsonRecord[] = [
+    {
+      type: "session",
+      id: identity(-1, "header"),
+      formatVersion: "0.1",
+      agent: { name: "openhands" },
+      sessionId,
+      producer: {
+        name: "openhands-agent-canvas",
+        version: "1.35.0",
+        method: "native",
+        source: "agent-server-events",
+      },
+    },
+  ];
+  // A result update occupies its final source position, with that event's time.
+  const secretCalls = new Set(
+    events
+      .filter(isActionEvent)
+      .filter((event) => event.tool_name === REQUEST_SECRET_TOOL_NAME)
+      .map((event) => event.tool_call_id),
+  );
+  const lastResult = new Map<string, number>();
+  events.forEach((event, index) => {
+    if (isObservationEvent(event) || isUserRejectObservation(event))
+      lastResult.set(event.tool_call_id, index);
+  });
+  events.forEach((event, index) => {
+    const envelope: JsonRecord = { id: identity(index, "event", event.id) };
+    const timestamp =
+      event.timestamp &&
+      /(?:Z|[+-]\d{2}:\d{2})$/i.test(event.timestamp) &&
+      Number.isFinite(Date.parse(event.timestamp))
+        ? event.timestamp
+        : undefined;
+    if (timestamp) envelope.ts = timestamp;
+    else {
+      missing.add("timestamps");
+      if (event.timestamp)
+        envelope._meta = {
+          "dev.openhands": { nativeTimestamp: event.timestamp },
+        };
+    }
+    if (isMessageEvent(event)) {
+      if (event.llm_message.role === "tool") {
+        missing.add("tool_output");
+        records.push({ ...envelope, type: "gap", reason: "not_recorded" });
+        return;
+      }
+      const { parts, lost } = contentParts(event.llm_message.content);
+      records.push({
+        ...envelope,
+        type: "message",
+        role: event.llm_message.role,
+        content: parts,
+        ...(lost ? { truncated: true } : {}),
+      });
+      if (lost) missing.add("content");
+    } else if (isSystemPromptEvent(event)) {
+      const { parts, lost } = contentParts([event.system_prompt]);
+      records.push({
+        ...envelope,
+        type: "message",
+        role: "system",
+        origin: "instructions",
+        author: "harness",
+        content: parts,
+        ...(lost ? { truncated: true } : {}),
+      });
+      if (lost) missing.add("content");
+    } else if (isActionEvent(event)) {
+      if (event.thought?.length)
+        records.push({
+          id: identity(index, "thought"),
+          ...(timestamp ? { ts: timestamp } : {}),
+          type: "message",
+          role: "assistant",
+          author: "model",
+          content: contentParts(event.thought).parts,
+        });
+      records.push({
+        ...envelope,
+        type: "tool_call",
+        callId: event.tool_call_id,
+        name: event.tool_name,
+        ...(event.action ? { input: event.action } : {}),
+        ...(event.source === "agent" ? { requestedBy: "model" } : {}),
+      });
+    } else if (isUserRejectObservation(event)) {
+      if (lastResult.get(event.tool_call_id) !== index) return;
+      // This is a positioned rejection observation, not proof of an answerer.
+      records.push({
+        id: identity(index, "approval"),
+        ...(timestamp ? { ts: timestamp } : {}),
+        type: "approval",
+        decision: "denied",
+        callId: event.tool_call_id,
+        native: { rejection_reason: event.rejection_reason },
+      });
+      records.push({
+        ...envelope,
+        type: "tool_result",
+        callId: event.tool_call_id,
+        status: "denied",
+        content: [{ type: "text", text: event.rejection_reason }],
+      });
+    } else if (isObservationEvent(event)) {
+      if (lastResult.get(event.tool_call_id) !== index) return;
+      const observation = event.observation;
+      const { parts, lost } = contentParts(
+        "content" in observation ? observation.content : [],
+      );
+      const status =
+        "is_error" in observation && typeof observation.is_error === "boolean"
+          ? observation.is_error
+            ? "failed"
+            : "completed"
+          : "unknown";
+      records.push({
+        ...envelope,
+        type: "tool_result",
+        callId: event.tool_call_id,
+        status,
+        content: parts,
+        ...(lost ? { truncated: true } : {}),
+      });
+      if (lost || !("content" in observation)) missing.add("tool_output");
+    } else {
+      // Keep the source position without copying settings, secrets or signatures.
+      records.push({
+        ...envelope,
+        type: "gap",
+        reason: "not_recorded",
+        detail: "Native event has no ASR mapping.",
+      });
+      missing.add("native_events");
+    }
+  });
+  for (const record of records) {
+    if (typeof record.callId === "string" && secretCalls.has(record.callId)) {
+      delete record.input;
+      delete record.content;
+      record.truncated = true;
+      missing.add("secrets");
+    }
+    for (const field of ["content", "input", "native"]) {
+      if (!(field in record)) continue;
+      const value = safe(record[field]);
+      if (JSON.stringify(value) !== JSON.stringify(record[field])) {
+        record[field] = value;
+        record.truncated = true;
+        missing.add("secrets");
+      }
+    }
+  }
+  records[0].missing = [...missing].sort();
+  return records.map((record) => JSON.stringify(record)).join("\n") + "\n";
+}
