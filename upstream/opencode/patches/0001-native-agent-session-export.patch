diff --git a/packages/cli/test/agent-session.test.ts b/packages/cli/test/agent-session.test.ts
new file mode 100644
index 0000000..8920263
--- /dev/null
+++ b/packages/cli/test/agent-session.test.ts
@@ -0,0 +1,90 @@
+import { expect, test } from "bun:test"
+import { Schema } from "effect"
+import { SessionEvent } from "@opencode/schema/session-event"
+import { records, write } from "../src/agent-session"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+
+const native = await Bun.file(path.join(import.meta.dir, "fixtures/agent-session/native.json")).json()
+const events = Schema.decodeUnknownSync(Schema.Array(Schema.toEncoded(SessionEvent.Durable)))(native) as Parameters<
+  typeof records
+>[1]
+
+test("keeps source completion order, exact text and inclusive call accounting", () => {
+  const result = records("ses_synthetic", events)
+  expect(result.map((record) => record.type)).toEqual([
+    "session",
+    "session_info",
+    "message",
+    "tool_call",
+    "message",
+    "tool_result",
+    "message",
+    "inference",
+    "session_info",
+  ])
+  expect(result.find((record) => record.type === "tool_result")?.content).toEqual([
+    { type: "text", text: "synthetic\n" },
+  ])
+  expect(result.find((record) => record.type === "inference")?.usage).toEqual({
+    inputTokens: 14,
+    outputTokens: 6,
+    reasoningTokens: 2,
+    cacheReadTokens: 3,
+    cacheWriteTokens: 1,
+  })
+  expect(result.find((record) => record.type === "inference")?.model).toEqual({
+    provider: "example",
+    requested: "requested-model",
+  })
+  expect(result[0]?.endedAt).toBeUndefined()
+  expect(records("ses_synthetic", events)).toEqual(result)
+})
+
+test("excludes known secrets with explicit truncation and loss", () => {
+  const result = records("ses_synthetic", events, ["synthetic"])
+  expect(JSON.stringify(result)).not.toContain('"text":"synthetic\\n"')
+  expect(result.find((record) => record.type === "tool_result")?.truncated).toBe(true)
+  expect(result[0]?.missing).toContain("secrets")
+})
+
+test("rejects missing creation history and unsafe native integers", () => {
+  expect(() => records("ses_missing", [])).toThrow("creation history")
+  const input = structuredClone(native) as Parameters<typeof records>[1]
+  const called = input.find((event) => event.type === "session.tool.called")!
+  if (called.type !== "session.tool.called") throw new Error("Fixture tool call is missing")
+  ;(called.data.input as { count?: number }).count = 2 ** 60
+  expect(() => records("ses_synthetic", input)).toThrow("Unsafe native integer")
+})
+
+test("directory export is private, validates before writing and never overwrites", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "asr-export-"))
+  try {
+    const target = path.join(root, "output")
+    async function* source() {
+      yield* events
+    }
+    await write({ sessionID: "ses_synthetic", events: source(), output: target })
+    const files = await fs.readdir(target)
+    expect(files.length).toBe(1)
+    expect(files[0]).toMatch(/^[a-f0-9]{64}\.jsonl$/)
+    expect((await fs.readFile(path.join(target, files[0]!), "utf8")).endsWith("\n")).toBe(true)
+    if (process.platform !== "win32") expect((await fs.stat(path.join(target, files[0]!))).mode & 0o777).toBe(0o600)
+    await expect(write({ sessionID: "ses_synthetic", events: source(), output: target })).rejects.toThrow()
+  } finally {
+    await fs.rm(root, { recursive: true, force: true })
+  }
+})
+
+test("omits unfinished inference links and preserves exact inclusive overflow", () => {
+  const partial = events.filter((event) => event.type !== "session.step.ended")
+  expect(records("ses_synthetic", partial).every((record) => record.inferenceId === undefined)).toBe(true)
+  const input = structuredClone(events)
+  const ended = input.find((event) => event.type === "session.step.ended")!
+  if (ended.type !== "session.step.ended") throw new Error("Fixture step is missing")
+  ended.data.tokens.input = Number.MAX_SAFE_INTEGER
+  const inference = records("ses_synthetic", input).find((record) => record.type === "inference")!
+  expect(inference.usage).toBeUndefined()
+  expect(inference._meta).toMatchObject({ "ai.opencode": { inputTokens: "9007199254740995" } })
+})
