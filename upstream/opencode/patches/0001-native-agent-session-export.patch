+export * as AgentSession from "./agent-session"
+
+import type { ExperimentalSessionApi } from "@opencode/client/promise/api"
+import { createHash } from "node:crypto"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { OPENCODE_VERSION } from "./version"
+
+type ExperimentalSessionLogOutput =
+  ReturnType<ExperimentalSessionApi["log"]> extends AsyncIterable<infer Item> ? Item : never
+type Event = Exclude<ExperimentalSessionLogOutput, { type: "log.synced" }>
+type Record = { type: string; id: string; [key: string]: unknown }
+
+const stamp = (ms: number) => new Date(ms).toISOString()
+const ref = (id: string) =>
+  `opencode:${id.replace(/[%:#\s\x00-\x1f\x7f]/gu, (c) => encodeURIComponent(c).replace(/%[a-f0-9]{2}/g, (x) => x.toUpperCase()))}`
+const digest = (id: string) => createHash("sha256").update(id).digest("hex")
+
+// Authentication state and provider replay metadata are never copied into exports.
+function clean(value: unknown, secrets: string[]): unknown {
+  if (typeof value === "string") {
+    const text = secrets.reduce((text, secret) => text.replaceAll(secret, "[redacted]"), value)
+    return text
+      .replace(/\b(?:sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\b/g, "[redacted]")
+      .replace(/\bBearer\s+[^\s"']+/gi, "Bearer [redacted]")
+      .replace(/-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----/g, "[redacted]")
+      .replace(/(https?:\/\/)[^\s/@]+:[^\s/@]+@/g, "$1[redacted]@")
+  }
+  if (Array.isArray(value)) return value.map((item) => clean(item, secrets))
+  if (value && typeof value === "object")
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [
+        key,
+        /^(?:password|authorization|(?:api|access|refresh|auth|secret)[_-]?(?:key|token))$/i.test(key)
+          ? "[redacted]"
+          : clean(item, secrets),
+      ]),
+    )
+  if (typeof value === "number" && Number.isInteger(value) && !Number.isSafeInteger(value)) {
+    throw new Error("Unsafe native integer cannot be exported without its original JSON bytes")
+  }
+  return value
+}
+
+export function records(sessionID: string, events: readonly Event[], secrets: string[] = []) {
+  const first = events.find((event) => event.type === "session.created")
+  if (!first || first.data.sessionID !== sessionID)
+    throw new Error(
+      "Session creation history is unavailable. Start the server with OPENCODE_AGENT_SESSION_HISTORY=1 before recording the session",
+    )
+  const missing = new Set([
+    "approvals",
+    "agent_settings",
+    "tools",
+    "file_changes",
+    "commits",
+    "subagents",
+    "copies",
+    "inference_settings",
+    "provider_state",
+    "media",
+    "cost_provenance",
+    "native_events",
+  ])
+  const output: Record[] = [
+    {
+      type: "session",
+      id: "header",
+      formatVersion: "0.1",
+      agent: { name: "opencode", version: first.data.version },
+      sessionId: sessionID,
+      producer: { name: "opencode", version: OPENCODE_VERSION, method: "native", source: "opencode-durable-events" },
+      startedAt: stamp(first.created),
+      cwd: first.data.location.directory,
+      ...(first.data.parentID ? { parent: { session: ref(first.data.parentID), kind: "subagent" } } : {}),
+      missing: [],
+    },
+  ]
+  const steps = new Map<string, Extract<Event, { type: "session.step.started" }>>()
+  const inbox = new Map<string, Extract<Event, { type: "session.inbox.enqueued" }>>()
+  const names = new Map<string, string>()
+  const results = new Set<string>()
+  const add = (event: Event, value: Omit<Record, "id">) => {
+    const record = { id: event.id, ts: stamp(event.created), ...value }
+    const safe = clean(record, secrets) as Record
+    if (JSON.stringify(safe) !== JSON.stringify(record)) {
+      safe.truncated = true
+      missing.add("secrets")
+    }
+    output.push(safe)
+  }
+  const settings = (event: Event, agent: string | undefined, approval?: unknown) => {
+    if (agent === undefined && approval === undefined) return
+    output.push({
+      type: "session_info",
+      id: `settings-${digest(event.id)}`,
+      ts: stamp(event.created),
+      agentSettings: {
+        ...(agent === undefined ? {} : { mode: agent }),
+        ...(approval === undefined ? {} : { approval }),
+      },
+    })
+  }
+  settings(first, first.data.agent, first.data.permissions)
+  for (const event of events) {
+    const data = event.data
+    switch (event.type) {
+      case "session.created":
+        break
+      case "session.agent.selected":
+        settings(event, event.data.agent)
+        break
+      case "session.permissions":
+        settings(event, undefined, event.data.permissions)
+        break
+      case "session.renamed":
+        add(event, { type: "session_info", title: event.data.title })
+        break
+      case "session.inbox.enqueued":
+        inbox.set(event.data.inboxID, event)
+        break
+      case "session.inbox.delivered": {
+        const item = inbox.get(event.data.inboxID)?.data.item
+        if (!item || (item.type !== "user" && item.type !== "synthetic")) break
+        if (item.type === "user" && item.payload.files?.length) missing.add("media")
+        add(event, {
+          type: "message",
+          role: "user",
+          ...(item.type === "synthetic" ? { author: "harness", origin: "injected" } : {}),
+          content: [{ type: "text", text: item.payload.text ?? "" }],
+        })
+        break
+      }
+      case "session.synthetic":
+      case "session.instructions.updated":
+      case "session.skill.activated": {
+        const text = "text" in data ? data.text : undefined
+        if (text !== undefined)
+          add(event, {
+            type: "message",
+            role: "system",
+            author: "harness",
+            origin: "instructions",
+            content: [{ type: "text", text }],
+          })
+        break
+      }
+      case "session.step.started":
+        steps.set(event.data.assistantMessageID, event)
+        break
+      case "session.text.ended":
+      case "session.reasoning.ended": {
+        const step = steps.get(event.data.assistantMessageID)
+        add(event, {
+          type: "message",
+          role: "assistant",
+          author: "model",
+          ...(step ? { inferenceId: step.id } : {}),
+          content: [
+            event.type === "session.text.ended"
+              ? { type: "text", text: event.data.text }
+              : asrReasoning(event.data.text, false),
+          ],
+        })
+        break
+      }
+      case "session.tool.input.started":
+        names.set(`${event.data.assistantMessageID}:${event.data.id}`, event.data.name)
+        break
+      case "session.tool.called": {
+        const key = `${event.data.assistantMessageID}:${event.data.id}`
+        const step = steps.get(event.data.assistantMessageID)
+        add(event, {
+          type: "tool_call",
+          callId: event.data.id,
+          name: names.get(key),
+          input: event.data.input,
+          requestedBy: "model",
+          ...(step ? { inferenceId: step.id } : {}),
+        })
+        break
+      }
+      case "session.tool.success":
+      case "session.tool.failed": {
+        const linked = !results.has(event.data.id)
+        results.add(event.data.id)
+        if (!linked) missing.add("ambiguous_calls")
+        if (event.data.metadata?.truncated === true) missing.add("tool_output")
+        const content = event.data.content?.flatMap((part) =>
+          part.type === "text" ? [{ type: "text", text: part.text }] : [],
+        )
+        add(event, {
+          type: "tool_result",
+          ...(linked ? { callId: event.data.id } : {}),
+          status: event.type === "session.tool.success" ? "completed" : "failed",
+          ...(content ? { content } : {}),
+          ...(event.data.metadata?.truncated === true ? { truncated: true } : {}),
+          ...(event.type === "session.tool.failed"
+            ? { error: { message: event.data.error.message, code: event.data.error.type } }
+            : {}),
+        })
+        break
+      }
+      case "session.step.ended":
+      case "session.step.failed": {
+        const step = steps.get(event.data.assistantMessageID)
+        if (!step) {
+          add(event, { type: "gap", reason: "not_retained", detail: "Model call start is unavailable" })
+          break
+        }
+        const tokens = event.data.tokens
+        const usage = tokens
+          ? {
+              inputTokens: tokens.input + tokens.cache.read + tokens.cache.write,
+              outputTokens: tokens.output + tokens.reasoning,
+              reasoningTokens: tokens.reasoning,
+              cacheReadTokens: tokens.cache.read,
+              cacheWriteTokens: tokens.cache.write,
+            }
+          : undefined
+        if (!usage) missing.add("usage")
+        const safe = usage && Object.values(usage).every((count) => Number.isSafeInteger(count) && count >= 0)
+        if (usage && !safe) missing.add("usage")
+        const record = {
+          type: "inference",
+          id: step.id,
+          ts: stamp(event.created),
+          model: { provider: step.data.model.providerID, requested: step.data.model.id },
+          ...(safe ? { usage } : {}),
+          ...(usage && !safe
+            ? {
+                _meta: {
+                  "ai.opencode": {
+                    tokens,
+                    inputTokens: String(
+                      BigInt(tokens!.input) + BigInt(tokens!.cache.read) + BigInt(tokens!.cache.write),
+                    ),
+                    outputTokens: String(BigInt(tokens!.output) + BigInt(tokens!.reasoning)),
+                  },
+                },
+              }
+            : {}),
+          ...(event.data.cost === undefined ? {} : { cost: { amount: event.data.cost, currency: "USD" } }),
+          ...(event.type === "session.step.ended"
+            ? { stopReason: event.data.rawFinish ?? event.data.finish }
+            : { error: { message: event.data.error.message } }),
+        }
+        output.push(record)
+        steps.delete(event.data.assistantMessageID)
+        break
+      }
+      case "session.compaction.ended":
+        add(event, {
+          type: "message",
+          role: "assistant",
+          author: "model",
+          origin: "compaction",
+          content: [{ type: "text", text: event.data.text }],
+        })
+        break
+      case "session.forked":
+        throw new Error("Forked history requires copied-record mapping and is not supported yet")
+      case "session.message.content.updated":
+      case "session.shell.started":
+      case "session.shell.ended":
+        missing.add("native_events")
+        add(event, {
+          type: "gap",
+          reason: "not_recorded",
+          detail: "Native shell history or content revision has no ASR mapping",
+        })
+        break
+    }
+  }
+  if (steps.size) {
+    missing.add("usage")
+    const unfinished = new Set([...steps.values()].map((event) => event.id))
+    for (const record of output) if (unfinished.has(record.inferenceId as string)) delete record.inferenceId
+  }
+  // Source IDs can be reused on imported history. Fail instead of exporting ambiguous records.
+  if (new Set(output.map((record) => record.id)).size !== output.length) throw new Error("Duplicate native record IDs")
+  const safe = output.map((record) => {
+    const value = clean(record, secrets) as Record
+    if (JSON.stringify(value) !== JSON.stringify(record)) {
+      value.truncated = true
+      missing.add("secrets")
+    }
+    return value
+  })
+  safe[0]!.missing = [...missing].sort()
+  return safe
+}
+
+export async function write(input: {
+  sessionID: string
+  events: AsyncIterable<ExperimentalSessionLogOutput>
+  output?: string
+  discovery?: boolean
+}) {
+  const events: Event[] = []
+  for await (const event of input.events) if (event.type !== "log.synced") events.push(event)
+  const secrets = Object.entries(process.env).flatMap(([key, value]) =>
+    /(?:TOKEN|SECRET|PASSWORD|API_KEY)/i.test(key) && value && value.length >= 8 ? [value] : [],
+  )
+  const text =
+    records(input.sessionID, events, secrets)
+      .map((record) => JSON.stringify(record))
+      .join("\n") + "\n"
+  if (input.output) {
+    await fs.mkdir(input.output, { mode: 0o700 })
+    await fs.writeFile(path.join(input.output, digest(input.sessionID) + ".jsonl"), text, { mode: 0o600, flag: "wx" })
+  }
+  if (input.discovery) {
+    const root =
+      process.platform === "win32"
+        ? (process.env.APPDATA ?? path.join(os.homedir(), "AppData", "Roaming"))
+        : (process.env.XDG_CONFIG_HOME ?? path.join(os.homedir(), ".config"))
+    const directory = path.join(root, "agent-sessions", "sources")
+    await fs.mkdir(directory, { recursive: true, mode: 0o700 })
+    await fs.writeFile(
+      path.join(directory, "opencode.json"),
+      JSON.stringify({
+        agent: "opencode",
+        exportCommand: ["opencode", "sessions", "export", "--format", "agent-session"],
+        formatVersions: ["0.1"],
+        supportsDeletionHook: false,
+      }) + "\n",
+      { mode: 0o600, flag: "wx" },
+    )
+  }
+  if (!input.output) process.stdout.write(text)
+}
+
+function asrReasoning(text: unknown, summary = false): { type: string; visibility?: string; text?: string; summary?: string[] } {
+  if (typeof text !== "string" || text.length === 0) return { type: "reasoning", visibility: "omitted" };
+  if (summary) return { type: "reasoning", visibility: "summary", summary: [text] };
+  return { type: "reasoning", text };
+}
