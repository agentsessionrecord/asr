@@ -0,0 +1,252 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+import { describe, it, expect, vi } from 'vitest';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { exportSession, exportCommand } from './export.js';
+import { exportFiles, parseNative } from './agent-session.js';
+
+const discovery = vi.hoisted(() => ({ directory: '' }));
+vi.mock('@google/gemini-cli-core', () => ({
+  Storage: class {
+    async initialize() {}
+    getProjectTempDir() {
+      return discovery.directory;
+    }
+  },
+}));
+
+const records = (text: string) =>
+  text
+    .trimEnd()
+    .split('\n')
+    .map((line) => JSON.parse(line));
+const at = '2026-10-30T12:00:00Z';
+
+const extra = (id: string) =>
+  JSON.stringify({
+    id,
+    timestamp: at,
+    type: 'user',
+    content: 'hello\r\n  world ',
+  });
+const fixture = () =>
+  JSON.stringify({
+    sessionId: 'synthetic-session',
+    projectHash: 'synthetic-project',
+    startTime: at,
+  }) +
+  '\n' +
+  extra('prompt') +
+  '\n';
+
+describe('Agent Session Record export', () => {
+  it('discovers current project storage and filters unrelated sessions before decoding', async () => {
+    const dir = fs.mkdtempSync(
+      path.join(os.tmpdir(), 'agent-session-discovery-'),
+    );
+    discovery.directory = dir;
+    const store = path.join(dir, 'chats');
+    fs.mkdirSync(store, { recursive: true });
+    fs.writeFileSync(path.join(store, 'session-synthetic.jsonl'), fixture());
+    fs.writeFileSync(path.join(store, 'session-synthetic.json'), fixture());
+    const write = vi.spyOn(process.stdout, 'write').mockReturnValue(true);
+    try {
+      await exportCommand.handler({
+        format: 'agent-session',
+        session: ['synthetic-session'],
+        _: [],
+        $0: 'test',
+      });
+      expect(write).toHaveBeenCalledWith(exportSession(fixture()));
+    } finally {
+      write.mockRestore();
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it('writes deterministic native streams with exact text and no invented outcomes', () => {
+    const source = fixture();
+    const a = exportSession(source);
+    expect(exportSession(source)).toBe(a);
+    const output = records(a);
+    expect(output[0].producer.method).toBe('native');
+    expect(output[0].sessionId).toBe('synthetic-session');
+    expect(output[0]).not.toHaveProperty('endedAt');
+    expect(output.some((r) => r.type === 'approval')).toBe(false);
+    expect(output.some((r) => r.type === 'inference')).toBe(false);
+    expect(output.find((r) => r.id === 'prompt').content).toEqual([
+      { type: 'text', text: 'hello\r\n  world ' },
+    ]);
+    expect(new Set(output.map((r) => r.id)).size).toBe(output.length);
+  });
+
+  it('keeps large native values exact before JavaScript can round them', () => {
+    expect(parseNative('{"id":9007199254740993}')).toEqual({
+      id: '9007199254740993',
+    });
+  });
+
+  it('marks corrupt complete lines and incomplete tails without dropping later work', () => {
+    const source =
+      fixture() + 'broken\n' + extra('later') + '\n' + '{"unfinished":';
+    const output = records(exportSession(source));
+    expect(output.filter((r) => r.type === 'gap')).toHaveLength(2);
+    expect(output.some((r) => r.id === 'later')).toBe(true);
+    expect(output[0].missing).toContain('history');
+  });
+
+  it('omits known secrets and opaque provider state', () => {
+    const source = fixture().replace(
+      'hello\\r\\n  world ',
+      'Bearer ' + 'a'.repeat(32),
+    );
+    const stream = exportSession(source);
+    expect(stream).not.toContain('a'.repeat(32));
+    expect(records(stream)[0].missing).toContain('secrets');
+    expect(records(stream).find((r) => r.id === 'prompt').truncated).toBe(true);
+  });
+
+  it('does not emit a session for missing identity', () => {
+    expect(() => exportSession('{}\n')).toThrow('identity');
+  });
+
+  it('rejects ambiguous stdout, unavailable sessions and invalid time filters', () => {
+    expect(() =>
+      exportFiles({ format: 'agent-session' }, [], exportSession),
+    ).toThrow('exactly one');
+    expect(() =>
+      exportFiles(
+        { format: 'agent-session', session: ['missing'] },
+        [],
+        exportSession,
+      ),
+    ).toThrow('unavailable');
+    expect(() =>
+      exportFiles(
+        { format: 'agent-session', session: ['missing'], since: 'yesterday' },
+        [],
+        exportSession,
+      ),
+    ).toThrow('RFC 3339');
+  });
+
+  it('writes safe private filenames and refuses to overwrite files', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agent-session-export-'));
+    try {
+      const input = path.join(dir, 'source.jsonl');
+      fs.writeFileSync(input, fixture());
+      const output = path.join(dir, 'exports');
+      const args = { format: 'agent-session', output };
+      exportFiles(args, [input], exportSession);
+      const [name] = fs.readdirSync(output);
+      expect(name).toMatch(/^[a-f0-9]{64}\.jsonl$/);
+      if (process.platform !== 'win32')
+        expect(fs.statSync(path.join(output, name)).mode & 0o777).toBe(0o600);
+      expect(() => exportFiles(args, [input], exportSession)).toThrow();
+      const write = vi.spyOn(process.stdout, 'write').mockReturnValue(true);
+      try {
+        exportFiles(
+          { format: 'agent-session', session: ['synthetic-session'] },
+          [input],
+          exportSession,
+        );
+        expect(write).toHaveBeenCalledWith(exportSession(fixture()));
+      } finally {
+        write.mockRestore();
+      }
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
+describe('Gemini journal revisions', () => {
+  it('folds result updates at completion after intervening messages and retains rewound work', () => {
+    const model = {
+      id: 'model',
+      type: 'gemini',
+      timestamp: at,
+      content: '',
+      toolCalls: [
+        {
+          id: 'call',
+          name: 'read_file',
+          args: { file_path: '/work/example.txt' },
+          status: 'executing',
+          timestamp: at,
+        },
+      ],
+    };
+    const final = {
+      ...model,
+      toolCalls: [
+        {
+          ...model.toolCalls[0],
+          status: 'success',
+          result: [
+            {
+              functionResponse: {
+                id: 'call',
+                name: 'read_file',
+                response: { output: 'done' },
+              },
+            },
+          ],
+        },
+      ],
+    };
+    const source =
+      fixture() +
+      [model, JSON.parse(extra('notice')), final, { $rewindTo: 'model' }]
+        .map((row) => JSON.stringify(row))
+        .join('\n') +
+      '\n';
+    const output = records(exportSession(source));
+    expect(output.filter((r) => r.type === 'tool_call')).toHaveLength(1);
+    expect(output.filter((r) => r.type === 'tool_result')).toHaveLength(1);
+    expect(output.find((r) => r.type === 'tool_result').status).toBe(
+      'completed',
+    );
+    expect(output.findIndex((r) => r.id === 'notice')).toBeLessThan(
+      output.findIndex((r) => r.type === 'tool_result'),
+    );
+  });
+
+  it('applies content patches at their native position without moving intervening records', () => {
+    const source =
+      fixture() +
+      [
+        JSON.parse(extra('changed')),
+        JSON.parse(extra('notice')),
+        { $patch: { updates: [{ id: 'changed', content: 'final' }] } },
+      ]
+        .map((row) => JSON.stringify(row))
+        .join('\n') +
+      '\n';
+    const output = records(exportSession(source));
+    expect(output.find((r) => r.id === 'changed').content[0].text).toBe(
+      'final',
+    );
+    expect(output.findIndex((r) => r.id === 'notice')).toBeLessThan(
+      output.findIndex((r) => r.id === 'changed'),
+    );
+    expect(output.find((r) => r.id === 'changed')).not.toHaveProperty('ts');
+  });
+
+  it('supports a legacy snapshot without borrowing export-time facts', () => {
+    const output = records(
+      exportSession(
+        JSON.stringify({
+          sessionId: 'legacy',
+          messages: [JSON.parse(extra('prompt'))],
+        }),
+      ),
+    );
+    expect(output[0].sessionId).toBe('legacy');
+    expect(output[0]).not.toHaveProperty('cwd');
+  });
+});
diff --git a/packages/cli/src/commands/sessions/export.ts b/packages/cli/src/commands/sessions/export.ts
