index 0000000..aa62e9e
--- /dev/null
+++ b/packages/cli/src/commands/sessions/export.ts
@@ -0,0 +1,351 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import type { CommandModule } from 'yargs';
+import type { MessageRecord, ToolCallRecord } from '@google/gemini-cli-core';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import {
+  SessionExport,
+  exportFiles,
+  nativeLines,
+  object,
+  list,
+  isString,
+  parseNative,
+  timestamp,
+  type ExportArgs,
+  type RecordValue,
+} from './agent-session.js';
+
+function isMessage(value: unknown): value is MessageRecord {
+  const r = object(value);
+  return (
+    isString(r['id']) &&
+    ['user', 'gemini', 'info', 'warning', 'error'].includes(String(r['type']))
+  );
+}
+function isTool(value: unknown): value is ToolCallRecord {
+  const r = object(value);
+  return isString(r['id']) && isString(r['name']);
+}
+
+type SavedTool = { value: ToolCallRecord; first: number; completed: number };
+type SavedMessage = {
+  value: MessageRecord;
+  first: number;
+  completed: number;
+  tools: Map<string, SavedTool>;
+};
+
+export function exportSession(text: string): string {
+  let observations: unknown[];
+  try {
+    const snapshot = object(parseNative(text));
+    observations = Array.isArray(snapshot['messages'])
+      ? [snapshot, ...list(snapshot['messages'])]
+      : nativeLines(text);
+  } catch {
+    observations = nativeLines(text);
+  }
+  const header = object(
+    observations.find((r) => isString(object(r)['sessionId'])),
+  );
+  if (!isString(header['sessionId']) || !header['sessionId'])
+    throw new Error('Missing native session identity');
+  const out = new SessionExport(
+    'com.google.gemini-cli',
+    new Set(
+      observations
+        .map((r) => object(r)['id'])
+        .filter((id): id is string => typeof id === 'string'),
+    ),
+  );
+  const messages = new Map<string, SavedMessage>();
+  const callPositions = new Map<string, number>();
+  const events: Array<{ at: number; order: number; write: () => void }> = [];
+  const queue = (at: number, order: number, write: () => void) =>
+    events.push({ at, order, write });
+  const save = (raw: unknown, at: number) => {
+    const value = object(raw);
+    if (!isMessage(raw)) {
+      queue(at, 0, () => out.gap(`invalid-${at}`));
+      return;
+    }
+    const id = raw.id;
+    for (const [index, part] of (Array.isArray(value['content'])
+      ? value['content']
+      : [value['content']]
+    ).entries()) {
+      const call = object(object(part)['functionCall']);
+      if (object(part)['functionCall']) {
+        const key = `${id}-${String(call['id'] ?? index)}`;
+        if (!callPositions.has(key)) callPositions.set(key, at);
+      }
+    }
+    const old = messages.get(id);
+    const contentChanged =
+      !old ||
+      JSON.stringify(old.value.content) !== JSON.stringify(value['content']);
+    const saved: SavedMessage = {
+      value: raw,
+      first: old?.first ?? at,
+      completed: contentChanged ? at : old.completed,
+      tools: old?.tools ?? new Map<string, SavedTool>(),
+    };
+    for (const tool of Array.isArray(value['toolCalls'])
+      ? value['toolCalls']
+      : []) {
+      const t = object(tool);
+      if (!isTool(tool) || !t['id']) {
+        queue(at, 0, () => out.gap(`invalid-tool-${at}`));
+        continue;
+      }
+      const previous = saved.tools.get(tool.id);
+      saved.tools.set(tool.id, {
+        value: tool,
+        first: previous?.first ?? at,
+        completed:
+          previous &&
+          JSON.stringify(previous.value.result) ===
+            JSON.stringify(t['result']) &&
+          previous.value.status === t['status']
+            ? previous.completed
+            : at,
+      });
+    }
+    messages.set(id, saved);
+  };
+  observations.forEach((raw, at) => {
+    const r = object(raw);
+    if (raw === null) queue(at, 0, () => out.gap(`line-${at}`));
+    else if (r['id'] !== undefined) save(r, at);
+    else if (r['$patch']) {
+      const patch = object(r['$patch']);
+      for (const update of Array.isArray(patch['updates'])
+        ? patch['updates']
+        : [patch]) {
+        const u = object(update);
+        const old = messages.get(String(u['id']));
+        if (!old) {
+          if (u['id'] !== undefined) queue(at, 0, () => out.gap(`patch-${at}`));
+          continue;
+        }
+        const merged: RecordValue = { ...old.value, ...u };
+        if (Array.isArray(u['toolCalls'])) {
+          merged['toolCalls'] = list(u['toolCalls']).map((tool: unknown) => ({
+            ...old.tools.get(String(object(tool)['id']))?.value,
+            ...object(tool),
+          }));
+        }
+        save(merged, at);
+      }
+    } else if (r['$set']) {
+      const set = object(r['$set']);
+      if (Array.isArray(set['messages']))
+        set['messages'].forEach((m) => save(m, at));
+    } else if (!r['sessionId'] && !r['$rewindTo']) {
+      queue(at, 0, () => out.gap(`unsupported-${at}`, 'not_recorded'));
+    }
+  });
+  const results = new Map<
+    string,
+    { at: number; ts?: string; content: unknown; status: string }
+  >();
+  const status = (native: string | undefined) =>
+    ({ success: 'completed', error: 'failed', cancelled: 'cancelled' })[
+      native ?? ''
+    ] ?? 'unknown';
+  for (const [id, saved] of messages) {
+    const m = saved.value;
+    const ts =
+      saved.first === saved.completed ? timestamp(m.timestamp) : undefined;
+    if (!ts) out.missing.add('timestamps');
+    if (saved.first !== saved.completed) out.missing.add('message_updates');
+    const parts = Array.isArray(m.content) ? m.content : [m.content];
+    const contentCalls = new Set(
+      parts.map((p) => object(object(p)['functionCall'])['id']),
+    );
+    let block: unknown[] = [];
+    let segment = 0;
+    const flush = (order: number) => {
+      if (!block.length) return;
+      const content = out.parts(block);
+      const native = segment++ === 0 ? id : undefined;
+      queue(saved.completed, order, () =>
+        out.add(
+          `${id}-text-${order}`,
+          {
+            type: 'message',
+            role: m.type === 'gemini' ? 'assistant' : 'user',
+            ...(m.type === 'gemini'
+              ? { author: 'model' }
+              : m.type !== 'user'
+                ? { author: 'harness', origin: 'notice' }
+                : {}),
+            content,
+            ts,
+          },
+          native,
+        ),
+      );
+      block = [];
+    };
+    parts.forEach((part, index) => {
+      const p = object(part);
+      if (p['functionCall']) {
+        flush(index * 2);
+        const call = object(p['functionCall']);
+        const tool = saved.tools.get(String(call['id']));
+        const nativeId = segment++ === 0 ? id : undefined;
+        queue(
+          callPositions.get(`${id}-${String(call['id'] ?? index)}`) ??
+            saved.completed,
+          index * 2 + 1,
+          () =>
+            out.call(
+              `${id}-call-${index}`,
+              {
+                ...call,
+                requestedBy: m.type === 'gemini' ? 'model' : undefined,
+                ...(tool ? { args: tool.value.args } : {}),
+              },
+              ts,
+              nativeId,
+            ),
+        );
+      } else if (p['functionResponse']) {
+        flush(index * 2);
+        const response = object(p['functionResponse']);
+        if (isString(response['id'])) {
+          const existing = results.get(response['id']);
+          if (!existing || existing.at <= saved.completed)
+            results.set(response['id'], {
+              at: saved.completed,
+              ts,
+              content: [part],
+              status: existing?.status ?? 'unknown',
+            });
+        } else
+          queue(saved.completed, index * 2, () =>
+            out.add(`${id}-unpaired-${index}`, {
+              type: 'tool_result',
+              status: 'unknown',
+              content: out.parts([part]),
+              ts,
+            }),
+          );
+      } else block.push(part);
+    });
+    flush(parts.length * 2);
+    for (const [callId, tool] of saved.tools) {
+      const t = tool.value;
+      if (!contentCalls.has(callId))
+        queue(tool.first, 100, () =>
+          out.call(
+            `${id}-call-${callId}`,
+            {
+              id: callId,
+              name: t.name,
+              args: t.args,
+              requestedBy: m.type === 'gemini' ? 'model' : undefined,
+            },
+            timestamp(t.timestamp),
+          ),
+        );
+      if (t.result !== undefined && t.result !== null) {
+        const parts = Array.isArray(t.result) ? t.result : [t.result];
+        const responses = parts.filter((p) => object(p)['functionResponse']);
+        const matching = responses.length
+          ? responses.filter(
+              (p) => object(object(p)['functionResponse'])['id'] === callId,
+            )
+          : parts;
+        const existing = results.get(callId);
+        if (matching.length && (!existing || existing.at <= tool.completed))
+          results.set(callId, {
+            at: tool.completed,
+            ts: undefined,
+            content: matching,
+            status: status(t.status),
+          });
+        else if (existing) existing.status = status(t.status);
+      }
+    }
+  }
+  for (const [callId, result] of results) {
+    if (!result.ts) out.missing.add('timestamps');
+    queue(result.at, 1000, () =>
+      out.add(`result-${callId}`, {
+        type: 'tool_result',
+        callId,
+        status: result.status,
+        content: out.parts(result.content),
+        ts: result.ts,
+      }),
+    );
+  }
+  events
+    .sort((a, b) => a.at - b.at || a.order - b.order)
+    .forEach((e) => e.write());
+  return out.finish({
+    agent: { name: 'gemini-cli' },
+    sessionId: header['sessionId'],
+    startedAt: timestamp(header['startTime']),
+    producer: {
+      name: 'gemini-cli-export',
+      version: '1',
+      method: 'native',
+      source: 'gemini-chat-recording',
+    },
+  });
+}
+
+export const exportCommand: CommandModule<unknown, ExportArgs> = {
+  command: 'export',
+  describe: 'Export saved sessions as Agent Session Record JSONL',
+  builder: (yargs) =>
+    yargs
+      .option('format', {
+        type: 'string',
+        choices: ['agent-session'],
+        demandOption: true,
+      })
+      .option('session', { type: 'string', array: true })
+      .option('input', {
+        type: 'string',
+        array: true,
+        describe:
+          'Read explicit native session files instead of current project storage',
+      })
+      .option('since', { type: 'string' })
+      .option('output', {
+        type: 'string',
+        describe:
+          'Write private files to a directory without replacing existing files',
+      }),
+  handler: async (args) => {
+    let files = args.input;
+    if (!files) {
+      const { Storage } = await import('@google/gemini-cli-core');
+      const storage = new Storage(process.cwd());
+      await storage.initialize();
+      const dir = path.join(storage.getProjectTempDir(), 'chats');
+      files = fs
+        .readdirSync(dir)
+        .filter(
+          (name) =>
+            /^session-.*\.jsonl?$/.test(name) &&
+            !(
+              name.endsWith('.json') &&
+              fs.existsSync(path.join(dir, name + 'l'))
+            ),
+        )
+        .map((name) => path.join(dir, name));
+    }
+    exportFiles(args, files, exportSession);
+  },
+};
