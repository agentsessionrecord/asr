{
  "name": "@agent-session/validate",
  "version": "0.1.3",
  "description": "Offline validator for Agent Session Record streams and annotations.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "asr-validate": "bin/asr-validate.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schemas": "./src/schema/build.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-schemas.mjs && node scripts/build-requirements.mjs",
    "check:generated": "node scripts/build-schemas.mjs --check && node scripts/build-requirements.mjs --check",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "examples": "node scripts/validate-examples.mjs",
    "conformance": "node bin/asr-validate.js conformance ../../conformance/fixtures",
    "doc-examples": "node scripts/check-doc-examples.mjs",
    "ci": "pnpm run check:generated && pnpm test && pnpm run examples && pnpm run conformance && pnpm run doc-examples && pnpm run samples",
    "samples": "node scripts/check-samples.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
