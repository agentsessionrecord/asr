{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsessionrecord.org/schema/v0/manifest.schema.json",
  "title": "ASR collection manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://agentsessionrecord.org/schema/v0/manifest.schema.json"
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "machine": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt]"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt]"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "previousManifest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "pattern": "^(?:amp|antigravity|astrbot|auggie|claude-code|cline|codebuddy|codex|continue|copilot-cli|crush|cursor|deepagents|deepseek-harness|devin|droid|firebender|forgecode|fx|gemini-cli|goose|grok-build|hermes|junie|kilo|kimi-code|kiro|lingma|mimocode|mistral-vibe|mux|nanoclaw|openclaw|opencode|openhands|pi|qoder|qwen-code|roo-code|rovodev|shelley|t3-code|tabnine|warp|xum|zed|[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+):(?:(?:%[0-7][0-9A-F]|%(?:C[2-9A-F]|D[0-9A-F])(?:%[89AB][0-9A-F])|%E0%[AB][0-9A-F](?:%[89AB][0-9A-F])|%E[1-CEF](?:%[89AB][0-9A-F]){2}|%ED%[89][0-9A-F](?:%[89AB][0-9A-F])|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3](?:%[89AB][0-9A-F]){3}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})|[^%:#\\x00-\\x20\\x7F-\\x9F])+(?::(?:(?:%[0-7][0-9A-F]|%(?:C[2-9A-F]|D[0-9A-F])(?:%[89AB][0-9A-F])|%E0%[AB][0-9A-F](?:%[89AB][0-9A-F])|%E[1-CEF](?:%[89AB][0-9A-F]){2}|%ED%[89][0-9A-F](?:%[89AB][0-9A-F])|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3](?:%[89AB][0-9A-F]){3}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})|[^%:#\\x00-\\x20\\x7F-\\x9F])+)?(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt]"
          },
          "uploader": {
            "type": "string",
            "minLength": 1
          },
          "producer": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              }
            },
            "required": [
              "method"
            ]
          },
          "replaces": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "sha256"
            ]
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "receivedAt",
          "uploader",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "received"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "session",
                "sha256",
                "byteLength",
                "producer"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unreadable"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "sha256",
                "byteLength"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "not": {
                    "const": "received"
                  }
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "collector",
    "machine",
    "window",
    "previousManifest",
    "entries"
  ]
}
